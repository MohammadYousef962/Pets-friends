@section Scripts {
    <script>
        // Filter logic
        function filterQueue(type) {
            event.preventDefault();
            const cards = document.querySelectorAll('.filterable-card');
            let visibleCount = 0;

            cards.forEach(card => {
                if (type === 'all' || card.getAttribute('data-type') === type) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            document.getElementById('empty-state').style.display = visibleCount === 0 ? 'block' : 'none';
        }

        // Logic to populate and open the Review Application Modal
        function openReviewModal(id, applicantName, petName, petInfo, petImage) {
            document.getElementById('modalDeclineId').value = id;
            document.getElementById('modalApproveId').value = id;
            document.getElementById('modalApplicantName').innerText = applicantName;
            document.getElementById('modalPetName').innerText = petName;
            document.getElementById('modalPetInfo').innerText = petInfo;
            document.getElementById('modalPetImage').src = petImage;
            var reviewModal = new bootstrap.Modal(document.getElementById('reviewAdoptionModal'));
            reviewModal.show();
        }

        // Logic to populate and open the Edit Boarding Modal
        function openEditModal(id, name, breed, owner, date, status, notes) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-petName').value = name;
            document.getElementById('edit-petBreed').value = breed;
            document.getElementById('edit-ownerName').value = owner;
            document.getElementById('edit-scheduledDate').value = date;
            document.getElementById('edit-status').value = status;
            document.getElementById('edit-specialNotes').value = notes === 'Standard' ? '' : notes;
            var editModal = new bootstrap.Modal(document.getElementById('editBoardingModal'));
            editModal.show();
        }
    </script>
}