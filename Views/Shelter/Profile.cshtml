@section Scripts {
    <script>
        // --- PET DETAILS & ADOPTION MODAL TRIGGERS ---
        let currentAppPetName = '';
        let currentAppPetId = '';

        function openDetailsModal(name, breed, age, gender, isNeutered, history, desc, imgUrl, id) {
            currentAppPetName = name;
            currentAppPetId = id;
            document.getElementById('modalPetNameDisplay').innerText = name;
            document.getElementById('modalImg').src = imgUrl;
            document.getElementById('modalDesc').innerText = desc || "A wonderful companion waiting for a home.";
            document.getElementById('modalBreed').innerText = breed;
            document.getElementById('modalAge').innerText = age + ' yrs';
            document.getElementById('modalGender').innerText = gender;
            document.getElementById('modalNeutered').innerText = (isNeutered === 'true' || isNeutered === true) ? "Yes" : "No";
            document.getElementById('modalHistory').innerText = history || "No known medical issues.";
            new bootstrap.Modal(document.getElementById('petDetailsModal')).show();
        }

        function triggerApplicationFromDetails() {
            var detailsModal = bootstrap.Modal.getInstance(document.getElementById('petDetailsModal'));
            if(detailsModal) { detailsModal.hide(); }
            openApplicationModal(currentAppPetName, currentAppPetId);
        }

        function openApplicationModal(name, id) {
            document.getElementById('adoptModalPetName').innerText = name;
            document.getElementById('adoptPetIdField').value = id;
            new bootstrap.Modal(document.getElementById('adoptionApplicationModal')).show();
        }

        // --- SCHEDULE DECLARATION FROM SERVER ---
        const shelterSchedule = {
            @if (Model.Schedule != null)
            {
                        foreach (var day in Model.Schedule)
                        {
                                    <text>
                                    "@day.Day.ToString()": {
                                        isOff: @(day.IsOff.ToString().ToLower()),
                                        open: "@(day.OpenTime?.ToString(@"hh\:mm") ?? "00:00")",
                                        close: "@(day.CloseTime?.ToString(@"hh\:mm") ?? "23:59")"
                                    },
                                    </text>
                        }
            }
        };

        const daysMap = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        const minTimeStr = now.toISOString().slice(0, 16);
        document.querySelectorAll('input[type="datetime-local"]').forEach(i => i.min = minTimeStr);

        // --- VALIDATOR 1: BABYSITTING ---
        const babysitCheckboxes = document.querySelectorAll('.babysit-pet-checkbox');
        const babysitTimeInputs = document.querySelectorAll('.babysit-time-validator');
        const submitBabysitBtn = document.getElementById('submitBabysitBtn');
        const babysitTimeError = document.getElementById('babysitTimeError');
        const babysitPetError = document.getElementById('babysitSelectionError');

        function validateBabysitting() {
            if (!submitBabysitBtn) return;
            let isValid = true;
            babysitTimeError.style.display = 'none';
            babysitPetError.style.display = 'none';

            const checkedBoxes = document.querySelectorAll('.babysit-pet-checkbox:checked');
            if (checkedBoxes.length === 0) {
                isValid = false;
                babysitPetError.style.display = 'block';
            }

            const dropVal = document.getElementById('dropoffTime').value;
            const pickVal = document.getElementById('pickupTime').value;

            if (dropVal && pickVal && dropVal >= pickVal) {
                showBabysitError("Pick-up time must be strictly after the Drop-off time.");
                isValid = false;
            }

            if (dropVal) {
                if (!checkSchedule(new Date(dropVal), "Drop-off", showBabysitError)) {
                    isValid = false; document.getElementById('dropoffTime').value = '';
                }
            } else { isValid = false; }

            if (pickVal && dropVal < pickVal) {
                if (!checkSchedule(new Date(pickVal), "Pick-up", showBabysitError)) {
                    isValid = false; document.getElementById('pickupTime').value = '';
                }
            } else if (!pickVal) { isValid = false; }

            submitBabysitBtn.disabled = !isValid;

            if (checkedBoxes.length > 0) {
                document.getElementById('hiddenBoardingPetName').value = checkedBoxes[0].getAttribute('data-name');
                document.getElementById('hiddenBoardingPetBreed').value = checkedBoxes[0].getAttribute('data-breed');
            }
        }

        function showBabysitError(msg) {
            babysitTimeError.innerHTML = `<i class="bi bi-exclamation-circle-fill me-1"></i> ${msg}`;
            babysitTimeError.style.display = 'block';
        }

        document.getElementById('babysitForm')?.addEventListener('submit', function() {
            const pickup = document.getElementById('pickupTime').value;
            const notesElem = this.querySelector('textarea[name="SpecialNotes"]');

            const sIdInput = document.createElement("input");
            sIdInput.type = "hidden"; sIdInput.name = "shelterId"; sIdInput.value = "@Model.Id";
            this.appendChild(sIdInput);

            if (pickup) {
                const fPick = new Date(pickup).toLocaleString();
                notesElem.value = `[Scheduled Pick-up: ${fPick}]\n\n` + notesElem.value;
            }
        });


        // --- VALIDATOR 2: INTAKE SURRENDER ---
        const intakeRadios = document.querySelectorAll('.intake-radio');
        const intakeDropoff = document.getElementById('intakeDropoff');
        const submitIntakeBtn = document.getElementById('submitIntakeBtn');
        const intakeTimeError = document.getElementById('intakeTimeError');
        const intakePetError = document.getElementById('intakePetError');

        function validateIntake() {
            if (!submitIntakeBtn) return;
            let isValid = true;
            intakeTimeError.style.display = 'none';
            intakePetError.style.display = 'none';

            const activeRadio = document.querySelector('.intake-radio:checked');
            if (!activeRadio) {
                isValid = false;
                intakePetError.style.display = 'block';
            }

            const dropVal = intakeDropoff.value;
            if (dropVal) {
                if (!checkSchedule(new Date(dropVal), "Intake", showIntakeError)) {
                    isValid = false; intakeDropoff.value = '';
                }
            } else { isValid = false; }

            submitIntakeBtn.disabled = !isValid;
        }

        function showIntakeError(msg) {
            intakeTimeError.innerHTML = `<i class="bi bi-exclamation-circle-fill me-1"></i> ${msg}`;
            intakeTimeError.style.display = 'block';
        }

        // --- SHARED BULLETPROOF SCHEDULE LOGIC ---
        function checkSchedule(dateObj, label, errorCallback) {
            const dName = daysMap[dateObj.getDay()];
            const config = shelterSchedule[dName];

            if (config) {
                if (config.isOff) {
                    errorCallback(`${label}: The shelter is closed on ${dName}s.`);
                    return false;
                }

                const hh = String(dateObj.getHours()).padStart(2, '0');
                const mm = String(dateObj.getMinutes()).padStart(2, '0');
                const HHmm = `${hh}:${mm}`;

                if (HHmm < config.open || HHmm > config.close) {
                    errorCallback(`${label}: Time must strictly be between ${format12(config.open)} and ${format12(config.close)}.`);
                    return false;
                }
            }
            return true;
        }

        function format12(t24) {
            let [h, m] = t24.split(':');
            let p = h >= 12 ? 'PM' : 'AM';
            h = h % 12 || 12;
            return `${h}:${m} ${p}`;
        }

        babysitCheckboxes.forEach(cb => cb.addEventListener('change', validateBabysitting));
        babysitTimeInputs.forEach(ti => ti.addEventListener('change', validateBabysitting));

        intakeRadios.forEach(r => r.addEventListener('change', validateIntake));
        if (intakeDropoff) intakeDropoff.addEventListener('change', validateIntake);
    </script>
}
