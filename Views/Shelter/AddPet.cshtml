@model Pets_friends.Data.ViewModels.PetFormVM

@{
    ViewData["Title"] = "Register New Patient";
    Layout = "~/Views/Shared/_VetLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-primary: #5C3D1E;
            --brand-accent: #C8A882;
            --vet-color: #059669; /* Clinic Green */
            --text-dark: #1A1A1A;
            --text-muted: #6B7280;
        }

        body {
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%) !important;
            background-attachment: fixed !important;
            font-family: 'DM Sans', sans-serif;
            color: var(--text-dark);
            padding-bottom: 60px;
        }

        /* GPU LAG FIXED: Removed backdrop-filter blur and replaced with solid premium white */
        .glass-card {
            background: #FFFFFF;
            border-radius: 32px;
            padding: 45px;
            box-shadow: 0 20px 50px rgba(92, 61, 30, 0.05);
            border: 1px solid #EBE0D5;
            max-width: 850px;
            margin: 60px auto;
        }

        .section-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 2rem;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-dark);
        }

        /* --- PET PHOTO UPLOAD UI --- */
        .pet-preview-circle {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 6px solid #fff;
            box-shadow: 0 10px 25px rgba(92, 61, 30, 0.1);
            margin: 0 auto 15px;
            overflow: hidden;
            background: #EBE0D5;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .pet-preview-circle img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .upload-trigger {
            background: #fff;
            border: 2px dashed var(--brand-accent);
            border-radius: 16px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: block;
            width: 100%;
            max-width: 250px;
            margin: 0 auto 35px;
            text-align: center;
            will-change: transform;
        }

            .upload-trigger:hover {
                border-color: var(--brand-primary);
                background: #FAF6F1;
                transform: translateY(-2px);
            }

        /* --- STANDARD FORM INPUTS --- */
        .form-label {
            font-weight: 800;
            color: var(--text-muted);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            display: block;
        }

        .form-control-custom {
            width: 100%;
            padding: 14px 20px;
            border-radius: 16px;
            border: 2px solid #EBE0D5;
            background: #fff;
            font-weight: 600;
            margin-bottom: 20px;
            transition: 0.2s ease;
            color: var(--text-dark);
        }

            .form-control-custom:focus {
                border-color: var(--brand-accent);
                outline: none;
                box-shadow: 0 0 0 4px rgba(200,168,130,0.15);
            }

        input[type="date"].form-control-custom {
            font-family: 'DM Sans', sans-serif;
            text-transform: uppercase;
        }

        /* --- THE UPGRADED SEARCH BAR --- */
        .highlight-box {
            background: #FAFAFA;
            border: 2px solid #EBE0D5;
            padding: 25px;
            border-radius: 24px;
            margin-bottom: 25px;
            transition: all 0.2s ease;
        }

            .highlight-box:focus-within {
                background: #fff;
                border-color: var(--vet-color);
                box-shadow: 0 10px 30px rgba(5, 150, 105, 0.08);
            }

        .search-wrapper {
            position: relative;
            width: 100%;
        }

        .search-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--vet-color);
            font-size: 1.3rem;
            z-index: 10;
        }

        .search-input {
            width: 100%;
            padding: 18px 20px 18px 55px;
            border-radius: 16px;
            border: 2px solid #EBE0D5;
            background: #fff;
            font-weight: 600;
            font-size: 1.05rem;
            color: var(--text-dark);
            transition: all 0.2s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.02);
        }

            .search-input:focus {
                border-color: var(--vet-color);
                box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.15);
                outline: none;
            }

            .search-input::placeholder {
                color: #9CA3AF;
                font-weight: 500;
            }

        /* --- THE UPGRADED AUTOCOMPLETE --- */
        .autocomplete-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #EBE0D5;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(92, 61, 30, 0.1);
            z-index: 1000;
            max-height: 280px;
            overflow-y: auto;
            display: none;
            padding: 8px;
            will-change: opacity, transform; /* Hardware acceleration for popup */
        }

        .autocomplete-item {
            padding: 12px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 15px;
            border-radius: 12px;
            transition: background 0.15s ease;
            margin-bottom: 4px;
        }

            .autocomplete-item:last-child {
                margin-bottom: 0;
            }

            .autocomplete-item:hover {
                background: #F0FDF4;
            }

        .ac-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #ECFDF5;
            color: var(--vet-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .ac-details {
            flex-grow: 1;
        }

        .ac-name {
            font-weight: 800;
            color: var(--text-dark);
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .ac-meta {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .ac-id {
            font-size: 0.7rem;
            background: #F3F4F6;
            padding: 2px 8px;
            border-radius: 6px;
            color: #4B5563;
            font-family: monospace;
        }

        /* --- BUTTONS & CHECKBOXES --- */
        .btn-submit {
            color: #fff;
            font-weight: 800;
            border-radius: 50px;
            padding: 18px;
            border: none;
            width: 100%;
            font-size: 1.15rem;
            transition: all 0.2s ease;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            background: var(--vet-color);
            box-shadow: 0 8px 20px rgba(5, 150, 105, 0.25);
            margin-top: 20px;
            will-change: transform;
        }

            .btn-submit:hover {
                background: #047857;
                transform: translateY(-3px);
                box-shadow: 0 12px 25px rgba(5, 150, 105, 0.35);
            }

        .custom-checkbox {
            width: 20px;
            height: 20px;
            margin-top: 0.15rem;
            border: 2px solid #EBE0D5;
            cursor: pointer;
            border-radius: 6px;
        }

            .custom-checkbox:checked {
                background-color: var(--brand-accent);
                border-color: var(--brand-accent);
            }
    </style>
}

<div class="glass-card">
    <h1 class="section-title"><i class="bi bi-shield-check" style="color: var(--vet-color);"></i> Register New Patient</h1>
    <p class="text-muted mb-4 fw-medium" style="font-size: 1.1rem;">Officially add a pet to a client's verified medical record.</p>

    <form asp-action="AddPatient" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="SelectedClientProfileId" id="hiddenClientId" />

        <div class="pet-preview-circle">
            <img id="imgPreview" src="https://placehold.co/200x200/EBE0D5/5C3D1E?text=Photo&font=DM+Sans" alt="Preview">
        </div>
        <div class="upload-trigger" onclick="document.getElementById('fileInput').click()">
            <div class="fw-bold" style="color: var(--brand-primary); font-size: 0.95rem;"><i class="bi bi-camera me-1"></i> Upload Official Photo</div>
            <input asp-for="ImageFile" type="file" id="fileInput" hidden accept="image/*" onchange="handleFilePreview(this)" />
        </div>

        <div class="row g-3">

            <div class="col-12 highlight-box">
                <label class="form-label" style="color: var(--vet-color);"><i class="bi bi-person-badge-fill me-1"></i> Assign to Client (Owner)</label>
                <div class="search-wrapper">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" id="clientSearchInput" class="search-input" placeholder="Search by name, email, phone, or Account ID..." autocomplete="off">

                    <div id="autocompleteDropdown" class="autocomplete-dropdown">
                    </div>
                </div>
                <span asp-validation-for="SelectedClientProfileId" class="text-danger fw-bold mt-1 d-block" style="font-size: 0.8rem;"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Official Pet Name</label>
                <input asp-for="Name" class="form-control-custom" placeholder="e.g. Bella" required>
            </div>

            <div class="col-md-6">
                <label asp-for="Breed" class="form-label">Breed / Species</label>
                <input asp-for="Breed" class="form-control-custom" placeholder="e.g. Golden Retriever" required>
            </div>

            <div class="col-md-6">
                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                <input asp-for="DateOfBirth" type="date" class="form-control-custom" required>
            </div>

            <div class="col-md-6">
                <label asp-for="Gender" class="form-label">Gender</label>
                <select asp-for="Gender" class="form-control-custom" id="genderSelect" onchange="updateSpayNeuterLabel()" required style="margin-bottom: 12px; padding: 14px 20px;">
                    <option value="" disabled selected>Select Gender...</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>

                <div class="form-check align-items-center gap-2" id="spayNeuterContainer" style="display: none !important; padding-left: 0.5em;">
                    <input asp-for="IsNeutered" class="form-check-input custom-checkbox shadow-none m-0" type="checkbox" id="spayNeuterCheck">
                    <label class="form-check-label fw-bold" for="spayNeuterCheck" id="spayNeuterLabel" style="color: var(--text-dark); font-size: 0.9rem; cursor: pointer;">
                        Neutered
                    </label>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="MedicalHistory" class="form-label"><i class="bi bi-journal-medical me-1" style="color: var(--vet-color);"></i> Initial Medical History</label>
                <textarea asp-for="MedicalHistory" class="form-control-custom" rows="3" placeholder="Enter baseline medical conditions, vaccines, or allergies here..."></textarea>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">Pet Biography / Traits</label>
                <textarea asp-for="Description" class="form-control-custom" rows="3" placeholder="Describe the pet's personality... (Optional)"></textarea>
            </div>
        </div>

        <button type="submit" class="btn-submit">
            <i class="bi bi-file-earmark-medical-fill"></i> Register Official Patient
        </button>
    </form>
</div>

@section Scripts {
    <script>
        // Preview Image Logic
        function handleFilePreview(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => document.getElementById('imgPreview').src = e.target.result;
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Gender specific Spay/Neuter text
        function updateSpayNeuterLabel() {
            const gender = document.getElementById('genderSelect').value;
            const container = document.getElementById('spayNeuterContainer');
            const label = document.getElementById('spayNeuterLabel');

            if (gender === 'Male') {
                container.style.setProperty('display', 'flex', 'important');
                label.innerText = 'Neutered (Castrated)';
            } else if (gender === 'Female') {
                container.style.setProperty('display', 'flex', 'important');
                label.innerText = 'Spayed';
            } else {
                container.style.setProperty('display', 'none', 'important');
            }
        }

        // Live AJAX Autocomplete Search connecting to the C# Backend
        const searchInput = document.getElementById('clientSearchInput');
        const dropdown = document.getElementById('autocompleteDropdown');
        const hiddenClientId = document.getElementById('hiddenClientId');

        let timeoutId;

        searchInput.addEventListener('input', function() {
            clearTimeout(timeoutId);
            const val = this.value.trim();
            dropdown.innerHTML = '';

            if (!val) {
                dropdown.style.display = 'none';
                hiddenClientId.value = '';
                return;
            }

            timeoutId = setTimeout(() => {
                fetch(`/Vet/SearchClients?q=${encodeURIComponent(val)}`)
                    .then(response => response.json())
                    .then(data => {
                        dropdown.innerHTML = '';
                        if (data.length > 0) {
                            dropdown.style.display = 'block';
                            data.forEach(client => {
                                const item = document.createElement('div');
                                item.className = 'autocomplete-item';
                                item.innerHTML = `
                                    <div class="ac-avatar"><i class="bi bi-person-check-fill"></i></div>
                                    <div class="ac-details">
                                        <div class="ac-name">
                                            ${client.name}
                                            <span class="ac-id">${client.accountId}</span>
                                        </div>
                                        <div class="ac-meta">${client.email}</div>
                                    </div>
                                `;
                                item.onclick = function() {
                                    searchInput.value = `${client.name} (${client.accountId})`;
                                    hiddenClientId.value = client.clientProfileId;
                                    dropdown.style.display = 'none';
                                };
                                dropdown.appendChild(item);
                            });
                        } else {
                            dropdown.style.display = 'block';
                            dropdown.innerHTML = `
                                <div class="autocomplete-item" style="cursor: default; background: #fff;">
                                    <div class="ac-avatar" style="background: #FEE2E2; color: #DC2626;"><i class="bi bi-x-circle-fill"></i></div>
                                    <div class="ac-details">
                                        <div class="ac-name text-danger">No Client Found</div>
                                        <div class="ac-meta">Try adjusting your search terms.</div>
                                    </div>
                                </div>`;
                        }
                    })
                    .catch(err => console.error("Error fetching clients:", err));
            }, 300);
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });
    </script>
}