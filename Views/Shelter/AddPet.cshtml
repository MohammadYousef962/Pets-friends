@model Pets_friends.Data.ViewModels.PetFormVM

@{
    ViewData["Title"] = "Shelter Intake";
    Layout = "~/Views/Shared/_ShelterLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand-primary: #5C3D1E;
            --brand-accent: #C8A882;
            --shelter-color: #C96C2D;
            --text-dark: #1A1A1A;
            --text-muted: #6B7280;
        }

        body {
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%) !important;
            background-attachment: fixed !important;
            font-family: 'DM Sans', sans-serif;
            color: var(--text-dark);
            padding-bottom: 60px;
        }

        .glass-card {
            background: #FFFFFF;
            border-radius: 32px;
            padding: 45px;
            box-shadow: 0 20px 50px rgba(92, 61, 30, 0.05);
            border: 1px solid #EBE0D5;
            max-width: 850px;
            margin: 60px auto;
        }

        .section-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 2rem;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-dark);
        }

        .pet-preview-circle {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 6px solid #fff;
            box-shadow: 0 10px 25px rgba(92, 61, 30, 0.1);
            margin: 0 auto 15px;
            overflow: hidden;
            background: #EBE0D5;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .pet-preview-circle img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .upload-trigger {
            background: #fff;
            border: 2px dashed var(--brand-accent);
            border-radius: 16px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: block;
            width: 100%;
            max-width: 250px;
            margin: 0 auto 35px;
            text-align: center;
        }

            .upload-trigger:hover {
                border-color: var(--brand-primary);
                background: #FAF6F1;
                transform: translateY(-2px);
            }

        .form-label {
            font-weight: 800;
            color: var(--text-muted);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            display: block;
        }

        .form-control-custom {
            width: 100%;
            padding: 14px 20px;
            border-radius: 16px;
            border: 2px solid #EBE0D5;
            background: #fff;
            font-weight: 600;
            margin-bottom: 20px;
            transition: 0.2s ease;
            color: var(--text-dark);
        }

            .form-control-custom:focus {
                border-color: var(--brand-accent);
                outline: none;
                box-shadow: 0 0 0 4px rgba(200,168,130,0.15);
            }

        .intake-banner {
            background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
            border: 2px solid #FED7AA;
            padding: 22px;
            border-radius: 22px;
            margin-bottom: 28px;
        }

        .intake-banner-title {
            font-weight: 800;
            font-size: 1.05rem;
            color: #9A3412;
            margin-bottom: 5px;
        }

        .intake-banner-text {
            color: #7C2D12;
            font-weight: 500;
            margin: 0;
        }

        .btn-submit {
            color: #fff;
            font-weight: 800;
            border-radius: 50px;
            padding: 18px;
            border: none;
            width: 100%;
            font-size: 1.1rem;
            transition: all 0.2s ease;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            background: var(--shelter-color);
            box-shadow: 0 8px 20px rgba(201,108,45,0.25);
            margin-top: 20px;
        }

            .btn-submit:hover {
                background: #A95520;
                transform: translateY(-3px);
            }

        .custom-checkbox {
            width: 20px;
            height: 20px;
            margin-top: 0.15rem;
            border: 2px solid #EBE0D5;
            cursor: pointer;
            border-radius: 6px;
        }

            .custom-checkbox:checked {
                background-color: var(--brand-accent);
                border-color: var(--brand-accent);
            }
    </style>
}

<div class="glass-card">

    <h1 class="section-title">
        <i class="bi bi-house-heart-fill" style="color: var(--shelter-color);"></i>
        Shelter Intake Registration
    </h1>

    <p class="text-muted mb-4 fw-medium" style="font-size: 1.05rem;">
        Register rescued, surrendered, transferred, or newborn pets into your shelter system.
    </p>

    <div class="intake-banner">
        <div class="intake-banner-title">
            <i class="bi bi-info-circle-fill me-2"></i>
            Internal Shelter Resident
        </div>

        <p class="intake-banner-text">
            Newly added pets are automatically kept internal and hidden from public adoption listings until manually approved by the shelter.
        </p>
    </div>

    <form asp-action="AddPet" method="post" enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div class="pet-preview-circle">
            <img id="imgPreview"
                 src="https://placehold.co/200x200/EBE0D5/5C3D1E?text=Pet&font=DM+Sans"
                 alt="Preview">
        </div>

        <div class="upload-trigger" onclick="document.getElementById('fileInput').click()">
            <div class="fw-bold" style="color: var(--brand-primary); font-size: 0.95rem;">
                <i class="bi bi-camera me-1"></i>
                Upload Shelter Intake Photo
            </div>

            <input asp-for="ImageFile"
                   type="file"
                   id="fileInput"
                   hidden
                   accept="image/*"
                   onchange="handleFilePreview(this)" />
        </div>

        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Pet Name</label>
                <input asp-for="Name"
                       class="form-control-custom"
                       placeholder="e.g. Luna"
                       required>
            </div>

            <div class="col-md-6">
                <label asp-for="Breed" class="form-label">Breed / Species</label>
                <input asp-for="Breed"
                       class="form-control-custom"
                       placeholder="e.g. Husky Mix"
                       required>
            </div>

            <div class="col-md-6">
                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                <input asp-for="DateOfBirth"
                       type="date"
                       class="form-control-custom"
                       required>
            </div>

            <div class="col-md-6">
                <label asp-for="Gender" class="form-label">Gender</label>

                <select asp-for="Gender"
                        class="form-control-custom"
                        id="genderSelect"
                        onchange="updateSpayNeuterLabel()"
                        required>

                    <option value="" disabled selected>Select Gender...</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>

                <div class="form-check align-items-center gap-2"
                     id="spayNeuterContainer"
                     style="display: none !important; padding-left: 0.5em;">

                    <input asp-for="IsNeutered"
                           class="form-check-input custom-checkbox shadow-none m-0"
                           type="checkbox"
                           id="spayNeuterCheck">

                    <label class="form-check-label fw-bold"
                           for="spayNeuterCheck"
                           id="spayNeuterLabel"
                           style="color: var(--text-dark); font-size: 0.9rem; cursor: pointer;">

                        Neutered
                    </label>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="MedicalHistory" class="form-label">
                    Medical Notes
                </label>

                <textarea asp-for="MedicalHistory"
                          class="form-control-custom"
                          rows="3"
                          placeholder="Vaccinations, injuries, allergies, medications, rescue condition, etc..."></textarea>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">
                    Personality / Intake Notes
                </label>

                <textarea asp-for="Description"
                          class="form-control-custom"
                          rows="3"
                          placeholder="Describe temperament, rescue details, social behavior, or special notes..."></textarea>
            </div>

        </div>

        <button type="submit" class="btn-submit">
            <i class="bi bi-heart-fill"></i>
            Register Shelter Pet
        </button>

    </form>
</div>

@section Scripts {

    <script>

        function handleFilePreview(input) {

            if (input.files && input.files[0]) {

                const reader = new FileReader();

                reader.onload = e => {
                    document.getElementById('imgPreview').src = e.target.result;
                };

                reader.readAsDataURL(input.files[0]);
            }
        }

        function updateSpayNeuterLabel() {

            const gender = document.getElementById('genderSelect').value;
            const container = document.getElementById('spayNeuterContainer');
            const label = document.getElementById('spayNeuterLabel');

            if (gender === 'Male') {

                container.style.setProperty('display', 'flex', 'important');
                label.innerText = 'Neutered (Castrated)';

            } else if (gender === 'Female') {

                container.style.setProperty('display', 'flex', 'important');
                label.innerText = 'Spayed';

            } else {

                container.style.setProperty('display', 'none', 'important');
            }
        }

    </script>
}