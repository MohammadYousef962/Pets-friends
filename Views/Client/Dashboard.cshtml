@model Pets_friends.Data.ViewModels.ClientDashboardVM

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        :root {
            --text-dark: #1F2937;
            --text-muted: #6B7280;
            --text-label: #374151;
            --brand-primary: #5C3D1E;
            --brand-accent: #C8A882;
            --bg-input: #F9FAFB;
            --border-light: #E5E7EB;
        }

        /* FORCE THE BACKGROUND GRADIENT */
        body {
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%) !important;
            background-attachment: fixed !important;
            min-height: 100vh;
        }

        .profile-wrapper {
            max-width: 950px;
            margin: 50px auto 0;
            background: #FFFFFF;
            border-radius: 24px;
            padding: 50px;
            box-shadow: 0 10px 40px rgba(92, 61, 30, 0.05);
            border: 1px solid rgba(255,255,255,0.8);
        }

        .profile-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 40px;
            padding-bottom: 30px;
            border-bottom: 1px solid var(--border-light);
            flex-wrap: wrap;
            gap: 20px;
        }

        .user-info-group {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .profile-avatar-large {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            object-fit: cover;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            background: #FAF6F1;
            border: 1px solid var(--border-light);
        }

        .user-name {
            font-weight: 800;
            font-size: 1.35rem;
            color: var(--text-dark);
            margin: 0 0 4px 0;
            font-family: 'Nunito', sans-serif;
        }

        /* THE COPY ID BADGE */
        .id-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #F3F4F6;
            color: var(--text-muted);
            padding: 4px 12px;
            border-radius: 8px;
            font-family: monospace;
            font-size: 0.85rem;
            font-weight: 600;
            border: 1px solid var(--border-light);
            cursor: pointer;
            transition: all 0.2s;
        }

            .id-badge:hover {
                background: #FAF6F1;
                color: var(--brand-primary);
                border-color: var(--brand-accent);
            }

        .btn-edit {
            background-color: var(--brand-primary);
            color: #FFFFFF;
            border: none;
            border-radius: 10px;
            padding: 10px 30px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-block;
            box-shadow: 0 4px 10px rgba(92, 61, 30, 0.15);
        }

            .btn-edit:hover {
                background-color: var(--brand-accent);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(200, 168, 130, 0.3);
            }

        .form-label-custom {
            font-weight: 600;
            color: var(--text-label);
            font-size: 0.95rem;
            margin-bottom: 8px;
            display: block;
        }

        .form-control-soft {
            background-color: var(--bg-input);
            border: 1px solid transparent;
            border-radius: 12px;
            padding: 14px 18px;
            color: var(--text-dark);
            font-size: 0.95rem;
            font-weight: 500;
            width: 100%;
        }

        .pets-section {
            margin-top: 50px;
            padding-top: 40px;
            border-top: 1px solid var(--border-light);
        }

        .section-heading {
            font-weight: 800;
            font-size: 1.3rem;
            color: var(--text-dark);
            margin-bottom: 0;
            font-family: 'Nunito', sans-serif;
        }

        .btn-add-pet {
            background-color: #FAF6F1;
            color: var(--brand-primary);
            border: 1px solid #EBE0D5;
            padding: 8px 20px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

            .btn-add-pet:hover {
                background-color: var(--brand-primary);
                color: #fff;
                border-color: var(--brand-primary);
            }

        .pet-card {
            background: #fff;
            border-radius: 20px;
            padding: 15px;
            border: 1px solid #EBE0D5;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            height: 100%;
            box-shadow: 0 4px 15px rgba(92, 61, 30, 0.02);
            text-decoration: none;
            cursor: pointer;
        }

            .pet-card:hover {
                transform: translateY(-5px);
                border-color: var(--brand-accent);
                box-shadow: 0 10px 25px rgba(92, 61, 30, 0.08);
            }

        .pet-img-wrapper {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 12px;
            height: 180px;
        }

        .pet-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.5s;
        }

        .pet-card:hover .pet-img {
            transform: scale(1.05);
        }

        .pet-overlay {
            position: absolute;
            inset: 0;
            background: rgba(45, 27, 14, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            backdrop-filter: blur(2px);
        }

        .pet-card:hover .pet-overlay {
            opacity: 1;
        }

        .btn-overlay-view {
            background: rgba(255,255,255,0.2);
            color: #fff;
            font-weight: 700;
            padding: 10px 24px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.8);
            font-size: 0.95rem;
            font-family: 'Nunito', sans-serif;
        }

        .pet-info {
            padding: 0 5px;
            flex-grow: 1;
            text-align: left;
        }

        .pet-name {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.2rem;
            margin-top: 10px;
            margin-bottom: 2px;
            color: var(--text-dark);
        }

        .pet-breed {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .btn-view-all {
            color: var(--brand-primary);
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.95rem;
            transition: color 0.2s;
        }

            .btn-view-all:hover {
                color: var(--brand-accent);
            }

        /* MODAL SPECIFIC CSS FOR DASHBOARD */
        .modal-content {
            border-radius: 24px;
            border: none;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }

        .locked-field {
            background: #F3F4F6;
            border: 1px solid #E5E7EB;
            border-radius: 12px;
            padding: 12px 16px;
            color: #4B5563;
            font-weight: 600;
            margin-bottom: 15px;
            text-align: left;
        }

        .locked-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 800;
            color: #9CA3AF;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        @@media (max-width: 768px) {
            .profile-wrapper {
                padding: 30px 20px;
                margin-top: 30px;
            }

            .profile-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .btn-edit {
                width: 100%;
                text-align: center;
            }
        }
    </style>
}

<div class="container px-3 pb-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 mt-4 mb-0 d-flex align-items-center border-0 shadow-sm" style="background: #ECFDF5; color: #065F46; padding: 16px 20px; max-width: 950px; margin: 0 auto;">
            <i class="bi bi-check-circle-fill me-3 fs-5" style="color: #10B981;"></i>
            <div class="fw-bold">@TempData["SuccessMessage"]</div>
        </div>
    }

    <div class="profile-wrapper">

        <div class="profile-header">
            <div class="user-info-group">
                @{
                    var safeName = Model.FullName.Replace(" ", "+");
                    var generatedAvatar = $"https://ui-avatars.com/api/?name={safeName}&background=EBE0D5&color=5C3D1E&font-family=Nunito&bold=true&size=150";
                    var avatarUrl = string.IsNullOrEmpty(Model.ExistingImageUrl) ? generatedAvatar : Model.ExistingImageUrl;
                }
                <img src="@avatarUrl" alt="@Model.FullName" class="profile-avatar-large">
                <div>
                    <h2 class="user-name">@Model.FullName</h2>
                    <div class="id-badge" onclick="copyToClipboard('@Model.FormattedAccountId', this)" title="Copy Full ID">
                        ID: @Model.FormattedAccountId <i class="bi bi-copy"></i>
                    </div>
                </div>
            </div>
            <a asp-action="EditProfile" class="btn-edit">Edit Profile</a>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label-custom">Full Name</label>
                <div class="form-control-soft">@Model.FullName</div>
            </div>

            <div class="col-md-6">
                <label class="form-label-custom">Email Address</label>
                <div class="form-control-soft">@Model.Email</div>
            </div>

            <div class="col-md-6">
                <label class="form-label-custom">Gender</label>
                <div class="form-control-soft">@(string.IsNullOrWhiteSpace(Model.Gender) ? "Not specified" : Model.Gender)</div>
            </div>

            <div class="col-md-6">
                <label class="form-label-custom">Phone Number</label>
                <div class="form-control-soft">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</div>
            </div>

            <div class="col-md-12">
                <label class="form-label-custom">City</label>
                <div class="form-control-soft">@(string.IsNullOrWhiteSpace(Model.City) ? "Not provided" : Model.City)</div>
            </div>
        </div>

        <div class="pets-section">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-3 mb-4">
                <h3 class="section-heading">My Official Pets</h3>
                <a asp-controller="Home" asp-action="Clinics" class="btn-add-pet">
                    <i class="bi bi-plus-lg me-1"></i> Register New Pet (Via Vet)
                </a>
            </div>

            @if (Model.RecentPets != null && Model.RecentPets.Any())
            {
                <div class="row g-4">
                    @foreach (var pet in Model.RecentPets.Take(3))
                    {
                        var age = DateTime.Now.Year - pet.DateOfBirth.Year;
                        if (pet.DateOfBirth.Date > DateTime.Now.AddYears(-age)) { age--; }

                        <div class="col-md-4">
                            <!-- UPDATED TO TRIGGER THE MODAL -->
                            <div class="pet-card" data-bs-toggle="modal" data-bs-target="#viewModal-@pet.Id">
                                <div class="pet-img-wrapper">
                                    <img src="@(pet.ImageUrl ?? "https://placehold.co/400x400/FAF6F1/5C3D1E?text=Pet")" class="pet-img" alt="@pet.Name">
                                    <div class="pet-overlay">
                                        <span class="btn-overlay-view">View Details</span>
                                    </div>
                                </div>
                                <div class="pet-info">
                                    <div class="pet-name">@pet.Name</div>
                                    <div class="pet-breed">@pet.Breed • @age yrs</div>
                                </div>
                            </div>
                        </div>

                        <!-- NEW VIEW-ONLY MODAL PORTED FROM MYPETS -->
                        <div class="modal fade" id="viewModal-@pet.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" style="font-family: 'Nunito', sans-serif; font-weight: 800; color: #2D1B0E;">@pet.Name's Official Profile</h5>
                                        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div style="background: #F0FDF4; color: #065F46; padding: 12px 20px; font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #D1FAE5;">
                                        <i class="bi bi-shield-check fs-5"></i>
                                        Official verified medical records from our partner clinics.
                                    </div>

                                    <div class="modal-body p-4 text-start">
                                        <div class="row g-4">

                                            <!-- LEFT COLUMN: Image & Description -->
                                            <div class="col-md-6 border-end pe-md-4">
                                                <img src="@(pet.ImageUrl ?? "https://placehold.co/400x400/FAF6F1/5C3D1E?text=Pet")" alt="@pet.Name" style="width: 100%; height: 280px; object-fit: cover; border-radius: 16px; margin-bottom: 20px; border: 1px solid var(--border-light);">

                                                <h3 class="fw-bold mb-3" style="color: var(--text-dark); font-family: 'Nunito', sans-serif;">@pet.Name</h3>

                                                <label class="locked-label" style="color: var(--brand-accent);">Personality / Description</label>
                                                <div style="background: #FFFFFF; border: 1px solid var(--border-light); border-radius: 12px; padding: 16px; color: #1F2937; font-size: 0.95rem; line-height: 1.6; font-weight: 500;">
                                                    @(string.IsNullOrWhiteSpace(pet.Description) ? "No description provided." : pet.Description)
                                                </div>
                                            </div>

                                            <!-- RIGHT COLUMN: Medical Data -->
                                            <div class="col-md-6 ps-md-4">
                                                <h6 class="fw-bold mb-4" style="color: var(--text-muted); font-family: 'Nunito', sans-serif;">Verified Medical ID</h6>

                                                <div class="locked-label">Breed / Species <i class="bi bi-patch-check-fill text-success"></i></div>
                                                <div class="locked-field">@pet.Breed</div>

                                                <div class="row">
                                                    <div class="col-6">
                                                        <div class="locked-label">Age</div>
                                                        <div class="locked-field">@age years</div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="locked-label">Gender</div>
                                                        <div class="locked-field">@pet.Gender</div>
                                                    </div>
                                                </div>

                                                <div class="locked-label">Reproductive Status</div>
                                                <div class="locked-field">@(pet.IsNeutered ? "Neutered / Spayed" : "Intact")</div>

                                                <div class="locked-label">Medical History</div>
                                                <div class="locked-field mb-0" style="min-height: 120px; line-height: 1.6;">
                                                    @(string.IsNullOrWhiteSpace(pet.MedicalHistory) ? "No history recorded by vet." : pet.MedicalHistory)
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal-footer" style="background: #FAFAFA; border-top: 1px solid var(--border-light); padding: 20px 30px;">
                                        <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Close Window</button>
                                        <a asp-controller="Client" asp-action="MyPets" class="btn rounded-pill px-4 text-white fw-bold" style="background: var(--brand-primary); border: none;">Edit Details <i class="bi bi-pencil-square ms-1"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.RecentPets.Count > 3)
                {
                    <div class="text-center mt-4 pt-2">
                        <a asp-controller="Client" asp-action="MyPets" class="btn-view-all">Manage All My Pets <i class="bi bi-arrow-right"></i></a>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 rounded-4" style="background: #FAF6F1; border: 1px dashed #EBE0D5;">
                    <i class="bi bi-heptagon fs-1 text-muted d-block mb-2"></i>
                    <h5 class="fw-bold" style="color: var(--text-dark);">No pets registered yet</h5>
                    <p class="text-muted small mb-0 px-3">To ensure medical accuracy, new pets must be officially verified and added by a licensed Vet or Shelter.</p>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard(text, element) {
            navigator.clipboard.writeText(text).then(() => {
                const icon = element.querySelector('i');
                const originalClass = icon.className;
                icon.className = 'bi bi-check-lg text-success fs-6';
                setTimeout(() => { icon.className = originalClass; }, 2000);
            }).catch(err => {
                console.error('Failed to copy text: ', err);
            });
        }
    </script>
}