@model IEnumerable<Pets_friends.Models.Appointment>
@{
    ViewData["Title"]      = "My Appointments";
    ViewData["ActivePage"] = "Appointments";
    Layout = "_ClientLayout";

    var now      = DateTime.Now;
    var upcoming = Model?.Where(a => a.AppointmentDate >= now).OrderBy(a => a.AppointmentDate).ToList()
                   ?? new List<Pets_friends.Models.Appointment>();
    var past     = Model?.Where(a => a.AppointmentDate < now).OrderByDescending(a => a.AppointmentDate).ToList()
                   ?? new List<Pets_friends.Models.Appointment>();
}

@section Styles {
<style>
/* ═══════════════════════════════════════════════════════════════
   APPOINTMENTS — PAGE STYLES
═══════════════════════════════════════════════════════════════ */

.page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 28px;
}

.page-title-block .page-eyebrow {
    font-size: .8rem;
    font-weight: 600;
    color: var(--tan);
    letter-spacing: .8px;
    text-transform: uppercase;
    margin-bottom: 4px;
}

.page-title-block h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--brown-deep);
    line-height: 1.15;
    margin: 0;
}

.btn-primary-pf {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--brown-deep);
    color: #fff;
    border: none;
    padding: 12px 22px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: .88rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background .2s, transform .15s;
}

.btn-primary-pf:hover {
    background: #7a5229;
    color: #fff;
    transform: translateY(-1px);
}

/* ─── Tabs ────────────────────────────────────────────────── */
.appt-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 24px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 50px;
    padding: 4px;
    width: fit-content;
    backdrop-filter: blur(8px);
}

.appt-tab {
    padding: 8px 20px;
    border-radius: 50px;
    font-size: .85rem;
    font-weight: 600;
    color: var(--brown-mid);
    cursor: pointer;
    border: none;
    background: transparent;
    transition: all .2s;
    font-family: 'DM Sans', sans-serif;
}

.appt-tab.active {
    background: var(--brown-deep);
    color: #fff;
}

.tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: .68rem;
    font-weight: 700;
    margin-left: 6px;
    background: rgba(200,168,130,.25);
    color: var(--brown-mid);
}

.appt-tab.active .tab-badge {
    background: rgba(255,255,255,.25);
    color: #fff;
}

.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* ─── Appointment Card ────────────────────────────────────── */
.appt-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.appt-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 24px;
    transition: transform .2s, box-shadow .2s;
}

.appt-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(92,61,30,.12);
}

.appt-card.is-past {
    opacity: .65;
}

.appt-date-block {
    flex-shrink: 0;
    width: 58px;
    height: 64px;
    border-radius: 12px;
    background: var(--tan-light);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
}

.appt-day {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brown-deep);
    line-height: 1;
}

.appt-month {
    font-size: .65rem;
    font-weight: 700;
    color: var(--brown-mid);
    text-transform: uppercase;
    letter-spacing: .5px;
}

.appt-info {
    flex: 1;
    min-width: 0;
}

.appt-service {
    font-size: .95rem;
    font-weight: 700;
    color: var(--brown-deep);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.appt-meta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 3px;
}

.appt-meta-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: .78rem;
    color: var(--brown-mid);
}

.appt-meta-item i { font-size: .7rem; }

/* ─── Status pills ────────────────────────────────────────── */
.status-pill {
    padding: 5px 14px;
    border-radius: 50px;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .3px;
    flex-shrink: 0;
}

.status-pending   { background: rgba(255,152,0,.15);  color: #e65100; }
.status-confirmed { background: rgba(76,175,80,.12);  color: #388e3c; }
.status-cancelled { background: rgba(229,57,53,.1);   color: #c62828; }
.status-completed { background: rgba(92,61,30,.1);    color: var(--brown-deep); }

/* ─── Cancel button ───────────────────────────────────────── */
.btn-cancel-appt {
    padding: 5px 14px;
    border-radius: 50px;
    font-size: .72rem;
    font-weight: 600;
    color: #c62828;
    background: rgba(229,57,53,.08);
    border: 1px solid rgba(229,57,53,.2);
    cursor: pointer;
    text-decoration: none;
    transition: background .15s;
    white-space: nowrap;
    margin-left: 8px;
}

.btn-cancel-appt:hover {
    background: rgba(229,57,53,.15);
    color: #c62828;
}

/* ─── Empty state ─────────────────────────────────────────── */
.empty-state {
    text-align: center;
    padding: 56px 32px;
}

.empty-state i {
    font-size: 2.8rem;
    color: var(--tan);
    display: block;
    margin-bottom: 14px;
}

.empty-state h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--brown-deep);
    margin-bottom: 8px;
}

.empty-state p {
    color: var(--brown-mid);
    font-size: .88rem;
    margin-bottom: 20px;
}
</style>
}

<div class="page-header fade-up">
    <div class="page-title-block">
        <div class="page-eyebrow">Schedule</div>
        <h1>My Appointments</h1>
    </div>
    <a asp-action="Index" asp-controller="Vet" class="btn-primary-pf">
        <i class="bi bi-calendar2-plus"></i> Book Appointment
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert d-flex align-items-center gap-2 mb-4 fade-up"
         style="border-radius:10px; border:none; background:rgba(76,175,80,.1); color:#2e7d32;">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert d-flex align-items-center gap-2 mb-4 fade-up"
         style="border-radius:10px; border:none; background:rgba(229,57,53,.08); color:#c62828;">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}


<div class="appt-tabs fade-up">
    <button class="appt-tab active" onclick="switchTab('upcoming', this)">
        Upcoming
        <span class="tab-badge">@upcoming.Count</span>
    </button>
    <button class="appt-tab" onclick="switchTab('past', this)">
        Past
        <span class="tab-badge">@past.Count</span>
    </button>
</div>

<div id="tab-upcoming" class="tab-panel active">
    @if (upcoming.Any())
    {
        <div class="appt-list">
            @foreach (var appt in upcoming)
            {
                var statusClass = appt.Status switch {
                    "Confirmed" => "status-confirmed",
                    "Cancelled" => "status-cancelled",
                    _           => "status-pending"
                };

                <div class="glass-card appt-card fade-up">
                    <div class="appt-date-block">
                        <div class="appt-day">@appt.AppointmentDate.Day</div>
                        <div class="appt-month">@appt.AppointmentDate.ToString("MMM")</div>
                    </div>

                    <div class="appt-info">
                        <div class="appt-service">
                            @appt.ServiceType
                            @if (appt.Pet != null)
                            {
                                <span style="color:var(--brown-mid); font-weight:400;"> — @appt.Pet.Name</span>
                            }
                        </div>
                        <div class="appt-meta-row">
                            @if (appt.Provider != null)
                            {
                                <div class="appt-meta-item">
                                    <i class="bi bi-person-circle"></i>
                                    @(appt.Provider.UserAccount?.FullName ?? appt.Provider.ClinicName)
                                </div>
                            }
                            <div class="appt-meta-item">
                                <i class="bi bi-clock"></i>
                                @appt.AppointmentDate.ToString("h:mm tt")
                            </div>
                            @if (!string.IsNullOrEmpty(appt.LocationName))
                            {
                                <div class="appt-meta-item">
                                    <i class="bi bi-geo-alt"></i>
                                    @appt.LocationName
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex align-items-center flex-shrink-0">
                        <span class="status-pill @statusClass">@appt.Status</span>
                        @if (appt.Status == "Pending" || appt.Status == "Confirmed")
                        {
                            <form asp-action="CancelAppointment" asp-controller="Client" method="post" style="display:inline;"
                                  onsubmit="return confirm('Cancel this appointment?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                <button type="submit" class="btn-cancel-appt">Cancel</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="glass-card empty-state fade-up">
            <i class="bi bi-calendar2-x"></i>
            <h3>No upcoming appointments</h3>
            <p>Book a visit with one of our trusted vets.</p>
            <a asp-action="Index" asp-controller="Vet" class="btn-primary-pf">
                <i class="bi bi-search"></i> Find a Vet
            </a>
        </div>
    }
</div>

<div id="tab-past" class="tab-panel">
    @if (past.Any())
    {
        <div class="appt-list">
            @foreach (var appt in past)
            {
                var statusClass = appt.Status switch {
                    "Confirmed" => "status-confirmed",
                    "Cancelled" => "status-cancelled",
                    "Completed" => "status-completed",
                    _           => "status-pending"
                };

                <div class="glass-card appt-card is-past fade-up">
                    <div class="appt-date-block">
                        <div class="appt-day">@appt.AppointmentDate.Day</div>
                        <div class="appt-month">@appt.AppointmentDate.ToString("MMM")</div>
                    </div>

                    <div class="appt-info">
                        <div class="appt-service">
                            @appt.ServiceType
                            @if (appt.Pet != null)
                            {
                                <span style="color:var(--brown-mid); font-weight:400;"> — @appt.Pet.Name</span>
                            }
                        </div>
                        <div class="appt-meta-row">
                            @if (appt.Provider != null)
                            {
                                <div class="appt-meta-item">
                                    <i class="bi bi-person-circle"></i>
                                    @(appt.Provider.UserAccount?.FullName ?? appt.Provider.ClinicName)
                                </div>
                            }
                            <div class="appt-meta-item">
                                <i class="bi bi-clock"></i>
                                @appt.AppointmentDate.ToString("h:mm tt")
                            </div>
                        </div>
                    </div>

                    <span class="status-pill @statusClass">@appt.Status</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="glass-card empty-state fade-up">
            <i class="bi bi-clock-history"></i>
            <h3>No past appointments</h3>
            <p>Your visit history will appear here.</p>
        </div>
    }
</div>

@section Scripts {
<script>
    function switchTab(name, btn) {
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.appt-tab').forEach(b => b.classList.remove('active'));
        document.getElementById('tab-' + name).classList.add('active');
        btn.classList.add('active');
    }

    const obs = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.style.animationPlayState = 'running';
                obs.unobserve(e.target);
            }
        });
    }, { threshold: 0.08 });

    document.querySelectorAll('.fade-up').forEach((el, i) => {
        el.style.animationPlayState = 'paused';
        el.style.animationDelay = (i * 0.05) + 's';
        obs.observe(el);
    });
</script>
}
