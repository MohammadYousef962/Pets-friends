@model IEnumerable<Pets_friends.Models.Pet>
@{
    ViewData["Title"] = "My Pets";
    Layout = "_ClientLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: var(--brown-deep); font-weight: 700;">My Furry Family</h2>
        <a asp-action="AddPet" asp-controller="Client" class="btn btn-primary" style="background-color: var(--brown-deep); border: none; border-radius: 50px; padding: 10px 20px;">
            <i class="bi bi-plus-lg"></i> Add New Pet
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var pet in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm" style="border-radius: 16px; border: 1px solid var(--tan-light);">
                        <div class="card-body text-center">
                            
                            <div style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; background: var(--cream-warm); border: 3px solid var(--tan); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; position: relative;">
                                @if (!string.IsNullOrEmpty(pet.PhotoUrl))
                                {
                                    <img src="@pet.PhotoUrl" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" alt="@pet.Name" />
                                }
                                else
                                {
                                    <span>@(pet.Species == "Cat" ? "🐱" : pet.Species == "Dog" ? "🐶" : "🐾")</span>
                                }
                                
                                @if (pet.IsVerified)
                                {
                                    <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; color: white;">
                                        <i class="bi bi-check"></i>
                                    </span>
                                }
                            </div>

                            <h4 style="color: var(--brown-deep); font-family: 'Playfair Display', serif; font-weight: 700;">@pet.Name</h4>
                            <p class="text-muted mb-2">@pet.Species · @pet.Breed</p>
                            <p style="font-size: 0.9rem; color: var(--brown-mid);">Age: @pet.AgeYears year@(pet.AgeYears == 1 ? "" : "s")</p>

                            <div class="mt-3">
                                <a asp-action="PetDetail" asp-controller="Client" asp-route-id="@pet.Id" class="btn btn-outline-primary w-100" style="border-color: var(--tan); color: var(--brown-deep); border-radius: 50px;">
                                    View Details
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h4 style="color: var(--brown-mid);">You haven't added any pets yet!</h4>
                <p>Click the button above to add your first pet to your profile.</p>
            </div>
        }
    </div>
</div>