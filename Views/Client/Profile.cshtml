@model Pets_friends.Models.UserAccount
@{
    ViewData["Title"] = "My Profile";
    Layout = "_ClientLayout";
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="card shadow-sm p-0 fade-up" style="width: 100%; max-width: 700px; border-radius: 16px; border: 1px solid var(--tan-light); overflow: hidden;">
        
        <div style="background-color: #fdfaf7; height: 120px; border-bottom: 1px solid var(--glass-border);"></div>
        
        <div class="card-body px-4 px-md-5 pb-5 text-center" style="margin-top: -60px;">
            
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" style="width: 120px; height: 120px; background: linear-gradient(135deg, var(--tan), var(--brown-deep)); color: white; border: 4px solid white;">
                <h1 style="margin: 0; font-family: 'Playfair Display', serif; font-size: 3rem;">
                    @(string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName.Substring(0, 1).ToUpper())
                </h1>
            </div>

            <h2 style="color: var(--brown-deep); font-family: 'Playfair Display', serif; font-weight: 700;">
                @(Model.FullName ?? "Valued Member")
            </h2>
            <p class="text-muted mb-4">
                <i class="bi bi-envelope me-1"></i> @Model.Email
            </p>

            <div class="row text-start g-4 mt-2 border-top pt-4">
                
                <div class="col-md-6">
                    <label class="text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px; font-weight: 600;">Phone Number</label>
                    <p style="color: var(--brown-deep); font-weight: 600; font-size: 1.1rem;">
                        @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)
                    </p>
                </div>
                
                <div class="col-md-6">
                    <label class="text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px; font-weight: 600;">Location</label>
                    <p style="color: var(--brown-deep); font-weight: 600; font-size: 1.1rem;">
                        @(string.IsNullOrEmpty(Model.City) ? "Not provided" : Model.City)
                    </p>
                </div>
                
                <div class="col-md-6">
                    <label class="text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px; font-weight: 600;">Gender</label>
                    <p style="color: var(--brown-deep); font-weight: 600; font-size: 1.1rem;">
                        @(string.IsNullOrEmpty(Model.Gender) ? "Not specified" : Model.Gender)
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px; font-weight: 600;">Account Status</label>
                    <p style="color: var(--tan); font-weight: 600; font-size: 1.1rem;">
                        <i class="bi bi-check-circle-fill me-1"></i> Active
                    </p>
                </div>

            </div>

            <div class="mt-5">
                <a asp-controller="Account" asp-action="EditProfile" class="btn" style="background-color: var(--brown-deep); color: white; border-radius: 50px; padding: 12px 36px; font-weight: 600;">
                    <i class="bi bi-pencil-square me-2"></i> Edit Profile Details
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <style>
        .fade-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeUp 0.5s ease forwards;
        }

        @@keyframes fadeUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}