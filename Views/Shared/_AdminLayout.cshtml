@using Microsoft.AspNetCore.Identity
@using Pets_friends.Models
@inject UserManager<UserAccount> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Control Center</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        body {
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%);
            font-family: 'DM Sans', sans-serif;
            color: #5C3D1E;
            -webkit-font-smoothing: antialiased;
        }

        .admin-navbar {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(235, 224, 213, 0.6);
            z-index: 1000;
            box-shadow: 0 8px 32px rgba(92, 61, 30, 0.05);
            padding: 12px 0;
        }

        .dropdown-menu-custom {
            border: 1px solid #EBE0D5;
            border-radius: 20px; /* Enhanced soft edges */
            box-shadow: 0 15px 45px rgba(92, 61, 30, 0.12);
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(15px);
            margin-top: 15px !important;
            min-width: 240px;
            padding: 12px 0;
            animation: fadeIn 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .dropdown-item-custom {
            padding: 10px 24px;
            font-weight: 600;
            color: #5C3D1E;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.95rem;
            text-decoration: none;
        }

            .dropdown-item-custom:hover {
                background-color: #FAF6F1;
                color: #7b4f2c;
                padding-left: 28px; /* Smooth elegant slide-out effect */
            }

            .dropdown-item-custom i {
                color: #8C7560;
                font-size: 1.15rem;
                transition: color 0.25s ease;
            }

            .dropdown-item-custom:hover i {
                color: #7b4f2c;
            }

        .dropdown-divider-custom {
            border-top: 1px solid #EBE0D5;
            margin: 10px 0;
        }

        .dropdown-item-logout {
            color: #dc3545;
            font-weight: 600;
            transition: all 0.25s ease;
            padding: 10px 24px;
            white-space: nowrap;
            font-size: 0.95rem;
            background: none;
            border: none;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .dropdown-item-logout:hover {
                background: #fff5f5;
                color: #c9302c;
                padding-left: 28px;
            }

            .dropdown-item-logout i {
                color: #dc3545;
                font-size: 1.15rem;
            }

        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            margin-top: 75px;
        }

        .glass-panel {
            background: rgba(255, 250, 245, 0.95);
            border-radius: 32px;
            padding: 40px;
            box-shadow: 0 25px 60px rgba(91, 62, 43, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.7);
        }

        .admin-wrapper {
            flex: 1;
            padding: 40px 20px;
        }
    </style>
</head>
<body>

    @{
        string firstName = "Admin";
        string targetAvatar = "";

        if (User.Identity?.IsAuthenticated == true)
        {
            var user = await UserManager.GetUserAsync(User);
            if (user != null && !string.IsNullOrEmpty(user.FullName))
            {
                firstName = user.FullName.Split(' ')[0];
            }

            // Premium UI Avatar fallback with your precise theme profile colors
            targetAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(firstName)}&background=EDE0D0&color=5C3D1E&bold=true&size=128";
        }
    }

    <header>
        <nav class="navbar navbar-expand-sm admin-navbar fixed-top">
            <div class="container py-1" style="max-width: 1300px;">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" style="color: #5C3D1E; font-family: 'Playfair Display'; font-size: 1.25rem;" asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-shield-lock-fill" style="color: #C8A882; font-size: 1.3rem;"></i> Pet Friends Admin
                </a>

                <div class="d-flex align-items-center gap-3 ms-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="d-flex align-items-center gap-2 text-decoration-none" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: #5C3D1E; font-weight: 600; font-size: 0.95rem;">
                                <img src="@targetAvatar" style="width: 36px; height: 36px; border-radius: 50%; border: 2px solid #C8A882; object-fit: cover;" alt="Admin Avatar">
                                <span>@firstName (Admin)</span>
                                <i class="bi bi-caret-down-fill" style="font-size: 0.7rem; color: #C8A882;"></i>
                            </a>

                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
                                <a class="dropdown-item-custom" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-grid-1x2-fill"></i> Dashboard Core
                                </a>

                                <a class="dropdown-item-custom" asp-controller="Admin" asp-action="ManageUsers">
                                    <i class="bi bi-people-fill"></i> Manage User Roles
                                </a>

                                <a class="dropdown-item-custom" asp-controller="Admin" asp-action="Transactions">
                                    <i class="bi bi-receipt-cutoff"></i> Transaction Ledger
                                </a>

                                <div class="dropdown-divider-custom"></div>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0 w-100">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item-logout w-100">
                                        <i class="bi bi-box-arrow-right"></i> Sign Out Platform
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </nav>
    </header>

    <div class="admin-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>