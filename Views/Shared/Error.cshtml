@model ErrorViewModel
@{
    ViewData["Title"] = "Oops! Something went wrong";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pet Friends</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%);
            font-family: 'DM Sans', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .error-container {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
            padding: 3.5rem 2.5rem;
            max-width: 550px;
            text-align: center;
            width: 90%;
            animation: fadeIn 0.5s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .error-icon {
            font-size: 4.5rem;
            color: #d9534f;
            margin-bottom: 1rem;
            display: inline-block;
            animation: float 3s ease-in-out infinite;
        }

        @@keyframes float {
            0%   { transform: translateY(0px); }
            50%  { transform: translateY(-8px); }
            100% { transform: translateY(0px); }
        }

        h1 {
            font-family: 'Playfair Display', serif;
            color: #5C3D1E;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }

        .text-muted-custom {
            color: #8C7560;
            font-size: 1.1rem;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .request-id-box {
            background: rgba(200, 168, 130, 0.15);
            border: 1px dashed rgba(200, 168, 130, 0.5);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 2rem;
            font-family: monospace;
            color: #5C3D1E;
            font-size: 0.95rem;
        }

        .btn-custom {
            background-color: #C8A882;
            color: white;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
            border: none;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-custom:hover {
            background-color: #b89770;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(200, 168, 130, 0.4);
            color: white;
        }

        .btn-outline-custom {
            background-color: transparent;
            color: #5C3D1E;
            border: 2px solid #C8A882;
        }

        .btn-outline-custom:hover {
            background-color: rgba(200, 168, 130, 0.1);
            color: #5C3D1E;
        }

        .dev-mode-warning {
            margin-top: 2.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(92, 61, 30, 0.1);
            font-size: 0.85rem;
            color: #8C7560;
            text-align: left;
        }
    </style>
</head>
<body>

    <div class="error-container">
        <i class="bi bi-exclamation-triangle-fill error-icon"></i>

        <h1>Oh no!</h1>
        <p class="text-muted-custom">
            It looks like our server is chasing its tail. We've encountered an unexpected error while processing your request.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="request-id-box">
                <strong>Request ID:</strong> @Model.RequestId
            </div>
        }

        <div class="d-flex justify-content-center gap-3">
            <a href="javascript:history.back()" class="btn-custom btn-outline-custom">
                <i class="bi bi-arrow-left"></i> Go Back
            </a>
            <a href="~/" class="btn-custom">
                <i class="bi bi-house-door-fill"></i> Home
            </a>
        </div>

        <div class="dev-mode-warning">
            <h6 class="fw-bold text-danger mb-2">
                <i class="bi bi-tools me-1"></i> Development Mode
            </h6>
            <p class="mb-1">
                Swapping to the <strong>Development</strong> environment will display more detailed information.
            </p>
            <p class="mb-0" style="opacity: 0.8;">
                <em>For local debugging, set the ASPNETCORE_ENVIRONMENT variable to 'Development' and restart the app.</em>
            </p>
        </div>
    </div>

</body>
</html>
