@using Microsoft.AspNetCore.Identity
@using Pets_friends.Models
@inject UserManager<UserAccount> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Merchant Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        body {
            display: flex;
            flex-direction: column;
            background-color: #FAFAFA;
            font-family: 'DM Sans', sans-serif;
            color: #5C3D1E;
        }

        .merchant-navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid #EBE0D5;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(92, 61, 30, 0.04);
        }

        .dropdown-menu-custom {
            border: 1px solid #EBE0D5;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(92, 61, 30, 0.08);
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
            margin-top: 12px !important;
            min-width: 200px;
            padding: 8px 0;
            animation: fadeIn 0.2s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .dropdown-item-custom {
            padding: 8px 20px;
            font-weight: 600;
            color: #5C3D1E;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.95rem;
            text-decoration: none;
        }

            .dropdown-item-custom:hover {
                background-color: #FAF6F1;
                color: #C8A882;
            }

            .dropdown-item-custom i {
                color: #8C7560;
                font-size: 1.1rem;
            }

            .dropdown-item-custom:hover i {
                color: #C8A882;
            }

        .dropdown-divider-custom {
            border-top: 1px solid #EBE0D5;
            margin: 8px 0;
        }

        .dropdown-item-logout {
            color: #d9534f;
            font-weight: 600;
            transition: all 0.2s ease;
            padding: 8px 20px;
            white-space: nowrap;
            font-size: 0.95rem;
            background: none;
            border: none;
            text-align: left;
        }

            .dropdown-item-logout:hover {
                background: #fff5f5;
                color: #c9302c;
            }

            .dropdown-item-logout i {
                color: #d9534f;
                font-size: 1.1rem;
            }

        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            margin-top: 65px;
        }
    </style>
</head>
<body>

    @{
        string firstName = "Merchant";
        string targetAvatar = "";

        if (User.Identity?.IsAuthenticated == true)
        {
            // Consumes controller parameters directly to bypass side DB connection deadlocks
            var merchantName = ViewData["MerchantName"] as string ?? "Merchant";
            firstName = merchantName.Split(' ')[0];

            var passedAvatar = ViewData["MerchantAvatar"] as string;
            if (!string.IsNullOrEmpty(passedAvatar))
            {
                targetAvatar = passedAvatar;
            }
            else
            {
                targetAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(firstName)}&background=FAF6F1&color=5C3D1E&bold=true";
            }
        }
    }

    <header>
        <nav class="navbar navbar-expand-sm merchant-navbar fixed-top">
            <div class="container py-1" style="max-width: 1300px;">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" style="color: #5C3D1E; font-family: 'Playfair Display';" asp-area="" asp-controller="Merchant" asp-action="Dashboard">
                    <i class="bi bi-shop-window" style="color: #C8A882; font-size: 1.2rem;"></i> Pet Friends Merchant
                </a>

                <div class="d-flex align-items-center gap-3 ms-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="d-flex align-items-center gap-2 text-decoration-none" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: #5C3D1E; font-weight: 600; font-size: 0.95rem;">
                                <img src="@targetAvatar" style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid #EBE0D5; object-fit: cover;" alt="Store Avatar">
                                @firstName <i class="bi bi-caret-down-fill" style="font-size: 0.7rem; color: #C8A882;"></i>
                            </a>

                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
                                <a class="dropdown-item-custom" asp-controller="Merchant" asp-action="Dashboard">
                                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                                </a>
                                <a class="dropdown-item-custom" asp-controller="Product" asp-action="Home">
                                    <i class="bi bi-tags-fill"></i> My Products
                                </a>
                                <a class="dropdown-item-custom" asp-controller="Order" asp-action="StoreOrders">
                                    <i class="bi bi-box-seam-fill"></i> Store Orders
                                </a>

                                <div class="dropdown-divider-custom"></div>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0 w-100">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item-logout d-flex align-items-center gap-2 w-100">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>