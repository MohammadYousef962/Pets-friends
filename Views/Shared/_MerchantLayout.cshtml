@using Microsoft.AspNetCore.Identity
@using Pets_friends.Models
@inject UserManager<UserAccount> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Merchant Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    @* --- Allows child views to inject their own CSS --- *@
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* 1. Kills the horizontal scrollbar and fits the screen perfectly */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        body {
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%);
            font-family: 'DM Sans', sans-serif;
        }

        /* 2. Premium Glass Navbar - Standardized Size */
        .merchant-navbar {
            background: rgba(250, 246, 241, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(237, 224, 208, 0.5);
            z-index: 1000;
        }

        /* Nav Link styling */
        .merchant-nav-link {
            color: #8C7560;
            font-weight: 600;
            transition: color 0.2s ease;
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 8px;
        }

            .merchant-nav-link:hover {
                color: #5C3D1E;
                background: rgba(200, 168, 130, 0.15);
            }

        /* 3. Pure CSS Hover Dropdown (No Click Required) */
        .user-dropdown {
            position: relative;
            padding-bottom: 10px; /* Invisible bridge */
            padding-top: 10px; /* Perfectly centers the text */
            display: flex;
            align-items: center;
        }

            .user-dropdown .dropdown-menu {
                display: none;
                position: absolute;
                top: 100%;
                right: 0;
                border: 1px solid rgba(237, 224, 208, 0.8);
                border-radius: 8px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.05);
                background: rgba(255, 255, 255, 0.98);
                backdrop-filter: blur(10px);
                margin-top: -10px;
                min-width: max-content;
                padding: 4px;
            }

            .user-dropdown:hover .dropdown-menu {
                display: block;
                animation: fadeIn 0.2s ease-in-out;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* 4. Styled Logout Item */
        .dropdown-item-logout {
            color: #d9534f;
            font-weight: 600;
            border-radius: 6px;
            transition: all 0.2s ease;
            padding: 0.35rem 0.8rem;
            white-space: nowrap;
        }

            .dropdown-item-logout:hover {
                background: #fff5f5;
                color: #c9302c;
                transform: translateX(3px);
            }

        /* 5. Content Spacing */
        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            margin-top: 65px; /* Keeps dashboard below the fixed navbar */
        }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-sm merchant-navbar fixed-top">
            <div class="container-fluid px-4 py-1">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" style="color: #5C3D1E; font-family: 'Playfair Display';" asp-area="" asp-controller="Merchant" asp-action="Dashboard">
                    <i class="bi bi-shop-window" style="color: #C8A882; font-size: 1.2rem;"></i> Pet Friends Merchant
                </a>

                <ul class="navbar-nav me-auto mb-2 mb-sm-0 ms-3">
                    <li class="nav-item">
                        <a class="merchant-nav-link d-flex align-items-center gap-1" asp-controller="Product" asp-action="Home">
                            <i class="bi bi-tags"></i> My Products
                        </a>
                    </li>
                    <li class="nav-item ms-2">
                        <a class="merchant-nav-link d-flex align-items-center gap-1" asp-controller="Order" asp-action="Home">
                            <i class="bi bi-box-seam"></i> Orders
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3 ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        var currentUser = await UserManager.GetUserAsync(User);

                        <div class="user-dropdown">
                            <a class="d-flex align-items-center gap-2 text-decoration-none" href="javascript:void(0)" style="color: #8C7560; font-weight: 600; font-size: 0.95rem; cursor: pointer;">
                                <i class="bi bi-person-circle" style="color: #C8A882; font-size: 1.2rem;"></i>
                                Hello, @(currentUser?.FullName ?? "Merchant") <i class="bi bi-caret-down-fill" style="font-size: 0.7rem; color: #C8A882;"></i>
                            </a>

                            <div class="dropdown-menu">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0 w-100">
                                    <button type="submit" class="dropdown-item dropdown-item-logout d-flex align-items-center gap-2 w-100">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* --- Allows child views to inject scripts/validation --- *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>