<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pet Friends</title>

    @* Include your fonts to match the Vet Profile *@
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    @* Include the specific signing CSS *@
    <link rel="stylesheet" href="~/css/Signing.css" asp-append-version="true" />
</head>
<body>
    @* Render the Login/Register form here without any Navbar or Footer *@
    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>