@using Microsoft.AspNetCore.Identity
@using Pets_friends.Models
@using Pets_friends.Data
@using Microsoft.EntityFrameworkCore
@inject UserManager<UserAccount> UserManager
@inject AppDbContext _context

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetFriends Market</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --text-dark: #2D1B0E;
            --text-muted: #8C7560;
            --brand-primary: #5C3D1E;
            --brand-accent: #C8A882;
            --bg-light: #FAF6F1;
            --bg-white: #FFFFFF;
            --border-light: #EBE0D5;
        }

        body {
            background-color: var(--bg-light);
            font-family: 'DM Sans', sans-serif;
            color: var(--text-dark);
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* =========================
                           NAVBAR
                        ========================== */

        .store-navbar {
            background: rgba(250, 246, 241, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #EBE0D5;
            padding: 18px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .store-brand {
            font-family: 'Nunito', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            color: #2D1B0E !important;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .store-brand i {
                color: #C8A882;
            }

        .search-container {
            flex-grow: 1;
            max-width: 500px;
            margin: 0 30px;
            position: relative;
        }

        .search-input {
            width: 100%;
            padding: 12px 20px 12px 45px;
            border-radius: 30px;
            border: 2px solid #EBE0D5;
            background: #FFFFFF;
            font-size: 0.95rem;
            transition: all 0.3s;
            outline: none;
        }

            .search-input:focus {
                border-color: #C8A882;
                box-shadow: 0 0 0 4px rgba(200, 168, 130, 0.1);
            }

        .search-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #8C7560;
            font-size: 1.1rem;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .nav-action-btn {
            color: #5C3D1E !important;
            text-decoration: none !important;
            font-weight: 600;
            display: flex;
            align-items: center;
            transition: color 0.2s;
            position: relative;
            font-size: 0.95rem;
        }

            .nav-action-btn:hover {
                color: #C8A882 !important;
            }

        /* =========================
                           SIGN IN BUTTON
                        ========================== */

        .btn-nav {
            background: #5C3D1E !important;
            color: white !important;
            padding: 10px 24px;
            border-radius: 30px;
            font-weight: 700;
            text-decoration: none !important;
            transition: all 0.3s;
            font-size: 0.95rem;
            display: inline-block;
            border: none;
            line-height: 1.2;
            font-family: 'DM Sans', sans-serif;
        }

            .btn-nav:hover {
                background: #C8A882 !important;
                color: white !important;
                transform: translateY(-2px);
            }

        /* =========================
                           CART BADGE
                        ========================== */

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background-color: #d9534f;
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 10px;
            border: 2px solid #fff;
            z-index: 2;
        }

        /* =========================
                           USER DROPDOWN
                        ========================== */

        .user-profile-btn {
            background: #FFFFFF;
            border: 1px solid var(--border-light);
            border-radius: 50px;
            padding: 4px 16px 4px 4px;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 2px 8px rgba(92, 61, 30, 0.05);
            outline: none;
        }

            .user-profile-btn:hover,
            .user-profile-btn:focus,
            .dropdown-toggle.show {
                background: #FAF6F1;
                border-color: var(--brand-accent);
                box-shadow: 0 4px 12px rgba(92, 61, 30, 0.1);
            }

            .user-profile-btn::after {
                display: none;
            }

        .nav-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            background: var(--border-light);
        }

        .nav-user-name {
            font-family: 'Nunito', sans-serif;
            font-weight: 700;
            color: var(--text-dark);
            font-size: 0.95rem;
        }

        .dropdown-chevron {
            color: var(--text-muted);
            font-size: 0.8rem;
            transition: transform 0.2s ease;
        }

        .dropdown-toggle.show .dropdown-chevron {
            transform: rotate(180deg);
            color: var(--brand-primary);
        }

        .dropdown-menu-custom {
            border-radius: 20px;
            border: 1px solid var(--border-light);
            box-shadow: 0 15px 35px rgba(92, 61, 30, 0.1);
            padding: 12px;
            margin-top: 15px !important;
            min-width: 220px;
            background: var(--bg-white);
            animation: dropFade 0.2s ease-out forwards;
            transform-origin: top right;
        }

        @@keyframes dropFade {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .dropdown-item-custom {
            border-radius: 12px;
            padding: 10px 16px;
            font-weight: 600;
            color: var(--text-dark);
            font-size: 0.95rem;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

            .dropdown-item-custom i {
                color: var(--brand-accent);
                font-size: 1.1rem;
                width: 24px;
            }

            .dropdown-item-custom:hover {
                background: #FDFaf5;
                color: var(--brand-primary);
                transform: translateX(4px);
            }

                .dropdown-item-custom:hover i {
                    color: var(--brand-primary);
                }

        .dropdown-divider-custom {
            border-color: #EBE0D5;
            margin: 8px 10px;
            opacity: 1;
        }

        .logout-text {
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
        }

            .logout-text:hover {
                background: #FEF2F2 !important;
                color: #DC2626 !important;
            }

                .logout-text:hover i {
                    color: #DC2626 !important;
                }

        main {
            flex: 1 0 auto;
        }
    </style>

    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }
</head>
<body>

    @{
        string dashController = "Home";
        string dashAction = "Main";
        string firstName = "Member";
        string avatarUrl = "";

        if (User.Identity?.IsAuthenticated == true)
        {
            var currentUser = await UserManager.GetUserAsync(User);
            var fullName = currentUser?.FullName ?? "Member";

            firstName = fullName.Split(' ')[0];

            // 1. Setup the default fallback avatar
            avatarUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(firstName)}&background=EBE0D5&color=5C3D1E&bold=true";

            // 2. Safely check the database for an actual uploaded profile picture
            if (currentUser != null)
            {
                var clientProfile = await _context.ClientProfiles.FirstOrDefaultAsync(c => c.UserAccountId == currentUser.Id);
                if (clientProfile != null && !string.IsNullOrWhiteSpace(clientProfile.ImageUrl))
                {
                    // Override with the real image from the server
                    avatarUrl = clientProfile.ImageUrl;
                }
            }

            if (User.IsInRole("Merchant"))
            {
                dashController = "Merchant";
                dashAction = "Dashboard";
            }
            else if (User.IsInRole("Vet"))
            {
                dashController = "Vet";
                dashAction = "Dashboard";
            }
            else if (User.IsInRole("Shelter"))
            {
                dashController = "Shelter";
                dashAction = "Dashboard";
            }
        }
    }

    <nav class="store-navbar">
        <div class="container d-flex align-items-center justify-content-between">

            <a asp-controller="Store" asp-action="Home" class="store-brand">
                <i class="bi bi-shop"></i>
                PetFriends Market
            </a>

            <form class="search-container d-none d-lg-block"
                  asp-controller="Store"
                  asp-action="Home"
                  method="get">

                <i class="bi bi-search search-icon"></i>

                <input type="text"
                       id="globalSearchInput"
                       autocomplete="off"
                       class="search-input"
                       placeholder="Search for food, toys, meds, and more...">
            </form>

            <div class="nav-actions">

                <a asp-controller="Store"
                   asp-action="Cart"
                   class="nav-action-btn"
                   title="View Shopping Cart">

                    <span class="position-relative d-inline-flex align-items-center">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span class="cart-badge" id="cartCountBadge">0</span>
                    </span>

                    <span class="d-none d-sm-inline ms-2">Cart</span>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">

                        <button class="user-profile-btn dropdown-toggle"
                                type="button"
                                id="userDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                data-bs-offset="0,15">

                            <img src="@avatarUrl"
                                 class="nav-avatar"
                                 alt="User">

                            <span class="d-none d-sm-inline nav-user-name">
                                @firstName
                            </span>

                            <i class="bi bi-chevron-down dropdown-chevron"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom"
                            aria-labelledby="userDropdown">

                            <li>
                                <a class="dropdown-item-custom"
                                   asp-controller="@dashController"
                                   asp-action="@dashAction">

                                    <i class="bi bi-person-badge"></i>
                                    Home
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item-custom"
                                   asp-controller="Order"
                                   asp-action="MyOrders">

                                    <i class="bi bi-box-seam"></i>
                                    My Orders
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider dropdown-divider-custom">
                            </li>

                            <li>
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="m-0 p-0 w-100">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item-custom logout-text w-100">

                                        <i class="bi bi-box-arrow-right"></i>
                                        Sign Out
                                    </button>
                                </form>
                            </li>

                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                       class="btn-nav">
                        Sign In
                    </a>
                }

            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            fetch('/Store/GetCartCount')
                .then(response => response.json())
                .then(data => {

                    const badge = document.getElementById('cartCountBadge');

                    if (badge)
                        badge.innerText = data;
                })
                .catch(error => console.log('Error fetching cart count:', error));
        });
    </script>

    @if (IsSectionDefined("Scripts"))
    {
        @RenderSection("Scripts", required: false)
    }

</body>
</html>