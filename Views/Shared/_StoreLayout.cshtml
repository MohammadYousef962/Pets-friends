<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetFriends Market</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        .store-navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #EBE0D5;
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(92, 61, 30, 0.05);
        }

        .store-brand {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 1.6rem;
            color: #5C3D1E;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .store-brand i {
                color: #C8A882;
            }

        .search-container {
            flex-grow: 1;
            max-width: 500px;
            margin: 0 30px;
            position: relative;
        }

        .search-input {
            width: 100%;
            padding: 12px 20px 12px 45px;
            border-radius: 30px;
            border: 2px solid #EBE0D5;
            background: #FAF6F1;
            font-size: 0.95rem;
            transition: all 0.3s;
            outline: none;
        }

            .search-input:focus {
                border-color: #C8A882;
                background: #fff;
                box-shadow: 0 0 0 4px rgba(200, 168, 130, 0.1);
            }

        .search-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #8C7560;
            font-size: 1.1rem;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .nav-action-btn {
            color: #5C3D1E;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            transition: color 0.2s;
            position: relative;
            font-size: 0.95rem;
            border: none;
            background: none;
            padding: 0;
        }

            .nav-action-btn:hover {
                color: #C8A882;
            }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background-color: #d9534f;
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 10px;
            border: 2px solid #fff;
            transition: transform 0.2s;
            z-index: 2;
        }

            .cart-badge.pop {
                transform: scale(1.3);
            }

        /* --- PREMIUM RIGHT-ALIGNED DROPDOWN (UPGRADED) --- */
        .user-profile-btn { 
            background: #FFFFFF; border: 1px solid #EBE0D5; border-radius: 50px; 
            padding: 5px 16px 5px 5px; display: flex; align-items: center; gap: 8px; 
            cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 2px 8px rgba(92, 61, 30, 0.05); 
            height: 44px; outline: none;
        }
        
        .user-profile-btn:hover, .user-profile-btn[aria-expanded="true"] { 
            background: #FDFaf5; border-color: #C8A882; box-shadow: 0 4px 15px rgba(92, 61, 30, 0.12); 
        }
        
        .user-profile-btn::after { display: none; } /* Hides Bootstrap Arrow */

        .nav-avatar { 
            width: 32px; height: 32px; border-radius: 50%; object-fit: cover; 
            background: #FAF6F1; border: 1px solid #EBE0D5; 
        }
        
        .nav-user-name { font-family: 'Nunito', sans-serif; font-weight: 700; color: #1A1A1A; font-size: 0.95rem; margin-right: 4px; }
        .dropdown-chevron { color: #8C7560; font-size: 0.8rem; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .user-profile-btn[aria-expanded="true"] .dropdown-chevron { transform: rotate(180deg); color: #5C3D1E; }

        /* THE FIX: Opacity-only animation prevents Popper.js alignment bugs */
        .dropdown-menu-custom { 
            border-radius: 20px; border: 1px solid #EBE0D5; box-shadow: 0 20px 40px rgba(92, 61, 30, 0.12); 
            padding: 10px; min-width: 240px; background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(20px);
            animation: dropFade 0.2s ease forwards;
        }
        
        @@keyframes dropFade { from { opacity: 0; } to { opacity: 1; } }

        .dropdown-item-custom { 
            border-radius: 12px; padding: 12px 16px; font-weight: 600; color: #1A1A1A; 
            font-size: 0.95rem; transition: all 0.2s ease; display: flex; align-items: center; gap: 12px; 
        }
        
        .dropdown-item-custom i { color: #C8A882; font-size: 1.2rem; transition: color 0.2s; }
        .dropdown-item-custom:hover { background: #FDFaf5; color: #5C3D1E; transform: translateX(4px); }
        .dropdown-item-custom:hover i { color: #5C3D1E; }
        .dropdown-divider-custom { border-top: 1px solid #EBE0D5; margin: 8px 10px; opacity: 0.5; }

        .logout-text { border: none; background: transparent; width: 100%; text-align: left; }
        .logout-text:hover { background: #FEF2F2 !important; color: #DC2626 !important; }
        .logout-text:hover i { color: #DC2626 !important; }
    </style>

    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }
</head>
<body>

    @using Microsoft.AspNetCore.Identity
    @using Pets_friends.Models
    @inject UserManager<UserAccount> UserManager
    @{
        // THE FIX: Set default routing for standard clients to Home/Main
        string dashController = "Home";
        string dashAction = "Main";
        string firstName = "Member";
        string avatarUrl = "";

        if (User.Identity?.IsAuthenticated == true)
        {
            var currentUser = await UserManager.GetUserAsync(User);
            var fullName = currentUser?.FullName ?? "Member";
            firstName = fullName.Split(' ')[0];
            avatarUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(firstName)}&background=FAF6F1&color=5C3D1E&bold=true";

            // If they are a staff member, override the default routing
            if (User.IsInRole("Merchant")) { dashController = "Merchant"; dashAction = "Dashboard"; }
            else if (User.IsInRole("Vet")) { dashController = "Vet"; dashAction = "Dashboard"; }
            else if (User.IsInRole("Shelter")) { dashController = "Shelter"; dashAction = "Dashboard"; }
        }
    }

    <nav class="store-navbar">
        <div class="container d-flex align-items-center justify-content-between">

            <a asp-controller="Store" asp-action="Home" class="store-brand">
                <i class="bi bi-shop"></i> PetFriends Market
            </a>

            <form class="search-container d-none d-lg-block" asp-controller="Store" asp-action="Home" method="get">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="globalSearchInput" autocomplete="off" class="search-input" placeholder="Search for food, toys, meds, and more...">
            </form>

            <div class="nav-actions">

                <a asp-controller="Store" asp-action="Cart" class="nav-action-btn" title="View Shopping Cart">
                    <span class="position-relative d-inline-flex align-items-center">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span class="cart-badge" id="cartCountBadge">0</span>
                    </span>
                    <span class="d-none d-sm-inline ms-2">Cart</span>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="user-profile-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" data-bs-offset="0,15">
                            <img src="@avatarUrl" class="nav-avatar" alt="User">
                            <span class="d-none d-sm-inline nav-user-name">@firstName</span>
                            <i class="bi bi-chevron-down dropdown-chevron"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom" aria-labelledby="userDropdown">
                            <li>
                                <a class="dropdown-item dropdown-item-custom" asp-controller="@dashController" asp-action="@dashAction">
                                    <i class="bi bi-person-badge"></i> Home
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dropdown-item-custom" asp-controller="Order" asp-action="MyOrders">
                                    <i class="bi bi-box-seam"></i> My Orders
                                </a>
                            </li>

                            <li><hr class="dropdown-divider dropdown-divider-custom"></li>

                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0 w-100">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item dropdown-item-custom logout-text w-100">
                                        <i class="bi bi-box-arrow-right"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="nav-action-btn">
                        <i class="bi bi-box-arrow-in-right fs-5"></i> <span class="d-none d-sm-inline ms-2">Login</span>
                    </a>
                }

            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            fetch('/Store/GetCartCount')
                .then(response => response.json())
                .then(data => {
                    const badge = document.getElementById('cartCountBadge');
                    if (badge) badge.innerText = data;
                })
                .catch(error => console.log('Error fetching cart count:', error));
        });
    </script>

    @if (IsSectionDefined("Scripts"))
    {
        @RenderSection("Scripts", required: false)
    }
</body>
</html>