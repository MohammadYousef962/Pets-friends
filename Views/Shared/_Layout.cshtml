@using Microsoft.AspNetCore.Identity
@using Pets_friends.Models
@inject UserManager<UserAccount> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pets Friends</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/topbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pets_friends.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>

    <header class="pf-topbar" id="pfTopbar">
        <div class="pf-topbar-inner">

            <a class="pf-brand" asp-controller="Home" asp-action="Index">
                <span class="pf-brand-icon">🐾</span>
                <span class="pf-brand-text">Pets Friends</span>
            </a>
         
            <div class="pf-topbar-right" style="margin-left: auto;">
                <div class="pf-auth">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var dashController = GetDashboardController();
                        <span class="pf-greeting">
                            <i class="bi bi-person-circle"></i>
                            <span class="pf-greeting-name">@User.Identity.Name</span>
                        </span>
                        <a class="pf-btn pf-btn-primary"
                               asp-controller="@dashController"
                               asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Dashboard</span>
                        </a>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="pf-btn pf-btn-ghost">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="pf-link" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="pf-btn pf-btn-primary" asp-controller="Account" asp-action="Register">
                            Get Started
                        </a>
                    }
                </div>

                <button class="pf-hamburger" id="pfHamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="pfMobileMenu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>

        <div class="pf-mobile-menu" id="pfMobileMenu" aria-hidden="true">
            <div class="pf-mobile-auth">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="pf-btn pf-btn-primary w-100"
                           asp-controller="@GetDashboardController()"
                           asp-action="Dashboard">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                    <form method="post" asp-controller="Account" asp-action="Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="pf-btn pf-btn-ghost w-100">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </button>
                    </form>
                }
                else
                {
                    <a class="pf-btn pf-btn-ghost w-100" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="pf-btn pf-btn-primary w-100" asp-controller="Account" asp-action="Register">Get Started</a>
                }
            </div>
        </div>
    </header>
    <main role="main">
        @RenderBody()
    </main>

    <footer class="pf-footer">
        <div class="pf-footer-inner">
            <div class="pf-footer-brand">
                <span>🐾</span>
                <span>Pets Friends</span>
            </div>
            <div class="pf-footer-links">
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </div>
            <p class="pf-footer-copy">&copy; @DateTime.Now.Year Pets Friends — All Rights Reserved</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            (function () {
                const hamburger  = document.getElementById('pfHamburger');
                const mobileMenu = document.getElementById('pfMobileMenu');
                const topbar     = document.getElementById('pfTopbar');

                hamburger.addEventListener('click', function () {
                    const open = mobileMenu.classList.toggle('open');
                    hamburger.classList.toggle('open', open);
                    hamburger.setAttribute('aria-expanded', open);
                    mobileMenu.setAttribute('aria-hidden', !open);
                });

                document.addEventListener('click', function (e) {
                    if (!topbar.contains(e.target)) {
                        mobileMenu.classList.remove('open');
                        hamburger.classList.remove('open');
                        hamburger.setAttribute('aria-expanded', false);
                    }
                });

                window.addEventListener('scroll', function () {
                    topbar.classList.toggle('scrolled', window.scrollY > 10);
                }, { passive: true });

                document.querySelectorAll('.pf-nav-dropdown').forEach(function (item) {
                    const trigger  = item.querySelector('.pf-dropdown-trigger');
                    const dropdown = item.querySelector('.pf-dropdown');

                    trigger.addEventListener('click', function (e) {
                        e.stopPropagation();
                        const open = item.classList.toggle('open');
                        trigger.setAttribute('aria-expanded', open);
                    });

                    document.addEventListener('click', function () {
                        item.classList.remove('open');
                        trigger.setAttribute('aria-expanded', false);
                    });
                });
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

@functions {
    private string GetDashboardController()
    {
        if (User?.Identity?.IsAuthenticated == true)
        {
            var roles = ViewContext.HttpContext.User.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value)
                .ToList();

            if (roles.Contains("Admin")) return "Admin";
            if (roles.Contains("Vet")) return "Vet";
            if (roles.Contains("Merchant")) return "Merchant";
            if (roles.Contains("Shelter")) return "Shelter";
        }
        return "Client";
    }
}