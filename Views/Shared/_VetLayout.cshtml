@using Microsoft.AspNetCore.Identity
@using Pets_friends.Models
@using Pets_friends.Data
@inject UserManager<UserAccount> UserManager
@inject AppDbContext DbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        body {
            display: flex;
            flex-direction: column;
            background-color: #F9FAFB;
            font-family: 'DM Sans', sans-serif;
            color: #1A1A1A;
        }

        .vet-navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid #E5E7EB;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            padding: 12px 0;
        }

        .dropdown-menu-custom {
            border: 1px solid #E5E7EB;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
            margin-top: 12px !important;
            min-width: 200px;
            padding: 8px 0;
            animation: fadeIn 0.2s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .dropdown-item-custom {
            padding: 10px 20px;
            font-weight: 600;
            color: #1A1A1A;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.9rem;
            text-decoration: none;
        }

            .dropdown-item-custom:hover {
                background-color: #F3F4F6;
                color: #5C3D1E;
            }

            .dropdown-item-custom i {
                color: #6B7280;
                font-size: 1.1rem;
            }

            .dropdown-item-custom:hover i {
                color: #5C3D1E;
            }

        .dropdown-divider-custom {
            border-top: 1px solid #E5E7EB;
            margin: 8px 0;
        }

        .dropdown-item-logout {
            color: #EF4444;
            font-weight: 600;
            transition: all 0.2s ease;
            padding: 10px 20px;
            white-space: nowrap;
            font-size: 0.9rem;
            background: none;
            border: none;
            text-align: left;
            width: 100%;
        }

            .dropdown-item-logout:hover {
                background: #FEF2F2;
                color: #DC2626;
            }

            .dropdown-item-logout i {
                color: #EF4444;
                font-size: 1.1rem;
            }

        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            margin-top: 65px;
        }
    </style>
</head>
<body>

    @{
        string firstName = "Doctor";
        string targetAvatar = "";

        if (User.Identity?.IsAuthenticated == true)
        {
            var currentUser = await UserManager.GetUserAsync(User);
            if (currentUser != null)
            {
                var fullName = currentUser.FullName ?? "Veterinarian";
                firstName = fullName.Split(' ')[0];

                // Directly query the VetProfiles table using the injected DbContext to get the actual uploaded ImageUrl
                var vetProfile = DbContext.VetProfiles.FirstOrDefault(v => v.UserAccountId == currentUser.Id);

                if (vetProfile != null && !string.IsNullOrEmpty(vetProfile.ImageUrl))
                {
                    targetAvatar = vetProfile.ImageUrl;
                }
                else
                {
                    // Clean, modern fallback avatar if they haven't uploaded a photo yet
                    targetAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(firstName)}&background=F3F4F6&color=5C3D1E&bold=true&font-family=Plus+Jakarta+Sans";
                }
            }
        }
    }

    <header>
        <nav class="navbar navbar-expand-sm vet-navbar fixed-top">
            <div class="container py-1" style="max-width: 1200px;">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" style="color: #5C3D1E; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 1.25rem;" asp-area="" asp-controller="Vet" asp-action="Dashboard">
                    <i class="bi bi-heart-pulse-fill"></i> Pet Friends Clinic
                </a>

                <div class="d-flex align-items-center gap-3 ms-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="d-flex align-items-center gap-2 text-decoration-none" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: #1A1A1A; font-weight: 600; font-size: 0.95rem;">
                                <img src="@targetAvatar" style="width: 36px; height: 36px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1); object-fit: cover;" alt="Clinic Avatar" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=V&background=F3F4F6&color=5C3D1E';">
                                @firstName <i class="bi bi-chevron-down" style="font-size: 0.7rem; color: #6B7280;"></i>
                            </a>

                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
                                <a class="dropdown-item-custom" asp-controller="Vet" asp-action="Dashboard">
                                    <i class="bi bi-grid-1x2"></i> Dashboard
                                </a>
                                <a class="dropdown-item-custom" asp-controller="Store" asp-action="Home">
                                    <i class="bi bi-shop"></i> Pet Store
                                </a>
                                <a class="dropdown-item-custom" asp-controller="Vet" asp-action="Profile">
                                    <i class="bi bi-person-vcard"></i> Public Profile
                                </a>
                                <a class="dropdown-item-custom" asp-controller="Vet" asp-action="Edit">
                                    <i class="bi bi-gear"></i> Clinic Settings
                                </a>

                                <div class="dropdown-divider-custom"></div>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0 w-100">
                                    <button type="submit" class="dropdown-item-logout d-flex align-items-center gap-2 w-100">
                                        <i class="bi bi-box-arrow-right"></i> Sign Out
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>