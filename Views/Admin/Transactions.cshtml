@model IEnumerable<Pets_friends.Data.ViewModels.TransactionRecordVM>

@{
    ViewData["Title"] = "Transaction History";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Uses the new full-screen layout!
}

<div class="admin-wrapper">
    <div class="container">

        <a asp-action="Dashboard" class="btn-back">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>

        <div class="glass-panel">
            <h2 style="font-family: 'Playfair Display', serif; color: #5C3D1E; font-weight: 700; margin-bottom: 5px;">
                <i class="bi bi-receipt-cutoff" style="color: #C8A882; margin-right: 10px;"></i>Transaction Ledger
            </h2>
            <p style="color: #8C7560; margin-bottom: 25px;">A chronological history of all payments and bookings on the platform.</p>

            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Customer</th>
                            <th>Details</th>
                            <th>Amount</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2" style="color: #EDE0D0;"></i>
                                    No transactions have occurred yet.
                                </td>
                            </tr>
                        }
                        @foreach (var record in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold" style="color: #5C3D1E;">@record.Timestamp.ToString("MMM dd, yyyy")</div>
                                    <div style="font-size: 0.8rem; color: #8C7560;">@record.Timestamp.ToString("hh:mm tt")</div>
                                </td>

                                <td class="fw-bold" style="color: #5C3D1E;">
                                    @record.CustomerName
                                </td>

                                <td>
                                    <div style="color: #C8A882; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">
                                        @record.Type
                                    </div>
                                    <div style="font-size: 0.95rem;">@record.Details</div>
                                </td>

                                <td>
                                    @if (record.Amount.HasValue)
                                    {
                                        <span style="font-weight: 700; color: #3a8a4f; font-size: 1.1rem;">
                                            $@record.Amount.Value.ToString("0.00")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td class="text-end">
                                    @{
                                        // Dynamically style the status badge based on the word
                                        var badgeBg = "#f5f1eb";
                                        var badgeColor = "#8C7560";

                                        if (record.Status.ToLower() == "completed" || record.Status.ToLower() == "confirmed")
                                        {
                                            badgeBg = "#e4f0e8";
                                            badgeColor = "#3a8a4f";
                                        }
                                        else if (record.Status.ToLower() == "pending")
                                        {
                                            badgeBg = "#fff3cd";
                                            badgeColor = "#856404";
                                        }
                                        else if (record.Status.ToLower() == "cancelled" || record.Status.ToLower() == "failed")
                                        {
                                            badgeBg = "#f8d7da";
                                            badgeColor = "#721c24";
                                        }
                                    }
                                    <span class="badge rounded-pill shadow-sm"
                                          style="background-color: @badgeBg; color: @badgeColor; padding: 8px 14px; font-weight: 600; border: 1px solid rgba(0,0,0,0.05);">
                                        @record.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>