@model Pets_friends.Data.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Admin Control Center";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        /* Implements smooth font smoothing across the page */
        .admin-dashboard-container {
            font-family: 'DM Sans', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Heading elements for ultra-soft, premium font structures */
        .premium-title {
            font-family: 'Playfair Display', serif;
            color: #4A3320; /* Slightly deeper for better contrast */
            font-weight: 800;
            font-size: 2.6rem;
            letter-spacing: -0.5px;
            margin-bottom: 8px;
        }

        .premium-subtitle {
            font-family: 'DM Sans', sans-serif;
            color: #8C7560;
            font-size: 1.1rem;
            font-weight: 400;
            line-height: 1.6;
        }

        /* Organic, bouncy, ultra-curved squircle card structures */
        .dashboard-stat-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border-radius: 40px; /* Enhanced ultra-rounded soft squircles */
            padding: 40px 25px;
            text-align: center;
            box-shadow: 0 20px 45px rgba(91, 62, 43, 0.04), 0 4px 12px rgba(91, 62, 43, 0.02);
            border: 1px solid rgba(237, 224, 208, 0.6);
            transition: all 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            .dashboard-stat-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 30px 60px rgba(91, 62, 43, 0.1);
                border-color: #C8A882;
                background: #FFFFFF;
            }

        /* Smooth rounded squircle icon backgrounds */
        .dashboard-icon-wrapper {
            font-size: 1.8rem;
            width: 70px;
            height: 70px;
            border-radius: 26px; /* Smooth squircle corners */
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 22px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
        }

        .dashboard-stat-card:hover .dashboard-icon-wrapper {
            transform: scale(1.12) rotate(-8deg);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.04);
        }

        /* Clean, normal, upright sans-serif numbers */
        .dashboard-stat-number {
            font-family: 'DM Sans', sans-serif;
            font-size: 2.8rem;
            font-weight: 700;
            font-style: normal;
            color: #5C3D1E;
            line-height: 1;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }

        .dashboard-stat-label {
            font-family: 'DM Sans', sans-serif;
            color: #8C7560;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1.5px;
        }

        /* Elegant platform tax banner layout card with organic dashed border */
        .premium-tax-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 237, 225, 0.95) 100%);
            border-radius: 44px; /* Highly curved outer boundary */
            border: 2px dashed #C8A882;
            padding: 45px;
            box-shadow: 0 20px 50px rgba(91, 62, 43, 0.05);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

            .premium-tax-card::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(200, 168, 130, 0.05) 0%, transparent 60%);
                z-index: 0;
            }

            .premium-tax-card:hover {
                box-shadow: 0 28px 60px rgba(91, 62, 43, 0.1);
                border-color: #C8A882;
                transform: translateY(-4px);
            }

        .tax-content-wrapper {
            position: relative;
            z-index: 1;
        }

        .tax-indicator-title {
            font-family: 'DM Sans', sans-serif;
            color: #8C7560;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        /* Clean, normal, upright tax display */
        .tax-amount-display {
            font-family: 'DM Sans', sans-serif;
            font-size: 3.5rem;
            font-weight: 800;
            font-style: normal;
            color: #5C3D1E;
            line-height: 1.1;
        }

        .badge-soft-info {
            background-color: rgba(200, 168, 130, 0.12);
            color: #5C3D1E;
            border-radius: 99px; /* Complete pill-shape boundary */
            font-size: 0.9rem;
            padding: 10px 22px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            border: 1px solid rgba(200, 168, 130, 0.15);
        }

        /* Circular layout decorative icon illustration */
        .tax-card-illustration {
            width: 110px;
            height: 110px;
            background: #FFFFFF;
            border-radius: 50%; /* Completely round circle */
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 15px 35px rgba(91, 62, 43, 0.03);
            border: 1px solid #EDE0D0;
            color: #C8A882;
            font-size: 3.2rem;
            transition: all 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            z-index: 1;
        }

        .premium-tax-card:hover .tax-card-illustration {
            transform: rotate(15deg) scale(1.08);
            color: #5C3D1E;
            border-color: #C8A882;
            box-shadow: 0 20px 40px rgba(91, 62, 43, 0.08);
        }
    </style>
}

<div class="glass-panel admin-dashboard-container">

    <div class="row align-items-center mb-5 pb-2">
        <div class="col-md-8 text-start">
            <h1 class="premium-title">Master Control Center</h1>
            <p class="premium-subtitle mb-0">Monitor active user volumes, verify system-wide purchases, and track ecosystem appointments.</p>
        </div>
        <div class="col-md-4 text-md-end text-start mt-4 mt-md-0">
            <span class="badge-soft-info py-2 px-4 shadow-sm">
                <i class="bi bi-shield-check-fill me-2" style="color: #C8A882; font-size: 1.2rem;"></i> System Live
            </span>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-stat-card">
                <!-- Harmonized Earthy Blue -->
                <div class="dashboard-icon-wrapper" style="background: rgba(92, 107, 192, 0.1); color: #5C6BC0;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="dashboard-stat-number">@Model.TotalUsers</div>
                <div class="dashboard-stat-label">Total Users</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-stat-card">
                <!-- Harmonized Earthy Rose -->
                <div class="dashboard-icon-wrapper" style="background: rgba(190, 24, 93, 0.08); color: #BE185D;">
                    <i class="bi bi-calendar2-heart-fill"></i>
                </div>
                <div class="dashboard-stat-number">@Model.TotalAppointments</div>
                <div class="dashboard-stat-label">Active Appointments</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-stat-card">
                <!-- Harmonized Warm Gold -->
                <div class="dashboard-icon-wrapper" style="background: rgba(217, 119, 6, 0.1); color: #D97706;">
                    <i class="bi bi-box2-heart-fill"></i>
                </div>
                <div class="dashboard-stat-number">@Model.TotalOrders</div>
                <div class="dashboard-stat-label">Active Orders</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-stat-card">
                <!-- Harmonized Soft Green -->
                <div class="dashboard-icon-wrapper" style="background: rgba(16, 185, 129, 0.1); color: #10B981;">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div class="dashboard-stat-number">@Model.TotalRevenue.ToString("C")</div>
                <div class="dashboard-stat-label">Gross Purchases</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="premium-tax-card d-flex flex-column flex-md-row justify-content-between align-items-md-center align-items-start gap-4">
                <div class="text-start tax-content-wrapper">
                    <span class="tax-indicator-title">Purchase Tax Revenue (8%)</span>
                    <div class="tax-amount-display mt-2 mb-3">@Model.TotalTax.ToString("C")</div>
                    <div class="badge-soft-info">
                        <i class="bi bi-info-circle-fill me-2" style="color: #C8A882; font-size: 1.1rem;"></i>
                        Calculated exclusively from completed client store purchases. Service appointments are zero-fee.
                    </div>
                </div>
                <div class="tax-card-illustration d-none d-md-flex flex-shrink-0">
                    <i class="bi bi-bank2"></i>
                </div>
            </div>
        </div>
    </div>

</div>