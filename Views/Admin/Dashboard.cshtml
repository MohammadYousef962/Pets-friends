@model Pets_friends.Data.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Admin Control Center";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --text-dark: #5C3D1E;
            --text-muted: #8C7560;
            --bg-card: #FAF6F1;
            --border-light: #EBE0D5;
            --tan-accent: #C8A882;
            --brown-button: #5C3D1E;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            color: var(--text-dark);
            background-color: #fdfcfb;
        }

        .admin-header {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 2.4rem;
            color: var(--text-dark);
            margin-bottom: 0.2rem;
        }

        .admin-subtitle {
            color: var(--text-muted);
            font-size: 1rem;
            margin-bottom: 2rem;
        }

        /* Stat Cards */
        .stat-card {
            background-color: #fff;
            border-radius: 20px;
            padding: 30px 20px;
            border: 1px solid var(--border-light);
            box-shadow: 0 4px 12px rgba(92, 61, 30, 0.03);
            text-align: center;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            height: 100%;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 28px rgba(92, 61, 30, 0.08);
            }

        .stat-icon {
            font-size: 2.2rem;
            margin-bottom: 15px;
            display: inline-block;
        }

        .stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 2.4rem;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1;
            margin-bottom: 8px;
        }

        .stat-label {
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Action Cards */
        .action-card {
            background-color: #fff;
            padding: 30px;
            border-radius: 20px;
            border: 1px solid var(--border-light);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease;
        }

            .action-card:hover {
                box-shadow: 0 8px 24px rgba(92, 61, 30, 0.06);
            }

        .btn-custom-outline {
            background-color: var(--border-light);
            color: var(--text-dark);
            font-weight: 600;
            border-radius: 12px;
            padding: 12px 24px;
            text-decoration: none;
            transition: 0.2s;
        }

            .btn-custom-outline:hover {
                background-color: var(--tan-accent);
                color: #fff;
            }

        .btn-custom-solid {
            background-color: var(--brown-button);
            color: #fff;
            font-weight: 600;
            border-radius: 12px;
            padding: 12px 24px;
            text-decoration: none;
            transition: 0.2s;
        }

            .btn-custom-solid:hover {
                background-color: #4A3118;
                color: #fff;
            }
    </style>
}

<div class="container py-5" style="max-width: 1200px;">

    <div class="mb-5">
        <h1 class="admin-header">Master Admin Portal</h1>
        <p class="admin-subtitle">Monitor platform activity, manage user roles, and oversee all operations.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 mb-4" style="background: #E4F0E8; color: #2D6A3F; border: 1px solid #C3E6CB; padding: 15px 20px;">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-people-fill stat-icon" style="color: var(--tan-accent);"></i>
                <div class="stat-number">@Model.TotalUsers</div>
                <div class="stat-label">Total Users</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-calendar-check-fill stat-icon" style="color: #6C8EBF;"></i>
                <div class="stat-number">@Model.TotalAppointments</div>
                <div class="stat-label">Appointments</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-box-seam-fill stat-icon" style="color: #E8A838;"></i>
                <div class="stat-number">@Model.TotalOrders</div>
                <div class="stat-label">Product Orders</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-currency-dollar stat-icon" style="color: #5D8A66;"></i>
                <div class="stat-number">@Model.TotalRevenue.ToString("C")</div>
                <div class="stat-label">Total Revenue</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="action-card">
                <div>
                    <h3 style="font-family: 'Playfair Display'; color: #5C3D1E; font-weight: 700; margin: 0 0 5px 0; font-size: 1.3rem;">Manage Users</h3>
                    <p style="color: #8C7560; margin: 0; font-size: 0.95rem;">View, edit roles, or delete user accounts.</p>
                </div>
                <a asp-controller="Admin" asp-action="ManageUsers" class="btn-custom-outline">
                    User Directory <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="action-card">
                <div>
                    <h3 style="font-family: 'Playfair Display'; color: #5C3D1E; font-weight: 700; margin: 0 0 5px 0; font-size: 1.3rem;">Financials & History</h3>
                    <p style="color: #8C7560; margin: 0; font-size: 0.95rem;">View all store orders and service payments.</p>
                </div>
                <a asp-controller="Admin" asp-action="Transactions" class="btn-custom-solid">
                    View Ledger <i class="bi bi-receipt-cutoff ms-2"></i>
                </a>
            </div>
        </div>
    </div>

</div>