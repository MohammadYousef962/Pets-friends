@model Pets_friends.Data.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Admin Control Center";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        /* Implements smooth font smoothing across the page */
        .admin-dashboard-container {
            font-family: 'DM Sans', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Heading elements for ultra-soft, premium font structures */
        .premium-title {
            font-family: 'Playfair Display', serif;
            color: #5C3D1E;
            font-weight: 700;
            font-size: 2.4rem;
            letter-spacing: -0.5px;
        }

        .premium-subtitle {
            font-family: 'DM Sans', sans-serif;
            color: #8C7560;
            font-size: 1.05rem;
            font-weight: 400;
            margin-bottom: 35px;
        }

        /* Organic, bouncy, heavily curved stat card structures */
        .dashboard-stat-card {
            background: rgba(255, 255, 255, 0.85);
            border-radius: 32px; /* Very soft, organic corners */
            padding: 35px 25px;
            text-align: center;
            box-shadow: 0 15px 40px rgba(91, 62, 43, 0.04);
            border: 1px solid #EDE0D0;
            transition: all 0.40s cubic-bezier(0.165, 0.84, 0.44, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .dashboard-stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 50px rgba(91, 62, 43, 0.12);
            border-color: #C8A882;
            background: rgba(255, 255, 255, 1);
        }

        /* Round squircle icon backgrounds */
        .dashboard-icon-wrapper {
            font-size: 1.7rem;
            width: 64px;
            height: 64px;
            border-radius: 22px; 
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
            transition: transform 0.35s ease;
        }

        .dashboard-stat-card:hover .dashboard-icon-wrapper {
            transform: scale(1.1) rotate(-6deg);
        }

        /* Large numbers styled gracefully */
        .dashboard-stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            font-weight: 700;
            color: #5C3D1E;
            line-height: 1.1;
            margin-bottom: 6px;
        }

        .dashboard-stat-label {
            font-family: 'DM Sans', sans-serif;
            color: #8C7560;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1.2px;
        }

        /* Premium platform tax banner layout card */
        .premium-tax-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 237, 225, 0.9) 100%);
            border-radius: 36px;
            border: 2px dashed #C8A882;
            padding: 40px;
            box-shadow: 0 15px 45px rgba(91, 62, 43, 0.05);
            transition: all 0.35s ease;
        }

        .premium-tax-card:hover {
            box-shadow: 0 20px 50px rgba(91, 62, 43, 0.12);
            transform: translateY(-3px);
        }

        .tax-indicator-title {
            font-family: 'DM Sans', sans-serif;
            color: #8C7560;
            font-weight: 700;
            font-size: 0.85rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .tax-amount-display {
            font-family: 'Playfair Display', serif;
            font-size: 3.2rem;
            font-weight: 700;
            color: #5C3D1E;
            line-height: 1;
        }

        .badge-soft-info {
            background-color: rgba(200, 168, 130, 0.15);
            color: #5C3D1E;
            border-radius: 12px;
            font-size: 0.9rem;
            padding: 10px 18px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
        }

        /* Circular layout decorative icon illustration */
        .tax-card-illustration {
            width: 100px;
            height: 100px;
            background: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 15px 35px rgba(91, 62, 43, 0.04);
            border: 1px solid #EDE0D0;
            color: #C8A882;
            font-size: 3rem;
            transition: all 0.35s ease;
        }

        .premium-tax-card:hover .tax-card-illustration {
            transform: rotate(10deg) scale(1.05);
            color: #7b4f2c;
            border-color: #C8A882;
        }
    </style>
}

<div class="glass-panel admin-dashboard-container">
    
    <div class="row align-items-center mb-5">
        <div class="col-md-8 text-start">
            <h1 class="premium-title">Master Control Center</h1>
            <p class="premium-subtitle mb-0">Monitor active user volumes, verify system-wide purchases, and track service appointments.</p>
        </div>
        <div class="col-md-4 text-md-end text-start mt-3 mt-md-0">
            <span class="badge-soft-info py-2 px-3">
                <i class="bi bi-shield-check-fill me-2" style="color: #7b4f2c;"></i> System Dashboard Active
            </span>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-stat-card">
                <div class="dashboard-icon-wrapper" style="background: rgba(92, 107, 192, 0.08); color: #5C6BC0;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="dashboard-stat-number">@Model.TotalUsers</div>
                <div class="dashboard-stat-label">Total Users</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-stat-card">
                <div class="dashboard-icon-wrapper" style="background: rgba(2, 132, 199, 0.08); color: #0284C7;">
                    <i class="bi bi-calendar2-heart-fill"></i>
                </div>
                <div class="dashboard-stat-number">@Model.TotalAppointments</div>
                <div class="dashboard-stat-label">Active Appointments</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-stat-card">
                <div class="dashboard-icon-wrapper" style="background: rgba(217, 119, 6, 0.08); color: #D97706;">
                    <i class="bi bi-box2-heart-fill"></i>
                </div>
                <div class="dashboard-stat-number">@Model.TotalOrders</div>
                <div class="dashboard-stat-label">Active Orders</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-stat-card">
                <div class="dashboard-icon-wrapper" style="background: rgba(5, 150, 105, 0.08); color: #059669;">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div class="dashboard-stat-number">@Model.TotalRevenue.ToString("C")</div>
                <div class="dashboard-stat-label">Gross Purchases</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="premium-tax-card p-4 p-md-5 d-flex flex-column flex-md-row justify-content-between align-items-md-center align-items-start gap-4">
                <div class="text-start">
                    <span class="tax-indicator-title">Purchase Tax Revenue (8%)</span>
                    <div class="tax-amount-display mt-2 mb-3">@Model.TotalTax.ToString("C")</div>
                    <div class="badge-soft-info">
                        <i class="bi bi-info-circle-fill me-2" style="color: #7b4f2c;"></i> Calculated exclusively from completed client purchases. Appointments are provided free of charge.
                    </div>
                </div>
                <div class="tax-card-illustration d-none d-md-flex">
                    <i class="bi bi-bank2"></i>
                </div>
            </div>
        </div>
    </div>

</div>