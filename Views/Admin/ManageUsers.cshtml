@model IEnumerable<Pets_friends.Data.ViewModels.ManageUserVM>

@{
    ViewData["Title"] = "Manage Accounts";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
    <style>
        .btn-delete {
            background-color: #fff8f8;
            color: #d9534f;
            border: 1px solid #f5c6cb;
            border-radius: 10px;
            padding: 8px 12px;
            transition: 0.2s;
        }

            .btn-delete:hover {
                background-color: #d9534f;
                color: white;
            }

        
    </style>
}


<div class="admin-wrapper">
    <div class="container">

                <a asp-action="Dashboard" class="btn-back">
                    <i class="bi bi-arrow-left"> </i> Back to Dashboard
                </a>

                <div class="glass-panel">

        <div class="glass-panel">
            <h2 style="font-family: 'Playfair Display', serif; color: #5C3D1E; font-weight: 700; margin-bottom: 5px;">
                <i class="bi bi-shield-lock-fill" style="color: #C8A882; margin-right: 10px;"></i>Account Management
            </h2>
            <p style="color: #8C7560; margin-bottom: 25px;">Assign system roles or remove bad actors.</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 12px; margin-bottom: 20px;">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 12px; margin-bottom: 20px;">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>User Details</th>
                            <th>Email Address</th>
                            <th>Role</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-bold">@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="role-badge @(user.CurrentRole == "Admin" ? "admin-badge" : "")">
                                        @user.CurrentRole
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (user.CurrentRole == "Admin")
                                    {
                                        <span style="color: #A0805A; font-style: italic; font-size: 0.9rem;">Master Account</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-end gap-2 align-items-center">
                                            <form asp-action="ChangeRole" method="post" class="d-flex gap-2 m-0">
                                                <input type="hidden" name="userId" value="@user.UserId" />
                                                <select name="newRole" class="custom-select">
                                                    <option value="Client" selected="@(user.CurrentRole == "Client")">Client</option>
                                                    <option value="Vet" selected="@(user.CurrentRole == "Vet")">Vet</option>
                                                    <option value="Merchant" selected="@(user.CurrentRole == "Merchant")">Merchant</option>
                                                    <option value="Shelter" selected="@(user.CurrentRole == "Shelter")">Shelter</option>
                                                </select>
                                                <button type="submit" class="btn-update">Update</button>
                                            </form>

                                            <form asp-action="DeleteUser" method="post" class="m-0 delete-form" data-name="@user.FullName">
                                                <input type="hidden" name="userId" value="@user.UserId" />
                                                <button type="button" class="btn-delete" title="Delete User">
                                                    <i class="bi bi-trash3-fill"></i> Remove
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<div id="customDeleteModal" class="custom-modal-overlay">
    <div class="custom-modal">
        <i class="bi bi-exclamation-octagon custom-modal-icon"></i>
        <h3 class="custom-modal-title">Delete Account</h3>
        <p class="custom-modal-text" id="customDeleteText">
            Are you sure you want to permanently delete this? This cannot be undone.
        </p>
        <div class="custom-modal-actions">
            <button type="button" class="btn-modal-cancel" id="btnCancelDelete">Cancel</button>
            <button type="button" class="btn-modal-confirm" id="btnConfirmDelete">Yes, Delete</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('customDeleteModal');
        const modalText = document.getElementById('customDeleteText');
        const btnCancel = document.getElementById('btnCancelDelete');
        const btnConfirm = document.getElementById('btnConfirmDelete');

        let formToSubmit = null; // Memory slot for the form we want to submit

        // 1. Listen for clicks on ALL our custom delete buttons
        document.querySelectorAll('.delete-form .btn-delete').forEach(button => {
            button.addEventListener('click', function () {
                // Find the form this button belongs to
                formToSubmit = this.closest('.delete-form');

                // Get the name from the data-name attribute we added
                const name = formToSubmit.getAttribute('data-name');

                // Update the text dynamically!
                modalText.innerHTML = `Are you sure you want to permanently delete <strong>${name}</strong>? This action cannot be undone.`;

                // Show the modal
                modal.classList.add('active');
            });
        });

        // 2. If they click Cancel, hide the modal and clear the memory
        btnCancel.addEventListener('click', function () {
            modal.classList.remove('active');
            formToSubmit = null;
        });

        // 3. If they click Confirm, submit the form behind the scenes!
        btnConfirm.addEventListener('click', function () {
            if (formToSubmit) {
                formToSubmit.submit();
            }
        });
    });
</script>