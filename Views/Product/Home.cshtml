@model IEnumerable<Pets_friends.Models.Product>

@{
    ViewData["Title"] = "My Inventory";
    Layout = "~/Views/Shared/_MerchantLayout.cshtml";

    // DYNAMIC CATEGORIES: Extracts only the categories this merchant actually has in stock!
    var activeCategories = Model.Select(m => m.Category)
                                .Where(c => !string.IsNullOrEmpty(c))
                                .Distinct()
                                .OrderBy(c => c)
                                .ToList();
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%) !important;
            background-attachment: fixed !important;
            font-family: 'DM Sans', sans-serif;
        }

        .inventory-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 30px;
        }

        .inventory-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 700;
            color: #5C3D1E;
            margin: 0 0 5px 0;
        }

        /* --- SMART FILTER BAR --- */
        .filter-bar {
            display: flex;
            gap: 12px;
            margin-bottom: 40px;
            flex-wrap: wrap;
            background: rgba(255, 255, 255, 0.4);
            padding: 15px 20px;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 4px 15px rgba(92, 61, 30, 0.05);
        }

        .filter-btn {
            background-color: rgba(255, 255, 255, 0.7);
            color: #5C3D1E;
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 30px;
            padding: 10px 24px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }

            .filter-btn:hover {
                background-color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(92, 61, 30, 0.08);
            }

            .filter-btn.active {
                background-color: #5C3D1E;
                color: #fff;
                border-color: #5C3D1E;
                box-shadow: 0 5px 15px rgba(92, 61, 30, 0.2);
            }

        /* --- PRODUCT CARDS (GLASSMORPHISM) --- */
        .product-card {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 10px 30px rgba(92, 61, 30, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .product-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 40px rgba(200, 168, 130, 0.2);
                border-color: #C8A882;
                background: rgba(255, 255, 255, 0.8);
            }

        .product-img-wrapper {
            height: 220px;
            width: 100%;
            overflow: hidden;
            position: relative;
            background-color: #fff;
            border-bottom: 1px solid rgba(235, 224, 213, 0.5);
        }

            .product-img-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

        .product-card:hover .product-img-wrapper img {
            transform: scale(1.05);
        }

        .category-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(5px);
            color: #5C3D1E;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            z-index: 2;
        }

        .stock-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 6px 12px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 700;
            z-index: 2;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .stock-ok {
            background-color: rgba(212, 237, 218, 0.95);
            color: #155724;
            backdrop-filter: blur(5px);
        }

        .stock-low {
            background-color: rgba(248, 215, 218, 0.95);
            color: #721C24;
            backdrop-filter: blur(5px);
        }

        .product-info {
            padding: 25px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .product-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: #2D1B0E;
            margin-bottom: 10px;
            line-height: 1.3;
        }

        .product-price {
            font-size: 1.4rem;
            font-weight: 700;
            color: #8C7560;
            margin-bottom: 20px;
        }

        /* --- BUTTONS --- */
        .btn-brand {
            background-color: #5C3D1E;
            color: #fff;
            border-radius: 14px;
            padding: 12px 28px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
        }

            .btn-brand:hover {
                background-color: #C8A882;
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(200, 168, 130, 0.4);
            }

        .btn-edit {
            background-color: #fff;
            color: #5C3D1E;
            border: 2px solid #EBE0D5;
            border-radius: 12px;
            padding: 10px;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .btn-edit:hover {
                background-color: #5C3D1E;
                color: #fff;
                border-color: #5C3D1E;
            }

        .empty-state-card {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 10px 30px rgba(92, 61, 30, 0.05);
            padding: 60px 20px;
            text-align: center;
        }

        .stock-ok {
            background-color: rgba(212, 237, 218, 0.95);
            color: #155724;
            backdrop-filter: blur(5px);
        }

        .stock-low {
            background-color: rgba(248, 215, 218, 0.95);
            color: #721C24;
            backdrop-filter: blur(5px);
        }
        /* NEW: Completely empty stock badge */
        .stock-out {
            background-color: rgba(108, 117, 125, 0.95);
            color: #fff;
            backdrop-filter: blur(5px);
        }
    </style>
}

<div class="container py-5" style="max-width: 1300px;">
    <!-- HEADER -->
    <div class="inventory-header flex-column flex-md-row gap-3">
        <div>
            <h1 class="inventory-title">My Products</h1>
            <p style="color: #8C7560; margin: 0; font-size: 1.05rem;">Manage your store's inventory, pricing, and stock levels.</p>
        </div>
        <a asp-action="Create" class="btn-brand"><i class="bi bi-plus-lg me-2"></i> Add New Product</a>
    </div>

    @if (!Model.Any())
    {
        <!-- EMPTY STATE (Shows if Database has 0 products for this Merchant) -->
        <div class="empty-state-card">
            <i class="bi bi-box-seam" style="font-size: 4rem; color: #C8A882;"></i>
            <h4 class="mt-4" style="font-family: 'Playfair Display', serif; font-weight: 700; color: #5C3D1E; font-size: 1.8rem;">Your inventory is empty</h4>
            <p class="text-muted mb-4" style="font-size: 1.1rem;">You haven't added any products to your store yet.</p>
            <a asp-action="Create" class="btn-brand">Add Your First Product</a>
        </div>
    }
    else
    {
        <!-- SMART FILTER BAR (Dynamically generated from Database categories) -->
        <div class="filter-bar">
            <button class="filter-btn active" data-filter="all">All Products</button>
            @foreach (var category in activeCategories)
            {
                <button class="filter-btn" data-filter="@category">@category</button>
            }
        </div>

        <!-- PRODUCT GRID (Populated from Database) -->
        <div class="row g-4" id="inventoryGrid">
            @foreach (var item in Model)
            {
                // Determine stock text and badge class cleanly
                string stockClass = "stock-ok";
                string stockText = $"{item.StockQuantity} in stock";

                if (item.StockQuantity == 0)
                {
                    stockClass = "stock-out";
                    stockText = "Out of stock";
                }
                else if (item.StockQuantity <= 5)
                {
                    stockClass = "stock-low";
                    stockText = $"Low: {item.StockQuantity} left";
                }

                <div class="col-sm-6 col-md-4 col-lg-3 product-item" data-category="@item.Category">
                    <div class="product-card">
                        <div class="product-img-wrapper">
                            <span class="category-badge">@item.Category</span>

                            <span class="stock-badge @stockClass">
                                @stockText
                            </span>

                            <img src="@item.ImageUrl" onerror="this.src='https://placehold.co/300x300/FAF6F1/8C7560?text=No+Image'" alt="@item.Name" />
                        </div>

                        <div class="product-info">
                            <div class="product-title">@item.Name</div>

                            <div class="product-price">
                                @if (item.Price == 0)
                                {
                                    <span style="color: #2e7d32; font-weight: 800;">FREE</span>
                                }
                                else
                                {
                                    @item.Price.ToString("C")
                                }
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit flex-grow-1"><i class="bi bi-pencil me-1"></i> Edit</a>

                                <button type="button" class="btn-edit text-danger" style="background: #FFF5F5; border-color: #F5C6CB;" title="Delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteProductModal"
                                        data-product-id="@item.Id"
                                        data-product-name="@item.Name">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            </div>
                        </div>
                    </div>
            }
        </div>
    }
</div>
<div class="modal fade" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 24px; border: none; overflow: hidden; box-shadow: 0 15px 35px rgba(92, 61, 30, 0.15);">

            <div class="modal-header" style="background-color: #d9534f; color: white; border-bottom: none; padding: 25px 30px;">
                <h4 class="modal-title" id="deleteProductModalLabel" style="font-family: 'Playfair Display', serif; font-weight: 700;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Product
                </h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" style="padding: 35px 30px; color: #5C3D1E;">
                <h5 style="font-weight: 700; color: #5C3D1E; margin-bottom: 15px;">Are you absolutely sure?</h5>
                <p class="text-muted" style="font-size: 0.95rem; line-height: 1.6; margin-bottom: 0;">
                    You are about to permanently remove <strong id="modalProductName" style="color: #d9534f;">this product</strong> from your inventory. This action cannot be undone, and all associated customer reviews will be permanently deleted.
                </p>
            </div>

            <div class="modal-footer" style="border-top: 1px solid #EBE0D5; padding: 20px 30px; background: #FAF6F1; display: flex; gap: 10px;">
                <button type="button" class="btn flex-fill" style="background: #EAE0D5; color: #5C3D1E; border-radius: 12px; font-weight: 700; padding: 12px;" data-bs-dismiss="modal">Cancel</button>

                <form asp-action="Delete" method="post" id="deleteProductForm" class="flex-fill" style="margin: 0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalProductId" value="" />
                    <button type="submit" class="btn w-100" style="background: #d9534f; color: white; border-radius: 12px; font-weight: 700; padding: 12px;">
                        Yes, Delete Item
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const filterBtns = document.querySelectorAll('.filter-btn');
            const productItems = document.querySelectorAll('.product-item');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    // 1. Remove active state from all buttons
                    filterBtns.forEach(b => b.classList.remove('active'));

                    // 2. Add active state to the button that was just clicked
                    this.classList.add('active');

                    // 3. Get the category string we want to filter by
                    const filterValue = this.getAttribute('data-filter');

                    // 4. Instantly hide/show the appropriate products
                    productItems.forEach(item => {
                        if (filterValue === 'all' || item.getAttribute('data-category') === filterValue) {
                            item.style.display = 'flex'; // Use flex to maintain card layout
                            // Add a tiny animation reset for smoothness
                            item.style.animation = 'none';
                            item.offsetHeight; /* trigger reflow */
                            item.style.animation = null;
                        } else {
                            item.style.display = 'none'; // Hide it
                        }
                    });
                });
            });
        });
        // MODAL DYNAMIC DATA LOGIC
        const deleteModal = document.getElementById('deleteProductModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                // 1. Find the specific trash can button that triggered the modal
                const button = event.relatedTarget;

                // 2. Extract the Id and Name from the data- attributes
                const productId = button.getAttribute('data-product-id');
                const productName = button.getAttribute('data-product-name');

                // 3. Populate the hidden form input and the bold warning text
                deleteModal.querySelector('#modalProductId').value = productId;
                deleteModal.querySelector('#modalProductName').textContent = "'" + productName + "'";
            });
        }
    </script>
}