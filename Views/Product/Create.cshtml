@model Pets_friends.Data.ViewModels.ProductFormVM

@{
    ViewData["Title"] = "Add New Product";
    Layout = "~/Views/Shared/_MerchantLayout.cshtml";
}

@section Styles {
    <style>
        :root {
            --text-dark: #5C3D1E;
            --text-muted: #8C7560;
            --bg-card: #FAF6F1;
            --tan-accent: #C8A882;
            --tan-medium: #EDE0D0;
            --brown-button: #5C3D1E;
            --border-light: #EBE0D5;
            --validation-error: #d9534f;
        }

        .setup-card {
            background: #fff;
            border-radius: 24px;
            padding: 40px;
            border: 1px solid var(--border-light);
            box-shadow: 0 10px 30px rgba(92, 61, 30, 0.05);
            max-width: 800px;
            margin: 0 auto;
        }

        .setup-title {
            font-family: 'Playfair Display', serif;
            color: var(--text-dark);
            font-weight: 700;
            margin-bottom: 10px;
        }

        /* --- PRODUCT PHOTO UPLOAD --- */
        .photo-upload-container {
            background-color: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            border: 1px solid var(--border-light);
            margin-bottom: 30px;
        }

        .photo-preview-box {
            width: 180px;
            height: 180px;
            border-radius: 16px;
            border: 4px solid #fff;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            margin: 0 auto 15px;
            overflow: hidden;
            background-color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .photo-preview-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .upload-drop-zone {
            border: 2px dashed var(--tan-accent);
            border-radius: 16px;
            padding: 20px;
            background-color: rgba(255, 255, 255, 0.6);
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .upload-drop-zone:hover {
                background-color: #fff;
                border-color: var(--brown-button);
            }

        .form-control, .form-select {
            border-radius: 12px;
            padding: 12px 16px;
            border: 1px solid var(--tan-medium);
            transition: all 0.2s ease;
            background-color: #fff;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--tan-accent);
                box-shadow: 0 0 0 0.25rem rgba(200, 168, 130, 0.15);
            }

        .btn-brand {
            background-color: var(--brown-button);
            color: #fff;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
        }

            .btn-brand:hover {
                background-color: var(--tan-accent);
                transform: translateY(-2px);
                color: #fff;
            }

        .btn-brand-outline {
            background-color: transparent;
            color: var(--text-dark);
            border: 2px solid var(--text-dark);
            border-radius: 12px;
            padding: 10px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
        }

            .btn-brand-outline:hover {
                background-color: var(--text-dark);
                color: #fff;
            }

        .input-group-text {
            border-radius: 12px 0 0 12px;
            border: 1px solid var(--tan-medium);
            background-color: var(--bg-card);
            color: var(--text-dark);
            font-weight: 600;
        }

        .price-input {
            border-radius: 0 12px 12px 0 !important;
        }
    </style>
}

<div class="container py-5">
    <div class="setup-card">
        <div class="text-center mb-5">
            <div style="width: 80px; height: 80px; background: #FAF6F1; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; color: #C8A882; font-size: 2rem;">
                <i class="bi bi-box-seam"></i>
            </div>
            <h1 class="setup-title">Add New Product</h1>
            <p style="color: #8C7560; font-size: 1.1rem;">List a new item in your store inventory.</p>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="photo-upload-container">
                @{
                    var fallbackImg = "https://placehold.co/300x300/FAF6F1/8C7560?text=Upload+Photo&font=Playfair+Display";
                }
                <div class="photo-preview-box">
                    <img id="imgPreview" src="@fallbackImg" alt="Product Preview">
                </div>
                <h5 style="font-family: 'Playfair Display', serif; font-weight: 700; color: var(--text-dark);">Product Image</h5>
                <div class="upload-drop-zone mt-3" onclick="document.getElementById('fileInput').click()">
                    <i class="bi bi-camera-fill" style="font-size: 2rem; color: var(--tan-accent);"></i>
                    <p class="mb-0 mt-1" style="color: var(--text-muted); font-size: 0.9rem;">Click to browse photos</p>
                    <input asp-for="ImageFile" type="file" id="fileInput" hidden accept="image/*" onchange="handleFileSelect(this)" />
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-bold" style="color: #5C3D1E;">Product Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Premium Kibble Bites" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-bold" style="color: #5C3D1E;">Category</label>
                    <select asp-for="Category" class="form-select" required>
                        <option value="">-- Select Category --</option>
                        <option value="Food & Treats">Food & Treats</option>
                        <option value="Toys">Toys & Enrichment</option>
                        <option value="Grooming">Grooming & Hygiene</option>
                        <option value="Medicine">Health & Medicine</option>
                        <option value="Accessories">Collars & Accessories</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-bold" style="color: #5C3D1E;">Retail Price (Enter 0 for Free)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control price-input" required />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StockQuantity" class="form-label fw-bold" style="color: #5C3D1E;">Initial Stock Quantity</label>
                    <input asp-for="StockQuantity" type="number" min="0" class="form-control" placeholder="e.g., 25" required />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-bold" style="color: #5C3D1E;">Product Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe key ingredients, dimensions, or benefits..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-12 mt-4 d-flex justify-content-end gap-3">
                    <a asp-action="Home" class="btn-brand-outline">Cancel</a>
                    <button type="submit" class="btn-brand">Save Product</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // PHOTO PREVIEW LOGIC
        function handleFileSelect(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => document.getElementById('imgPreview').src = e.target.result;
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}