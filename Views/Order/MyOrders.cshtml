@model IEnumerable<Pets_friends.Models.Order>

@{
    ViewData["Title"] = "My Order History";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%) !important;
            background-attachment: fixed !important;
            font-family: 'DM Sans', sans-serif;
        }

        .order-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid #EBE0D5;
            box-shadow: 0 10px 30px rgba(92, 61, 30, 0.05);
            transition: transform 0.3s ease;
            margin-bottom: 25px;
            overflow: hidden;
        }

        .order-header {
            background: #FAF6F1;
            padding: 20px 30px;
            border-bottom: 1px solid #EBE0D5;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .status-pill {
            padding: 6px 16px;
            border-radius: 30px;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .status-Pending {
            background: #FFF3CD;
            color: #856404;
        }

        .status-Shipped {
            background: #D1ECF1;
            color: #0C5460;
        }

        .status-Delivered {
            background: #D4EDDA;
            color: #155724;
        }

        .status-Cancelled {
            background: #F8D7DA;
            color: #721C24;
        }

        .order-body {
            padding: 30px;
        }

        .product-thumb {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            object-fit: cover;
            border: 1px solid #EBE0D5;
            margin-right: -15px; /* Stacked effect */
            background: #fff;
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        }

        .btn-receipt {
            background: #fff;
            color: #5C3D1E;
            border: 2px solid #EBE0D5;
            border-radius: 12px;
            padding: 10px 20px;
            font-weight: 600;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

            .btn-receipt:hover {
                background: #5C3D1E;
                color: #fff;
                border-color: #5C3D1E;
            }
    </style>
}

<div class="container py-5" style="max-width: 1000px;">
    <h2 class="mb-5 fw-bold" style="font-family: 'Playfair Display', serif; color: #2D1B0E;">My Orders</h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x" style="font-size: 4rem; color: #C8A882;"></i>
            <h4 class="mt-4 fw-bold" style="color: #5C3D1E;">No orders yet</h4>
            <p class="text-muted">When you buy treats or toys, they will appear here!</p>
            <a asp-controller="Store" asp-action="Home" class="btn btn-dark mt-3 px-4 py-2" style="background: #5C3D1E; border-radius: 12px; font-weight: 600;">Start Shopping</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="order-card">
                <div class="order-header">
                    <div>
                        <span class="text-muted small fw-bold">ORDER #@order.Id.ToString("D4")</span>
                        <div class="fw-bold" style="color: #5C3D1E;">Placed on @order.OrderDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <span class="status-pill status-@order.Status">@order.Status</span>
                </div>
                <div class="order-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
                    <div class="d-flex align-items-center">
                        <div class="me-4 d-flex">
                            @if (order.OrderItems != null && order.OrderItems.Any())
                            {
                                @foreach (var item in order.OrderItems.Take(4))
                                {
                                    <img src="@item.Product.ImageUrl" onerror="this.src='https://placehold.co/100x100/FAF6F1/8C7560?text=Item'" class="product-thumb" title="@item.Product.Name" alt="Item Preview" />
                                }
                            }
                        </div>
                        <div>
                            <div class="fw-bold" style="color: #2D1B0E;">From: @(order.MerchantProfile?.StoreName ?? "PetFriends Partner")</div>
                            <div class="text-muted small">@(order.OrderItems?.Sum(i => i.Quantity) ?? 0) Items total</div>
                        </div>
                    </div>

                    <div class="text-md-end">
                        <div class="fs-4 fw-bold mb-2" style="color: #5C3D1E;">@order.TotalAmount.ToString("C")</div>
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn-receipt">
                            <i class="bi bi-receipt me-2"></i>View Receipt
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (TempData["OrderSuccess"] != null)
{
    <div class="modal fade" id="orderVerifiedModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: 2px solid #C8A882;">
                <div class="modal-body text-center p-5">
                    <div class="mb-4">
                        <i class="bi bi-box2-heart-fill" style="font-size: 4.5rem; color: #5C3D1E;"></i>
                    </div>
                    <h2 class="fw-bold" style="color: #2D1B0E;">Order Processed Successfully!</h2>
                    <p class="text-muted mt-2 fs-5">Your fulfillment entries have been dispatched to our partner store logistics queues securely.</p>
                    <div class="mt-4">
                        <button type="button" class="btn btn-dark py-3 px-5 fw-bold" data-bs-dismiss="modal" style="background: #5C3D1E; border-radius: 12px;">
                            Review Store Receipts
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        @if (TempData["OrderSuccess"] != null)
        {
                <text>
                document.addEventListener("DOMContentLoaded", function() {
                    var myModal = new bootstrap.Modal(document.getElementById('orderVerifiedModal'));
                    myModal.show();
                });
                </text>
        }
    </script>
}