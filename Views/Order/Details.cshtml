@model Pets_friends.Models.Order

@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";

    decimal rawSubtotal = Model.OrderItems?.Sum(i => (decimal)i.Quantity * i.UnitPrice) ?? 0m;
    decimal totalPaid = (decimal)Model.TotalAmount;
    decimal feesAndTaxes = totalPaid - rawSubtotal;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt #ORD-@Model.Id.ToString("D4") | PetFriends</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            /* Applied signature warm UI background gradient for digital viewing */
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%) !important;
            background-attachment: fixed !important;
            font-family: 'DM Sans', sans-serif;
            color: #2D1B0E;
            padding: 40px 20px;
        }

        .invoice-container {
            max-width: 850px;
            margin: 0 auto;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(92, 61, 30, 0.08);
            padding: 50px;
            border: 1px solid #EBE0D5;
        }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #5C3D1E;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .brand-logo {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            color: #5C3D1E;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .invoice-details {
            text-align: right;
            color: #8C7560;
        }

        .billing-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 40px;
            background: #FAF6F1;
            padding: 25px;
            border-radius: 12px;
        }

        .billing-title {
            font-weight: 700;
            color: #8C7560;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

            .custom-table th {
                background: #5C3D1E;
                color: #fff;
                padding: 12px 15px;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.85rem;
            }

            .custom-table td {
                padding: 15px;
                border-bottom: 1px solid #EBE0D5;
                vertical-align: middle;
            }

        .item-preview {
            width: 45px;
            height: 45px;
            border-radius: 8px;
            object-fit: cover;
            margin-right: 12px;
            border: 1px solid #EBE0D5;
            background: #fff;
        }

        .summary-box {
            width: 320px;
            margin-left: auto;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            color: #5C3D1E;
            font-size: 1.05rem;
        }

            .summary-row.total {
                border-top: 2px solid #5C3D1E;
                margin-top: 10px;
                padding-top: 15px;
                font-size: 1.4rem;
                font-weight: 700;
            }

        .status-badge {
            padding: 4px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
            margin-top: 5px;
        }

        .status-Pending {
            background: #FFF3CD;
            color: #856404;
        }

        .status-Shipped {
            background: #E0F2FE;
            color: #0C5460;
        }

        .status-Delivered {
            background: #D4EDDA;
            color: #155724;
        }

        .status-Cancelled {
            background: #F8D7DA;
            color: #721C24;
        }

        .btn-print {
            background: #5C3D1E;
            color: #fff;
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 40px auto 0;
        }

            .btn-print:hover {
                background: #C8A882;
            }

        @@media print {
            body {
                padding: 0;
                background: #fff !important; /* Forces solid white background for printing */
            }

            .invoice-container {
                box-shadow: none;
                border: none;
                padding: 0;
                max-width: 100%;
            }

            .btn-print {
                display: none;
            }
        }
    </style>
</head>
<body>

    <div class="invoice-container">

        <div class="invoice-header flex-column flex-sm-row gap-3">
            <div class="brand-logo">
                <i class="bi bi-shop" style="color: #C8A882;"></i>
                PetFriends Market
            </div>
            <div class="invoice-details">
                <h2 style="color: #2D1B0E; font-weight: 700; margin: 0 0 5px 0;">INVOICE</h2>
                <div style="font-weight: 600;">#ORD-@Model.Id.ToString("D4")</div>
                <div class="device-date" data-utc="@Model.OrderDate.ToString("o")">@Model.OrderDate.ToString("MMM dd, yyyy")</div>
                <span class="status-badge status-@Model.Status">@Model.Status</span>
            </div>
        </div>

        <div class="billing-grid">
            <div>
                <div class="billing-title">Billed To:</div>
                <h5 style="margin: 0 0 5px 0; font-weight: 700; color: #2D1B0E;">
                    @(Model.ClientProfile?.UserAccount?.FullName ?? "Customer")
                </h5>
                <div>@(Model.ClientProfile?.Address ?? "Address not provided")</div>
                <div>@(Model.ClientProfile?.UserAccount?.Email)</div>
                <div>@(Model.ClientProfile?.UserAccount?.PhoneNumber)</div>
            </div>
            <div>
                <div class="billing-title">Fulfilled By:</div>
                <h5 style="margin: 0 0 5px 0; font-weight: 700; color: #2D1B0E;">
                    @(Model.MerchantProfile?.StoreName ?? "Partner Store")
                </h5>
                <div>@(Model.MerchantProfile?.StoreAddress ?? "Store Location")</div>
                <div style="font-size: 0.9rem; color: #8C7560; margin-top: 4px;">Verified PetFriends Vendor</div>
            </div>
        </div>

        <table class="custom-table">
            <thead>
                <tr>
                    <th style="border-top-left-radius: 8px; width: 55%;">Description</th>
                    <th style="text-align: center; width: 15%;">Qty</th>
                    <th style="text-align: right; width: 15%;">Unit Price</th>
                    <th style="text-align: right; border-top-right-radius: 8px; width: 15%;">Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrderItems != null && Model.OrderItems.Any())
                {
                    foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@(item.Product?.ImageUrl)" onerror="this.src='https://placehold.co/100x100/FAF6F1/8C7560?text=Item'" class="item-preview" alt="Thumb" />
                                    <div>
                                        <div style="font-weight: 700;">@(item.Product?.Name ?? "Product Item")</div>
                                        <div style="font-size: 0.85rem; color: #8C7560;">Category: @(item.Product?.Category ?? "General")</div>
                                    </div>
                                </div>
                            </td>
                            <td style="text-align: center; font-weight: 600;">@item.Quantity</td>
                            <td style="text-align: right;">@item.UnitPrice.ToString("C")</td>
                            <td style="text-align: right; font-weight: 700; color: #2D1B0E;">
                                @(((decimal)item.Quantity * item.UnitPrice).ToString("C"))
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No line items retrieved for this order payload.</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="summary-box">
            <div class="summary-row">
                <span>Subtotal:</span>
                <span style="font-weight: 600;">@rawSubtotal.ToString("C")</span>
            </div>
            <div class="summary-row">
                <span>Taxes & Fees:</span>
                <span style="font-weight: 600;">@feesAndTaxes.ToString("C")</span>
            </div>
            <div class="summary-row">
                <span>Fulfillment Dispatch:</span>
                <span style="color: #2e7d32; font-weight: 600;">FREE</span>
            </div>
            <div class="summary-row total">
                <span>Total Paid:</span>
                <span>@totalPaid.ToString("C")</span>
            </div>
        </div>

        <button class="btn-print" onclick="window.print()">
            <i class="bi bi-printer-fill"></i> Print Official Receipt
        </button>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dateNodes = document.querySelectorAll('.device-date');
            dateNodes.forEach(node => {
                if (node.dataset.utc) {
                    const dt = new Date(node.dataset.utc);
                    node.innerText = dt.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
                }
            });
        });
    </script>
</body>
</html>