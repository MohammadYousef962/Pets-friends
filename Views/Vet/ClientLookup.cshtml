@model Pets_friends.Models.ClientProfile
@{
    ViewData["Title"] = "Client Search Results";
    Layout = "~/Views/Shared/_VetLayout.cshtml";
}

<div class="container mt-5">
    <a asp-action="Dashboard" class="btn btn-outline-secondary mb-4" style="color: #5C3D1E; border-color: #EDE0D0;">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>

    <div class="glass-panel p-4" style="border-radius: 15px; border: 1px solid #EDE0D0; background: #fff;">
        <h2 style="font-family: 'Playfair Display'; color: #5C3D1E; font-weight: 700;">
            <i class="bi bi-person-badge"></i> Client File: @Model.UserAccount.FullName
        </h2>
        <p style="color: #8C7560;">
            <i class="bi bi-envelope"></i> @Model.UserAccount.Email |
            <i class="bi bi-telephone"></i> @Model.UserAccount.PhoneNumber
        </p>

        <hr style="border-color: #EDE0D0;" />

        <h4 style="font-family: 'Playfair Display'; color: #5C3D1E; font-weight: 700; margin-top: 20px;">Registered Pets</h4>
        
        @if (!Model.Pets.Any())
        {
            <div class="alert alert-warning" style="background: #fdfaf7; color: #8C7560; border: 1px solid #C8A882;">
                This client hasn't added any pets yet.
            </div>
        }
        else
        {
            <div class="row g-3 mt-2">
                @foreach (var pet in Model.Pets)
                {
                    <div class="col-md-6">
                        <div class="p-3 d-flex justify-content-between align-items-center" style="border: 1px solid #EDE0D0; border-radius: 10px; background: #fdfaf7;">
                            <div>
                                <h5 style="color: #5C3D1E; margin-bottom: 2px; font-weight: bold;">@pet.Name</h5>
                                <span style="font-size: 0.85rem; color: #8C7560;">@pet.Species - @pet.Breed (@pet.AgeYears years)</span>
                            </div>

                            <div>
                                @if (pet.IsVerified)
                                {
                                    <span class="badge bg-success" style="font-size: 0.9rem;">
                                        <i class="bi bi-shield-check"></i> Verified
                                    </span>
                                }
                                else
                                {
                                    <form asp-controller="Vet" asp-action="VerifyPet" method="post" class="m-0">
                                        <input type="hidden" name="petId" value="@pet.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path?searchTerm=@Model.UserAccount.PhoneNumber" />
                                        <button type="submit" class="btn btn-sm" style="background: #3a8a4f; color: white;">
                                            Verify Now
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>