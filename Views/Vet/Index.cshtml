@model Pets_friends.Data.ViewModels.VetListViewModel

@{
    ViewData["Title"] = "Book Appointment - Choose a Vet";
    // Assuming you want this to look like the rest of the site
    Layout = "_Layout";
}

<div class="container mt-5" style="padding-top: 40px; min-height: 60vh;">
    <h1 style="color: var(--brown-deep, #4A3B32); font-weight: bold; margin-bottom: 30px;">
        Book an Appointment
    </h1>
    <p style="color: var(--brown-mid, #6C5B51); margin-bottom: 40px;">
        Select a veterinarian from our trusted network to schedule your visit.
    </p>

    @if (Model.Vets != null && Model.Vets.Any())
    {
        <div class="row g-4">
            @foreach (var vet in Model.Vets)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm" style="border-radius: 15px; overflow: hidden; border: 1px solid #EAE3D9;">
                        
                        <img src="@vet.ImageUrl" class="card-img-top" alt="Dr. @vet.UserAccount?.FirstName" style="height: 250px; object-fit: cover;" />
                        
                        <div class="card-body text-center" style="background-color: #FDFBF7;">
                            <h5 class="card-title" style="color: #4A3B32; font-weight: bold;">
                                Dr. @vet.UserAccount?.FirstName @vet.UserAccount?.LastName
                            </h5>
                            <p class="card-text" style="color: #8C6A4F; font-size: 0.9rem; font-weight: 500;">
                                @vet.Specialization
                            </p>
                            <p class="card-text text-muted" style="font-size: 0.85rem;">
                                <i class="bi bi-geo-alt-fill"></i> @vet.ClinicName
                            </p>
                        </div>
                        
                        <div class="card-footer bg-white border-0 text-center pb-4">
                            <a asp-controller="Vet" asp-action="Profile" asp-route-id="@vet.Id" class="btn" style="background-color: #8C6A4F; color: white; border-radius: 25px; padding: 10px 25px; font-weight: 600;">
                                View Profile & Book
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center" style="padding: 50px 0;">
            <i class="bi bi-search" style="font-size: 3rem; color: #CCC;"></i>
            <h4 class="mt-3" style="color: #6C5B51;">No veterinarians found.</h4>
            <p class="text-muted">Check back later as we add more professionals to our network.</p>
        </div>
    }
</div>