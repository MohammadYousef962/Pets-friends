@model Pets_friends.Models.VetProfile

@{
    ViewData["Title"] = "Vet Profile";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4 text-center">
            <img src="@Model.PhotoUrl" class="rounded-circle img-thumbnail mb-3 shadow-sm" style="width: 200px; height: 200px; object-fit: cover;" alt="Vet Image">
            <h3 class="fw-bold">@Model.FullName</h3>
            <p class="text-muted fs-5">@Model.Specialization</p>

            <div class="badge bg-warning text-dark fs-6 mb-4 px-3 py-2 shadow-sm">
                ⭐ @Model.AverageRating / 5.0
            </div>
            
            <button class="btn btn-primary w-100 mb-2 py-2 fw-bold">Book Appointment</button>
            <button class="btn btn-outline-secondary w-100 py-2">Message Vet</button>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-4">
                    <h4 class="card-title text-primary border-bottom pb-2">About the Vet</h4>
                    <p class="card-text fs-5">@Model.Bio</p>

                    <h4 class="card-title text-primary border-bottom pb-2 mt-4">Clinic Info</h4>
                    <p class="fs-5 mb-1"><i class="bi bi-geo-alt-fill text-danger"></i> <strong>Address:</strong> @Model.ClinicAddress</p>
                    <p class="fs-5"><i class="bi bi-clock-fill text-info"></i> <strong>Working Hours:</strong> Sat - Thu, 9:00 AM - 6:00 PM</p>
                </div>
            </div>
        </div>
    </div>
</div>