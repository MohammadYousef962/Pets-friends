@model IEnumerable<Pets_friends.Models.Appointment>

@{
    ViewData["Title"] = "Appointment History";
    Layout = "~/Views/Shared/_VetLayout.cshtml";

    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
    var currentSort = ViewBag.CurrentSort as string ?? "desc";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-primary: #5C3D1E;
            --brand-accent: #C8A882;
            --vet-color: #059669;
            --text-dark: #1A1A1A;
            --text-muted: #6B7280;
            --border-light: #EBE0D5;
        }

        body {
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%) !important;
            background-attachment: fixed !important;
            font-family: 'DM Sans', sans-serif;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.98);
            border-radius: 24px;
            padding: 40px;
            border: 1px solid rgba(255,255,255,0.9);
            box-shadow: 0 15px 35px rgba(92, 61, 30, 0.08);
            max-width: 1300px;
            margin: 40px auto;
        }

        .page-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 2rem;
            color: var(--text-dark);
            letter-spacing: -0.5px;
        }

        /* Toolbar / Filters */
        .filter-toolbar {
            background: #FAFAFA;
            border: 1px solid #EBE0D5;
            padding: 16px 24px;
            border-radius: 16px;
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        .form-select-custom {
            border: 2px solid #EBE0D5;
            border-radius: 12px;
            padding: 10px 16px;
            font-weight: 600;
            color: var(--text-dark);
            box-shadow: none;
            width: auto;
            min-width: 200px;
            transition: all 0.2s;
        }

            .form-select-custom:focus {
                border-color: var(--brand-accent);
                outline: none;
                box-shadow: 0 0 0 4px rgba(200,168,130,0.15);
            }

        /* History Cards */
        .history-card {
            background: #ffffff;
            border: 1px solid #EBE0D5;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 16px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .history-card:hover {
                border-color: var(--brand-accent);
                transform: translateY(-4px);
                box-shadow: 0 12px 30px rgba(92, 61, 30, 0.08);
            }

        .hc-pet {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.2rem;
            color: var(--text-dark);
            margin-bottom: 2px;
        }

        /* CLICKABLE NAME STYLES */
        .clickable-pet-name {
            color: var(--text-dark);
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: underline;
            text-decoration-color: transparent;
        }

            .clickable-pet-name:hover {
                color: var(--vet-color);
                text-decoration-color: var(--vet-color);
            }

        .hc-owner {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .hc-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 800;
            color: #9CA3AF;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .hc-value {
            font-weight: 700;
            color: var(--text-dark);
            font-size: 1rem;
        }

        .hc-date-pill {
            background: #FAF6F1;
            color: var(--brand-primary);
            font-weight: 700;
            font-size: 0.95rem;
            padding: 8px 16px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid #EBE0D5;
        }

        /* Badges & Buttons */
        .status-badge {
            padding: 8px 16px;
            border-radius: 12px;
            font-weight: 800;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-pending {
            background: #FFFBEB;
            color: #D97706;
            border: 1px solid #FEF3C7;
        }

        .status-confirmed {
            background: #ECFDF5;
            color: #059669;
            border: 1px solid #D1FAE5;
        }

        .status-cancelled {
            background: #FEF2F2;
            color: #DC2626;
            border: 1px solid #FEE2E2;
        }

        .status-completed {
            background: #F0F9FF;
            color: #0284C7;
            border: 1px solid #E0F2FE;
        }

        .btn-action-complete {
            background: #0284C7;
            color: white;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 8px 16px;
            border-radius: 10px;
            border: none;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 4px 10px rgba(2, 132, 199, 0.2);
            width: 100%;
            justify-content: center;
        }

            .btn-action-complete:hover {
                background: #0369A1;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(2, 132, 199, 0.3);
            }

        /* MODAL STYLES */
        .medical-lock-banner {
            background: #ECFDF5;
            color: #065F46;
            padding: 12px 20px;
            font-size: 0.9rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid #D1FAE5;
        }

        .medical-readonly-banner {
            background: #F3F4F6;
            color: #4B5563;
            padding: 12px 20px;
            font-size: 0.9rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid #E5E7EB;
        }

        .locked-field {
            background: #F3F4F6;
            border: 1px solid #E5E7EB;
            border-radius: 12px;
            padding: 12px 16px;
            color: #4B5563;
            font-weight: 500;
            cursor: not-allowed;
            margin-bottom: 15px;
            font-size: 0.95rem;
        }

        .locked-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 800;
            color: #9CA3AF;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .editable-input {
            background: #FFFFFF;
            border: 2px solid var(--border-light);
            border-radius: 12px;
            padding: 12px 16px;
            color: #1F2937;
            font-weight: 600;
            width: 100%;
            transition: 0.2s;
            margin-bottom: 15px;
            font-size: 0.95rem;
        }

            .editable-input:focus {
                border-color: var(--brand-accent);
                outline: none;
                box-shadow: 0 0 0 4px rgba(200, 168, 130, 0.1);
            }

            .editable-input:disabled {
                background: #F3F4F6;
                cursor: not-allowed;
                color: #9CA3AF;
            }

        .editable-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 800;
            color: var(--brand-accent);
            margin-bottom: 6px;
            display: block;
        }
    </style>
}

<div class="container pb-5">
    <div class="glass-panel">

        <div class="d-flex align-items-center mb-4 gap-4">
            <a asp-action="Dashboard" class="btn btn-light rounded-circle shadow-sm" style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; border: 1px solid #EBE0D5; transition: all 0.2s;">
                <i class="bi bi-arrow-left fs-5" style="color: var(--brand-primary)"></i>
            </a>
            <div>
                <h1 class="page-title mb-1">Appointment History</h1>
                <p class="text-muted mb-0 fw-medium">View and filter all past and current appointment records.</p>
            </div>
        </div>

        <form method="get" class="filter-toolbar" id="filterForm">
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-funnel-fill text-muted fs-5"></i>
                    <select name="status" class="form-select form-select-custom" onchange="document.getElementById('filterForm').submit();">
                        <option value="All" selected="@(currentStatus == "All")">All Appointments</option>
                        <option value="Confirmed" selected="@(currentStatus == "Confirmed")">Confirmed / Upcoming</option>
                        <option value="Pending" selected="@(currentStatus == "Pending")">Pending Requests</option>
                        <option value="Completed" selected="@(currentStatus == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Cancelled / Declined</option>
                    </select>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-sort-down-alt text-muted fs-5"></i>
                    <select name="sortOrder" class="form-select form-select-custom" onchange="document.getElementById('filterForm').submit();">
                        <option value="desc" selected="@(currentSort == "desc")">Date (Newest First)</option>
                        <option value="asc" selected="@(currentSort == "asc")">Date (Oldest First)</option>
                    </select>
                </div>
            </div>

            <div class="fw-bold text-muted" style="font-size: 0.95rem;">
                <i class="bi bi-card-list me-1"></i> Showing @Model.Count() records
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div style="width: 80px; height: 80px; background: #F3F4F6; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                </div>
                <h4 class="fw-bold" style="color: var(--brand-primary)">No records found</h4>
                <p class="text-muted mb-4">No appointments match your current filters.</p>
                <a asp-action="AppointmentHistory" class="btn btn-light border rounded-pill px-4 py-2 fw-bold text-muted">Clear Filters</a>
            </div>
        }
        else
        {
            <div class="history-list">
                @foreach (var apt in Model)
                {
                    // ── Safe Extraction of Services and Client Notes Generated by the Controller ──
                    string displayService = apt.Service?.Name;
                    string displayNotes = string.Empty;

                    if (!string.IsNullOrEmpty(apt.Notes))
                    {
                        if (apt.Notes.Contains("[NEW PATIENT VERIFICATION]"))
                        {
                            displayService = "New Patient Registration";
                            var notesMatch = System.Text.RegularExpressions.Regex.Match(apt.Notes, @"(?:\|\||\|)\s*Notes:\s*(.*)");
                            if (notesMatch.Success)
                            {
                                displayNotes = notesMatch.Groups[1].Value.Trim();
                            }
                        }
                        else
                        {
                            var match = System.Text.RegularExpressions.Regex.Match(apt.Notes, @"Service:\s*(.+?)\s*\|\s*Notes:\s*(.*)");
                            if (match.Success)
                            {
                                if (string.IsNullOrEmpty(displayService))
                                    displayService = match.Groups[1].Value.Trim();

                                displayNotes = match.Groups[2].Value.Trim();
                            }
                            else
                            {
                                displayNotes = apt.Notes;
                            }
                        }
                    }

                    if (string.IsNullOrEmpty(displayService))
                        displayService = "General Visit";


                    <div class="history-card @(apt.IsUrgent ? "border-danger" : "")" style="@(apt.IsUrgent ? "box-shadow: 0 0 10px rgba(220,38,38,0.12);" : "")">

                        <!-- Urgent Notification Banner -->
                        @if (apt.IsUrgent)
                        {
                            <div style="position: absolute; top: 0; right: 0; background: #DC2626; color: white; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.5px; padding: 4px 16px; border-bottom-left-radius: 12px; z-index: 1;">
                                <i class="bi bi-exclamation-triangle-fill"></i> URGENT
                            </div>
                        }

                        <div class="row align-items-center g-4 m-0">

                            <!-- Profile Info -->
                            <div class="col-12 col-lg-4 d-flex align-items-center gap-3">
                                <img src="@(apt.Pet?.ImageUrl ?? "https://placehold.co/100/EBE0D5/5C3D1E?text=New")" style="width: 65px; height: 65px; border-radius: 16px; object-fit: cover; box-shadow: 0 4px 10px rgba(0,0,0,0.05);" />
                                <div>
                                    <div class="hc-pet">
                                        @if (apt.Pet != null)
                                        {
                                            string safeName = apt.Pet.Name?.Replace("\"", "&quot;") ?? "Unknown";
                                            string safeBreed = apt.Pet.Breed?.Replace("\"", "&quot;") ?? "Unknown";
                                            string safeGender = apt.Pet.Gender?.Replace("\"", "&quot;") ?? "Unknown";
                                            string safeHistory = apt.Pet.MedicalHistory?.Replace("\"", "&quot;").Replace("\r\n", " ") ?? "";
                                            string safeDesc = apt.Pet.Description?.Replace("\"", "&quot;").Replace("\r\n", " ") ?? "";
                                            bool isCompleted = apt.Status == "Completed";
                                            int petAge = apt.Pet.DateOfBirth != default ? (DateTime.Now.Year - apt.Pet.DateOfBirth.Year) : 0;

                                            <span class="clickable-pet-name"
                                                  data-name="@safeName"
                                                  data-breed="@safeBreed"
                                                  data-age="@petAge"
                                                  data-gender="@safeGender"
                                                  data-neutered="@apt.Pet.IsNeutered.ToString().ToLower()"
                                                  data-history="@safeHistory"
                                                  data-desc="@safeDesc"
                                                  data-img="@(apt.Pet.ImageUrl ?? "https://placehold.co/100/EBE0D5/5C3D1E?text=Pet")"
                                                  data-petid="@apt.Pet.Id"
                                                  data-iscompleted="@isCompleted.ToString().ToLower()"
                                                  onclick="openPetDetailsModal(this)"
                                                  title="@(isCompleted ? "Click to view medical record" : "Click to view & edit medical record")">
                                                @apt.Pet.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span>New Patient (Unregistered)</span>
                                        }
                                    </div>
                                    <div class="hc-owner"><i class="bi bi-person-badge-fill" style="color: var(--brand-accent)"></i> @(apt.ClientProfile?.UserAccount?.FullName ?? "Unknown Client")</div>
                                </div>
                            </div>

                            <!-- Service & Date -->
                            <div class="col-12 col-lg-5">
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <div class="hc-label">Service Type</div>
                                        <div class="hc-value text-truncate" title="@displayService">
                                            @displayService
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="hc-label">Schedule</div>
                                        <div class="hc-date-pill">
                                            <i class="bi bi-clock-history"></i> @apt.AppointmentDate.ToString("MMM dd, yyyy • h:mm tt")
                                        </div>
                                    </div>

                                    <!-- Render Contextual Notes Provided by Client -->
                                    @if (!string.IsNullOrEmpty(displayNotes))
                                    {
                                        <div class="col-12 mt-2">
                                            <div class="hc-label">Client Notes</div>
                                            <div class="text-muted" style="font-size: 0.85rem; font-style: italic;">
                                                <i class="bi bi-chat-left-text me-1"></i> @displayNotes
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Status & Actions -->
                            <div class="col-12 col-lg-3 text-lg-end d-flex flex-column align-items-lg-end gap-2 border-start-lg border-2" id="status-container-@apt.Id">
                                @if (apt.Status == "Pending")
                                {
                                    <span class="status-badge status-pending"><i class="bi bi-hourglass-split"></i> Pending</span>
                                }
                                else if (apt.Status == "Confirmed")
                                {
                                    <span class="status-badge status-confirmed"><i class="bi bi-calendar-check-fill"></i> Confirmed</span>

                                    <!-- Matches exactly the logic bound in the VetController (id, status) -->
                                    <form asp-controller="Vet" asp-action="UpdateAppointmentStatus" method="post" class="m-0 p-0 w-100 ajax-complete-form" style="max-width: 150px;">
                                        <input type="hidden" name="id" value="@apt.Id" />
                                        <input type="hidden" name="status" value="Completed" />
                                        <button type="submit" class="btn-action-complete mt-1 complete-btn">
                                            <i class="bi bi-check2-circle fs-6"></i> Mark Complete
                                        </button>
                                    </form>
                                }
                                else if (apt.Status == "Cancelled" || apt.Status == "Declined")
                                {
                                    <span class="status-badge status-cancelled"><i class="bi bi-x-circle-fill"></i> Cancelled</span>
                                }
                                else if (apt.Status == "Completed")
                                {
                                    <span class="status-badge status-completed"><i class="bi bi-patch-check-fill"></i> Completed</span>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ============================================== -->
<!-- SPLIT SCREEN PET EDIT MODAL (SILENT AJAX SAVE) -->
<!-- ============================================== -->
<div class="modal fade" id="petDetailsModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content overflow-hidden p-0 border-0" style="border-radius: 24px; box-shadow: 0 20px 50px rgba(92, 61, 30, 0.15);">
            <div class="modal-header bg-white border-bottom-0 pt-4 pb-2 px-4">
                <h5 class="modal-title fw-bold" id="modalPetTitle" style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.4rem;">Pet's Official Profile</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Dynamic Banners Based on Status -->
            <div id="editableBanner" class="medical-lock-banner">
                <i class="bi bi-shield-check fs-5"></i>
                You have clearance to update medical history and reproductive status. Core physical traits are locked.
            </div>
            <div id="readOnlyBanner" class="medical-readonly-banner" style="display: none;">
                <i class="bi bi-archive-fill fs-5"></i>
                This record belongs to a completed appointment and is archived as Read-Only.
            </div>

            <form id="editPetAjaxForm" onsubmit="savePetChangesSilently(event)">
                <input type="hidden" name="PetId" id="modalPetId" />

                <div class="modal-body p-4 bg-white">
                    <div class="row g-4">
                        <div class="col-md-6 border-end pe-md-4">
                            <img src="" id="modalImg" class="rounded-4 w-100 shadow-sm mb-3" style="height:280px; object-fit:cover;" onerror="this.src='https://placehold.co/400x300/FAF6F1/8C7560?text=Pet'">
                            <h5 class="fw-bold text-dark mb-2" id="modalPetNameDisplay">About Name</h5>
                            <p class="text-muted" style="line-height: 1.6;" id="modalDesc">Description</p>
                        </div>

                        <div class="col-md-6 ps-md-4">
                            <h6 class="fw-bold mb-4" style="color: var(--text-muted); font-family: 'Plus Jakarta Sans', sans-serif;">Verified Medical ID</h6>

                            <div class="locked-label">Breed / Species <i class="bi bi-lock-fill"></i></div>
                            <div class="locked-field" id="modalBreed">...</div>

                            <div class="row">
                                <div class="col-6">
                                    <div class="locked-label">Age <i class="bi bi-lock-fill"></i></div>
                                    <div class="locked-field" id="modalAge">...</div>
                                </div>
                                <div class="col-6">
                                    <div class="locked-label">Gender <i class="bi bi-lock-fill"></i></div>
                                    <div class="locked-field" id="modalGender">...</div>
                                </div>
                            </div>

                            <label class="editable-label">Reproductive Status</label>
                            <select name="IsNeutered" id="modalNeutered" class="editable-input">
                                <option value="true">Neutered / Spayed</option>
                                <option value="false">Intact</option>
                            </select>

                            <label class="editable-label">Medical History</label>
                            <textarea name="MedicalHistory" id="modalHistory" class="editable-input" rows="4" placeholder="Enter vaccination status, allergies, etc..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer" style="border-top: 1px solid var(--border-light); padding: 20px 30px; background: #FAFAFA; display:flex; justify-content:flex-end;">
                    <button type="button" class="btn btn-light fw-bold px-4 rounded-pill me-3" data-bs-dismiss="modal">Close</button>
                    <button type="submit" id="btnSaveAjax" class="btn text-white fw-bold px-4 rounded-pill" style="background: var(--vet-color); transition: 0.2s;">
                        <i class="bi bi-floppy-fill me-1"></i> Save Profile Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Track the element clicked so we can update its data attributes later
        let currentPetElement = null;

        // --- PET DETAILS MODAL LOGIC (With Edit vs View States) ---
        function openPetDetailsModal(element) {
            currentPetElement = element;
            const ds = element.dataset;

            document.getElementById('modalPetTitle').innerText = ds.name + "'s Official Profile";
            document.getElementById('modalPetNameDisplay').innerText = 'About ' + ds.name;
            document.getElementById('modalImg').src = ds.img;
            document.getElementById('modalDesc').innerText = ds.desc || "No description provided.";

            document.getElementById('modalBreed').innerText = ds.breed;
            document.getElementById('modalAge').innerText = ds.age + ' yrs';
            document.getElementById('modalGender').innerText = ds.gender;

            const neuteredSelect = document.getElementById('modalNeutered');
            const historyText = document.getElementById('modalHistory');
            const saveBtn = document.getElementById('btnSaveAjax');
            const editableBanner = document.getElementById('editableBanner');
            const readOnlyBanner = document.getElementById('readOnlyBanner');

            neuteredSelect.value = (ds.neutered === 'true') ? "true" : "false";
            historyText.value = ds.history || "";
            document.getElementById('modalPetId').value = ds.petid;

            // Logic for "Completed" appointments locking the fields
            if (ds.iscompleted === 'true') {
                neuteredSelect.disabled = true;
                historyText.disabled = true;
                saveBtn.style.display = 'none';
                editableBanner.style.display = 'none';
                readOnlyBanner.style.display = 'flex';
            } else {
                neuteredSelect.disabled = false;
                historyText.disabled = false;
                saveBtn.style.display = 'block';
                editableBanner.style.display = 'flex';
                readOnlyBanner.style.display = 'none';
            }

            new bootstrap.Modal(document.getElementById('petDetailsModal')).show();
        }

        // --- SILENT BACKGROUND SAVE (AJAX) ---
        function savePetChangesSilently(event) {
            event.preventDefault(); // Blocks the page from refreshing!

            const form = event.target;
            const formData = new FormData(form);
            const submitBtn = document.getElementById('btnSaveAjax');
            const originalBtnHtml = submitBtn.innerHTML;
            const originalBtnColor = submitBtn.style.background;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Saving...';

            fetch('/Vet/UpdateMedicalRecordAjax', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if(data.success) {
                    const newNeutered = document.getElementById('modalNeutered').value;
                    const newHistory = document.getElementById('modalHistory').value;

                    // Instantly update the HTML data tags of the button we clicked
                    if (currentPetElement) {
                        currentPetElement.dataset.neutered = newNeutered;
                        currentPetElement.dataset.history = newHistory;
                    }

                    // Show a beautiful "Saved" text on the button, then close the modal
                    submitBtn.style.background = "#10B981"; // Success Green
                    submitBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Saved!';

                    setTimeout(() => {
                        bootstrap.Modal.getInstance(document.getElementById('petDetailsModal')).hide();
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnHtml;
                        submitBtn.style.background = originalBtnColor;
                    }, 800);

                } else {
                    alert("Failed to save changes. " + (data.message || ""));
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnHtml;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert("A network error occurred. Please try again.");
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnHtml;
            });
        }

        // --- BACKGROUND STATUS UPDATE FOR "MARK COMPLETE" ---
        document.querySelectorAll('.ajax-complete-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();

                const btn = this.querySelector('.complete-btn');
                const container = this.closest('div[id^="status-container-"]');
                const historyCard = container.closest('.history-card');

                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Saving...';
                btn.disabled = true;

                fetch(this.action, {
                    method: this.method,
                    body: new FormData(this)
                })
                .then(response => {
                    if (response.ok) {
                        // Success! Swap the section out for the blue "Completed" badge
                        container.innerHTML = `<span class="status-badge status-completed"><i class="bi bi-patch-check-fill"></i> Completed</span>`;

                        // Find the pet name in the card and instantly lock it to view-only mode!
                        const petNameSpan = historyCard.querySelector('.clickable-pet-name');
                        if (petNameSpan) {
                            petNameSpan.dataset.iscompleted = "true";
                            petNameSpan.title = "Click to view medical record";
                        }
                    } else {
                        HTMLFormElement.prototype.submit.call(form);
                    }
                })
                .catch(error => {
                    HTMLFormElement.prototype.submit.call(form);
                });
            });
        });
    </script>
}