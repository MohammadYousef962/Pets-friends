@model Pets_friends.Models.ClientProfile

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-family: 'Playfair Display'; color: #5C3D1E; margin: 0; font-weight: 700;">
        @Model.UserAccount.FullName
    </h5>
    <span class="text-muted small">
        <i class="bi bi-telephone"></i> @Model.UserAccount.PhoneNumber
    </span>
</div>

@if (!Model.Pets.Any())
{
    <p class="text-muted" style="color: #8C7560;">This client hasn't added any pets yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var pet in Model.Pets)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center mb-2" style="border: 1px solid #EDE0D0; border-radius: 10px; background: #fff;">
                <div>
                    <strong style="color: #5C3D1E;">@pet.Name</strong>
                    <div class="small" style="color: #8C7560;">@pet.Species - @pet.Breed (@pet.AgeYears yrs)</div>
                </div>
                
                @if (pet.IsVerified)
                {
                    <span class="badge" style="background: #e4f0e8; color: #3a8a4f; border: 1px solid #c3e6cb;">
                        <i class="bi bi-shield-check"></i> Verified
                    </span>
                }
                else
                {
                    <!-- The Verify Button! -->
                    <form asp-controller="Vet" asp-action="VerifyPet" method="post" class="m-0">
                        <input type="hidden" name="petId" value="@pet.Id" />
                        <input type="hidden" name="returnUrl" value="~/Vet/Dashboard" />
                        <button type="submit" class="btn btn-sm" style="background: #3a8a4f; color: white;">
                            Verify Now
                        </button>
                    </form>
                }
            </div>
        }
    </div>
}