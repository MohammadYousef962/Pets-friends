@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-wrapper">
    <div class="main-container">
        <div class="left-panel">
            <img src="~/images/Pets.png" alt="Happy Pets" asp-append-version="true" />
        </div>
        <div class="right-panel">
            <div class="form-box" style="text-align: center;">
                <i class="bi bi-check-circle-fill" style="font-size: 4rem; color: #4CAF50; margin-bottom: 15px;"></i>
                <h2 style="margin-bottom: 15px;">Password Reset!</h2>
                <p style="color: #8C7560; font-size: 0.95rem; line-height: 1.6;">
                    Your password has been successfully reset. You can now log in with your new credentials.
                </p>
                <div style="margin-top: 30px;">
                    <a asp-action="Login" class="btn" style="background-color: #5C3D1E; color: white; padding: 10px 25px; border-radius: 8px; text-decoration: none; font-weight: bold;">Go to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>