@{
    ViewData["Title"] = "Email Sent";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-wrapper">
    <div class="main-container">
        <div class="left-panel">
            <img src="~/images/Pets.png" alt="Happy Pets" asp-append-version="true" />
        </div>
        <div class="right-panel">
            <div class="form-box" style="text-align: center;">
                <i class="bi bi-envelope-check" style="font-size: 4rem; color: #C8A882; margin-bottom: 15px;"></i>
                <h2 style="margin-bottom: 15px;">Check Your Email</h2>
                <p style="color: #8C7560; font-size: 0.95rem; line-height: 1.6;">
                    If an account exists with that email, we have sent a password reset link.
                    Please check your inbox (and spam folder) to continue.
                </p>
                <div style="margin-top: 30px;">
                    <a asp-action="Login" style="display: inline-block; background-color: #5C3D1E; color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: bold; transition: 0.3s;">
                        <i class="bi bi-arrow-left me-1"></i> Return to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>