@model Pets_friends.Data.ViewModels.ForgotPasswordVM

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-wrapper">
    <div class="main-container">
        <div class="left-panel">
            <img src="~/images/Pets.png" alt="Happy Pets" asp-append-version="true" />
        </div>

        <div class="right-panel">
            <div class="form-box">
                <div class="logo">
                    <span class="logo-text">Pet Friends</span>
                </div>

                <h2 style="margin-bottom: 5px;">Reset Password</h2>
                <p style="color: #8C7560; text-align: center; margin-bottom: 25px; font-size: 0.9rem;">
                    Enter your email address and we'll send you a link to reset your password.
                </p>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="input-group">
                        <input asp-for="Email" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <button type="submit">Send Reset Link</button>

                    <div class="forgot-link" style="text-align: center; margin-top: 20px;">
                        <a asp-action="Login">Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}