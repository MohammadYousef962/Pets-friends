@{
    ViewData["Title"] = "Access Denied";

    // Dynamically apply the correct layout based on user role
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Admin")) { Layout = "_AdminLayout"; }
        else if (User.IsInRole("Vet")) { Layout = "_VetLayout"; }
        else if (User.IsInRole("Merchant")) { Layout = "_MerchantLayout"; }
        else if (User.IsInRole("Shelter")) { Layout = "_ShelterLayout"; }
        else { Layout = "_Layout"; } // Client
    }
    else
    {
        Layout = "_Layout"; // Guest
    }

    string dashboardUrl = ViewData["DashboardUrl"]?.ToString() ?? "~/Home/Main";
}

<style>
    :root {
        --brand-primary: #5C3D1E;
        --brand-secondary: #C8A882;
        --text-muted: #8C7560;
        /* Re-added the beautiful gradient! */
        --bg-gradient: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%);
    }

    /* We apply the background to this wrapper so it fits perfectly inside your Layouts */
    .access-denied-wrapper {
        background: var(--bg-gradient);
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        border-radius: 24px; /* Gives it soft corners inside the layout */
        margin: 20px 0;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.03);
    }

    .denied-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border-radius: 32px;
        border: 1px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 20px 50px rgba(92, 61, 30, 0.08);
        padding: 60px 50px;
        max-width: 550px;
        text-align: center;
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .icon-circle {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #FAF6F1;
        color: var(--brand-secondary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin-bottom: 30px;
        border: 2px solid #EBE0D5;
        box-shadow: inset 0 4px 10px rgba(92, 61, 30, 0.05);
        margin-left: auto;
        margin-right: auto;
    }

    .title-denied {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        font-weight: 700;
        color: #2D1B0E;
        margin: 0 0 15px 0;
        letter-spacing: -0.5px;
    }

    .desc-denied {
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.6;
        margin: 0 0 40px 0;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-primary-back {
        background-color: var(--brand-primary);
        color: #fff;
        border: none;
        border-radius: 16px;
        padding: 14px 32px;
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 10px 20px rgba(92, 61, 30, 0.15);
        cursor: pointer;
        flex: 1;
        min-width: 180px;
    }

    .btn-primary-back:hover {
        background-color: var(--brand-secondary);
        transform: translateY(-3px);
        box-shadow: 0 15px 25px rgba(92, 61, 30, 0.2);
        color: #fff;
    }

    .btn-secondary-dash {
        background-color: #ffffff;
        color: var(--brand-primary);
        border: 2px solid #EBE0D5;
        border-radius: 16px;
        padding: 14px 32px;
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        flex: 1;
        min-width: 180px;
    }

    .btn-secondary-dash:hover {
        background-color: #FAF6F1;
        color: var(--brand-primary);
        transform: translateY(-3px);
    }

    .action-buttons i {
        font-size: 1.2rem;
        transition: transform 0.3s;
    }

    .btn-primary-back:hover i {
        transform: translateX(-4px);
    }
</style>

<div class="access-denied-wrapper">
    <div class="denied-card">
        
        <div class="icon-circle">
            <i class="bi bi-lock-fill"></i>
        </div>

        <h1 class="title-denied">Restricted Area</h1>
        
        <p class="desc-denied">
            Your current account permissions do not authorize access to this specific view. Let's get you back to where you belong.
        </p>

        <div class="action-buttons">
            <!-- Calls the smart JS function below to skip the redirect loop -->
            <button onclick="goBackSafely()" class="btn-primary-back">
                <i class="bi bi-arrow-left"></i> Go Back
            </button>

            <!-- Fallback Dashboard / Home Button -->
            <a href="@Url.Content(dashboardUrl)" class="btn-secondary-dash">
                <i class="bi bi-house-door"></i> Home
            </a>
        </div>

    </div>
</div>

<!-- Smart Navigation Script -->
<script>
    function goBackSafely() {
        // Because ASP.NET redirects you to this page when access is denied, 
        // going back 1 step just puts you back in the forbidden loop.
        // Going back 2 steps bypasses the forbidden page entirely!
        if (window.history.length > 2) {
            window.history.go(-2);
        } else {
            // Failsafe: if there is no history, send them to the dashboard
            window.location.href = '@Url.Content(dashboardUrl)';
        }
    }
</script>