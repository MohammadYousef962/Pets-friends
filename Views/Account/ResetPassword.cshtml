@model Pets_friends.Data.ViewModels.ResetPasswordVM

@{
    ViewData["Title"] = "Create New Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-wrapper">
    <div class="main-container">
        <div class="left-panel">
            <img src="~/images/Pets.png" alt="Happy Pets" asp-append-version="true" />
        </div>

        <div class="right-panel">
            <div class="form-box">
                <h2 style="margin-bottom: 5px;">New Password</h2>
                <p style="color: #8C7560; text-align: center; margin-bottom: 25px; font-size: 0.9rem;">
                    Please create a strong, new password for your account.
                </p>

                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="All" style="color: #d9534f; font-weight: bold; margin-bottom: 15px; text-align: center;"></div>
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />

                    <div class="input-group">
                        <input asp-for="Password" type="password" placeholder="New Password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="input-group">
                        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm New Password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" style="margin-top: 10px;">Reset Password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}