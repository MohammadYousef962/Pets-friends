@model Pets_friends.Data.ViewModels.LoginVM

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div class="main-wrapper">
    <div class="main-container">

        <div class="left-panel">
            <img src="~/images/Pets.png" alt="Happy Pets" asp-append-version="true" />
        </div>

        <div class="right-panel">
            <div class="form-box">

                <div class="logo">
                    <span class="logo-text">Pet Friends</span>
                </div>

                <div class="toggle">
                    <a asp-controller="Account" asp-action="Register">Sign Up</a>
                    <a class="active">Log In</a>
                </div>

                <h2>Welcome Back</h2>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="input-group">
                        <input asp-for="EmailAddress" placeholder="Email" />
                        <span asp-validation-for="EmailAddress" class="field-validation-error"></span>
                    </div>

                    <div class="input-group">
                        <div class="password-wrapper">
                            <input asp-for="Password" type="password" id="loginPassword" class="password-input" placeholder="Password" />
                            <button type="button" class="password-toggle" onclick="togglePassword('loginPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="forgot-link">
                        <a asp-action="ForgotPassword">Forgot Password?</a>
                    </div>

                    <button type="submit">Login</button>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = "password";
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}