@model Pets_friends.Data.ViewModels.LoginVM

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml"; // Force the full-screen layout
}

<div class="main-wrapper">
    <div class="main-container">

        <div class="left-panel">
            <img src="~/images/Pets.png" alt="Happy Pets" asp-append-version="true" />
        </div>

        <div class="right-panel">
            <div class="form-box">

                <div class="logo">
                    <div class="logo-circle">🐾</div>
                    <span class="logo-text">Pet Friends</span>
                    <div class="logo-circle">🐾</div>
                </div>

                <div class="toggle">
                    <a asp-controller="Account" asp-action="Register">Sign Up</a>
                    <a class="active">Log In</a>
                </div>

                <h2>Welcome Back</h2>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="input-group">
                        <input asp-for="EmailAddress" placeholder="Email" />
                        <span asp-validation-for="EmailAddress" class="field-validation-error"></span>
                    </div>

                    <div class="input-group">
                        <input asp-for="Password" type="password" placeholder="Password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="forgot-link">
                        <a asp-action="ForgotPassword">Forgot Password?</a>
                    </div>

                    <button type="submit">Login</button>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}