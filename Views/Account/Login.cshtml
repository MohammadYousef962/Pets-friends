@model Pets_friends.Data.ViewModels.LoginVM

@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/Signing.css" />

<div class="main-wrapper">
    <div class="main-container">

        <div class="left-panel">
            <img src="~/images/Pets.png" asp-append-version="true" />
        </div>

        <div class="right-panel">
            <div class="form-box">

                <div class="logo">
                    <div class="logo-circle">🐾</div>
                    <span class="logo-text">Pet Friends</span>
                    <div class="logo-circle">🐾</div>
                </div>

                <div class="toggle">
                    <a asp-controller="Account" asp-action="Register">Sign Up</a>
                    <a class="active">Log In</a>
                </div>

                <h2>Welcome Back</h2>

                <form asp-action="Login" method="post">

                    <input asp-for="EmailAddress" placeholder="Email" />
                    <input asp-for="Password" type="password" placeholder="Password" />

                    <div class="forgot-link">
                        <a asp-action="ForgotPassword">Forgot Password?</a>
                    </div>

                    <button type="submit">Login</button>

                    <div class="text-danger" asp-validation-summary="ModelOnly"></div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}