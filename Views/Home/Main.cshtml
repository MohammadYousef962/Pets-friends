        <div class="footer-bottom">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3" style="max-width: 1100px;">
                <div class="mb-0">© 2026 petfriends.support@@gmail.com. All Rights Reserved.</div>
                <div class="d-flex gap-4">
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                </div>
            </div>
