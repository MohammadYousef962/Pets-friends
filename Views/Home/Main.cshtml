    <!-- Pet Details Modal -->
    <div class="modal fade" id="petDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="color: var(--text-dark); text-align: left;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="detailsModalTitle">Pet Profile</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                </div>
                <div class="medical-lock-banner">
                    <i class="bi bi-shield-check fs-5"></i>
                    <div>This file context contains strict verified health records from our partner clinics.</div>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6 border-end pe-md-4">
                            <img src="" id="modalImg" class="modal-pet-img" alt="Pet Image Target">
                            <h3 id="modalPetNameDisplay" class="fw-bold mt-2 mb-3">Name</h3>
                            <label class="form-label font-weight-bold" style="color: var(--brand-accent);">Personality Profile</label>
                            <div class="pet-desc-box" id="modalDesc">Details.</div>
                        </div>
                        <div class="col-md-6 ps-md-4">
                            <h6 class="fw-bold mb-4" style="color: var(--text-muted);">Verified Medical ID</h6>
                            <div class="locked-label">Breed / Species <i class="bi bi-patch-check-fill text-success"></i></div>
                            <div class="locked-field" id="modalBreed">Breed</div>
                            <div class="row">
                                <div class="col-6">
                                    <div class="locked-label">Age</div>
                                    <div class="locked-field" id="modalAge">Age</div>
                                </div>
                                <div class="col-6">
                                    <div class="locked-label">Gender</div>
                                    <div class="locked-field" id="modalGender">Gender</div>
                                </div>
                            </div>
                            <div class="locked-label">Medical History</div>
                            <div class="locked-field mb-0" id="modalHistory" style="min-height: 100px;">History logs</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn-adopt-modal rounded-pill px-4 text-white" style="border:none;" onclick="triggerApplicationFromDetails()">Adopt Me</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Authenticated Adoption Modal -->
    <div class="modal fade" id="adoptionApplicationModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="color: var(--text-dark); text-align: left;">
                <div class="modal-header" style="background:#ECFDF5; border-bottom:1px solid #D1FAE5;">
                    <h5 class="fw-bold modal-title" style="color: #065F46;"><i class="bi bi-envelope-paper-heart-fill me-2" style="color:#059669;"></i> Adopt: <span id="adoptModalPetName">Pet</span></h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                </div>

                <form asp-controller="Home" asp-action="SubmitAdoption" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PetId" id="adoptPetIdField" />

                    <div class="modal-body p-4 text-start">
                        @if (!isAuthenticated)
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-shield-lock fs-1 text-muted mb-3 d-block"></i>
                                <h6 class="fw-bold">Sign In Required</h6>
                                <p class="text-muted small">You need to be signed in to submit an adoption application.</p>
                                <a href="/Account/Login" class="btn btn-dark rounded-pill mt-2 px-4 py-2 fw-bold" style="background: #059669; border: none; text-decoration:none; color:white;">Sign In Now</a>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold">Why are you looking to adopt this pet? *</label>
                                <textarea name="Motivation" class="form-control-custom" rows="3" required placeholder="Explain your decision details..."></textarea>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold">Describe your current domestic infrastructure *</label>
                                <textarea name="LivingSituation" class="form-control-custom" rows="3" required placeholder="Specify yard status, residential context, rental lease boundaries if any..."></textarea>
                            </div>
                            <div class="terms-box">
                                <input type="checkbox" name="AgreedToPolicy" value="true" required style="width:20px; height:20px; cursor: pointer; margin-top:3px;" />
                                <p class="mb-0" style="color: #92400E; font-size: 0.9rem; line-height: 1.5; font-weight: 600;">I formally commit to returning the rescue to a verified shelter checkup hub once a week during month one, and twice a month for the successive context to safeguard proper adjustment.</p>
                            </div>
                        }
                    </div>

                    <div class="modal-footer" style="background:#FAFAFA;">
                        <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Cancel</button>
                        @if (isAuthenticated)
                        {
                            <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold" style="background:#10B981; border:none;">Submit Request</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const allDatabasePets = @Html.Raw(Json.Serialize(Model.AdoptablePets));
        let activePetIdContext = 0;
        let activePetNameContext = "";
        let shuffleIntervalTimer;

        function getShuffleIndexSequence() {
            if (!allDatabasePets || allDatabasePets.length === 0) return [];
            if (allDatabasePets.length <= 3) {
                return allDatabasePets.map((_, i) => i);
            }

            const globalTimeChunk = Math.floor(Date.now() / 10000);
            let indexes = Array.from({ length: allDatabasePets.length }, (_, i) => i);

            let seed = globalTimeChunk;
            for (let i = indexes.length - 1; i > 0; i--) {
                seed = (seed * 9301 + 49297) % 233280;
                const j = Math.floor((seed / 233280) * (i + 1));
                let temp = indexes[i];
                indexes[i] = indexes[j];
                indexes[j] = temp;
            }
            return indexes.slice(0, 3);
        }

        function drawRealtimeShuffleGrid() {
            const grid = document.getElementById('realtimePetsGrid');
            if (!grid || !allDatabasePets || allDatabasePets.length === 0) return;

            const indices = getShuffleIndexSequence();
            grid.innerHTML = '';

            indices.forEach(idx => {
                const pet = allDatabasePets[idx];
                const cardHTML = `
                    <div class="col-md-4 col-12">
                        <div class="pet-card">
                            <div class="pet-img-wrapper">
                                <img src="${pet.imageUrl}" class="pet-img" alt="${pet.name}">
                                <div class="pet-overlay">
                                    <button type="button" class="btn-overlay-adopt" onclick="launchAdoptionForm(${pet.id}, '${pet.name}')">Adopt Me</button>
                                    <button type="button" class="btn-overlay-view" onclick="launchDetailsModal(${pet.id}, '${pet.name}', '${pet.breed}', ${pet.age}, '${pet.gender}', '${pet.medicalHistory.replace(/'/g, "\\'")}', '${pet.description.replace(/'/g, "\\'")}', '${pet.shelterName.replace(/'/g, "\\'")}')">View Details</button>
                                </div>
                            </div>
                            <div class="pet-info">
                                <span class="shelter-label"><i class="bi bi-house-heart"></i> ${pet.shelterName}</span>
                                <div class="pet-name">${pet.name}</div>
                                <div class="pet-breed">${pet.breed} • ${pet.age} yrs</div>
                            </div>
                        </div>
                    </div>
                `;
                grid.insertAdjacentHTML('beforeend', cardHTML);
            });
        }

        function launchDetailsModal(id, name, breed, age, gender, history, desc, shelter) {
            activePetIdContext = id;
            activePetNameContext = name;

            document.getElementById('detailsModalTitle').innerText = `${name}'s Verified Record`;
            document.getElementById('modalPetNameDisplay').innerText = name;
            document.getElementById('modalBreed').innerText = breed;
            document.getElementById('modalAge').innerText = age + " years";
            document.getElementById('modalGender').innerText = gender;
            document.getElementById('modalHistory').innerText = history;
            document.getElementById('modalDesc').innerText = desc;

            const targetedPet = allDatabasePets.find(p => p.id === id);
            document.getElementById('modalImg').src = targetedPet ? targetedPet.imageUrl : "";

            new bootstrap.Modal(document.getElementById('petDetailsModal')).show();
        }

        function triggerApplicationFromDetails() {
            var myModalInstance = bootstrap.Modal.getInstance(document.getElementById('petDetailsModal'));
            if(myModalInstance) { myModalInstance.hide(); }

            launchAdoptionForm(activePetIdContext, activePetNameContext);
        }

        function launchAdoptionForm(id, name) {
            document.getElementById('adoptModalPetName').innerText = name;
            document.getElementById('adoptPetIdField').value = id;
            new bootstrap.Modal(document.getElementById('adoptionApplicationModal')).show();
        }

        function startShuffle() {
            shuffleIntervalTimer = setInterval(drawRealtimeShuffleGrid, 1000);
        }

        function stopShuffle() {
            clearInterval(shuffleIntervalTimer);
        }

        const petGridContainer = document.getElementById('realtimePetsGrid');
        if(petGridContainer) {
            petGridContainer.addEventListener('mouseenter', stopShuffle);
            petGridContainer.addEventListener('mouseleave', startShuffle);
        }

        drawRealtimeShuffleGrid();
        startShuffle();
    </script>
</body>
</html>