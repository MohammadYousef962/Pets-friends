        </div>
    </nav>

    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="hero-pill"><i class="bi bi-stars text-warning me-1"></i> The All-in-One Pet Platform</div>
                    <h1 class="hero-title">Everything Your Pet Needs, <span>Together.</span></h1>
                    <p class="hero-text">Shop premium supplies, book top-rated veterinarians, and open your heart to shelter adoptions—all from a single, unified community dashboard.</p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="#features" class="btn-hero-primary">Explore Platform <i class="bi bi-arrow-down"></i></a>
                        <a href="/Account/Register" class="btn-hero-outline">Join Community</a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-img-container">
                        <div class="hero-img-wrapper">
                            <div class="floating-badge badge-1">
                                <div style="background: #FFF3E0; color: #F57C00; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 800;">ADOPT</div>
                                <div style="font-weight: 700; font-size: 0.9rem; color: #2D1B0E;">Looking for Love</div>
                            </div>
                            <div class="floating-badge badge-2">
                                <div>
                                    <div style="font-size: 0.75rem; color: #8C7560; font-weight: 700; margin-bottom: 2px;">Happy Shoppers</div>
                                    <div class="avatar-group">
                                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" alt="Avatar">
                                        <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=100&q=80" alt="Avatar">
                                        <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=100&q=80" alt="Avatar">
                                        <div class="avatar-plus">+10k</div>
                                    </div>
                                </div>
                            </div>
                            <div class="floating-badge badge-3">
                                <i class="bi bi-patch-check-fill fs-2" style="color: #10B981;"></i>
                                <div><div style="font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 0.95rem; line-height: 1.2; color: #2D1B0E;">Verified<br>Clinics</div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="features" class="features-section">
        <div class="container" style="max-width: 1100px;">
            <div class="section-subtitle text-center">Why Choose Us</div>
            <h2 class="section-title text-center">One Hub For <span>Pet Parents</span></h2>
            <p class="section-desc text-center text-muted mx-auto mb-5" style="max-width: 600px; font-size: 1.05rem; line-height: 1.6;">We've eliminated the hassle of managing multiple apps. PetFriends brings shopping, medical care, and adoptions under one roof.</p>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-box bg-tan-light"><i class="bi bi-shop"></i></div>
                        <h4 class="feature-title">Multi-Vendor Store</h4>
                        <p class="feature-text">Shop premium food, toys, and accessories from verified local merchants and national brands.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-box bg-blue-light"><i class="bi bi-calendar-heart"></i></div>
                        <h4 class="feature-title">Seamless Booking</h4>
                        <p class="feature-text">View schedules and book appointments instantly with top-rated veterinary clinics in your area.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-box bg-orange-light"><i class="bi bi-house-heart"></i></div>
                        <h4 class="feature-title">Shelter Adoptions</h4>
                        <p class="feature-text">Connect with local shelters, submit adoption applications, and find your family's newest member.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-box bg-red-light"><i class="bi bi-chat-square-heart"></i></div>
                        <h4 class="feature-title">Verified Reviews</h4>
                        <p class="feature-text">Read authentic feedback from real pet parents before you buy a product or book a new vet.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card dark">
                        <div class="feature-icon-box"><i class="bi bi-shield-check"></i></div>
                        <h4 class="feature-title">Secure & Trusted</h4>
                        <p class="feature-text">We strictly vet every merchant, clinic, and shelter on our platform to ensure your pet gets the absolute best care.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-box bg-tan-light"><i class="bi bi-people-fill"></i></div>
                        <h4 class="feature-title">Community First</h4>
                        <p class="feature-text">Manage all your pet's records, orders, and appointments from a single, beautiful dashboard.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="showcase-section">
        <div class="container" style="max-width: 1100px;">
            <div class="section-subtitle" style="color: var(--brand-accent);">Meet Our Friends</div>
            <h2 class="showcase-title text-start mb-2">Pets Looking for Love</h2>
            <p class="showcase-desc text-start mb-5" style="margin-left: 0;">Partner shelters across the network are looking for loving homes. Could you be the one to give them a forever family?</p>

            <div class="row g-4" id="realtimePetsGrid">
            </div>

            <div class="text-start mt-4 pt-2">
                <a href="/Home/AvailablePets" class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold" style="border-width: 2px;">
                    View All Pets <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </section>

    <section class="vets-section">
        <div class="container" style="max-width: 1100px;">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
                <div>
                    <div class="section-subtitle">Premium Care</div>
                    <h2 class="section-title mb-0" style="border: none; padding: 0;">Top Rated Clinics</h2>
                </div>
                <a href="/Home/Clinics" class="btn-hero-outline" style="padding: 10px 24px; font-size: 0.9rem;">View All Vets</a>
            </div>

            <div class="row g-4">
                @foreach (var vet in Model.TopClinics)
                {
                    <div class="col-md-4">
                        <div class="vet-card">
                            <img src="@vet.ImageUrl" class="vet-avatar" alt="Vet">
                            <h4 class="vet-name-small">@vet.ClinicName</h4>

                            <div class="vet-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(vet.Rating))
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {

                                        <i class="bi bi-star" style="color: #EBE0D5;"></i>
                                    }
                                }
                                <span class="review-count" style="color: #8C7560; margin-left: 5px;">@vet.Rating.ToString("0.0") (@vet.ReviewCount)</span>
                            </div>

                            <p class="vet-spec">@vet.Specialties</p>

                            <div class="card-review-snippet text-center">@vet.RecentReview</div>

                            <a href="/Vet/Profile?id=@vet.Id" class="btn-vet-view w-100 mt-auto">View Clinic</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="products-section">
        <div class="container" style="max-width: 1100px;">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
                <div>
                    <div class="section-subtitle">Marketplace</div>
                    <h2 class="section-title mb-0" style="border: none; padding: 0;">Featured Products</h2>
                </div>
                <a href="/Store/Home" class="btn-hero-outline" style="padding: 10px 24px; font-size: 0.9rem;">Shop All</a>
            </div>

            <div class="row g-4">
                @foreach (var prod in Model.FeaturedProducts)
                {
                    <div class="col-md-4">
                        <div class="prod-card">
                            <div class="prod-img">
                                <img src="@prod.ImageUrl" alt="@prod.Title">
                            </div>
                            <div class="prod-info">
                                <div class="prod-store"><i class="bi bi-shop"></i> @prod.StoreName</div>
                                <h4 class="prod-title">@prod.Title</h4>

                                <div class="vet-stars mt-2 mb-3" style="font-size: 0.85rem; flex-grow: 1;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(prod.Rating))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {

                                            <i class="bi bi-star" style="color: #EBE0D5;"></i>
                                        }
                                    }
                                    <span style="color: #8C7560; margin-left: 5px;">@prod.Rating.ToString("0.0") (@prod.ReviewCount)</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top" style="border-color: #EBE0D5 !important;">
                                    <div class="prod-price mb-0 mt-1">$@prod.Price.ToString("0.00")</div>
                                    <a href="/Store/Details?id=@prod.Id" class="btn-prod-view mt-1">View</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="testimonial-section">
        <div class="container" style="max-width: 1100px;">
            <div class="section-subtitle">Happy Stories</div>
            <h2 class="section-title text-start mb-5" style="border: none; padding: 0;">What Our Pet Owners Say</h2>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="rating-block">
                        <div class="rating-content">
                            <div class="rating-number">@Model.OverallVetAverageRating.ToString("0.0")</div>
                            <div class="rating-stars">★★★★★</div>
                            <p class="mb-4 fw-bold" style="font-size: 1.1rem;">@(Model.TotalVetReviews) Verified Reviews</p>
                            <a href="/Account/Register" class="btn btn-light rounded-pill fw-bold text-dark px-4 py-2">Join the Community</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="review-card">
                        <div class="rating-stars mb-3" style="font-size: 1.2rem; color: #F59E0B;">
                            @for (int i = 0; i < Model.RecentTestimonials[0].Rating; i++)
                            {
                                <span>★</span>
                            }
                        </div>
                        <p class="review-text">"@Model.RecentTestimonials[0].Comment"</p>
                        <div>
                            <div class="review-author">@Model.RecentTestimonials[0].AuthorName</div>
                            <div class="review-role">@Model.RecentTestimonials[0].Role</div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="review-card tan">
                        <div class="rating-stars mb-3" style="font-size: 1.2rem; color: #F59E0B;">
                            @for (int i = 0; i < Model.RecentTestimonials[1].Rating; i++)
                            {
                                <span>★</span>
                            }
                        </div>
                        <p class="review-text">"@Model.RecentTestimonials[1].Comment"</p>
                        <div>
                            <div class="review-author">@Model.RecentTestimonials[1].AuthorName</div>
                            <div class="review-role">@Model.RecentTestimonials[1].Role</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER WITH CONDITIONAL AUTHENTICATION LINKS -->
