@model Pets_friends.Data.ViewModels.LandingPageViewModel
@using Pets_friends.Models
@{
    ViewData["Title"] = "Best Pals for Your Paw Pals";
    Layout = "_Layout";
}

@section Styles {
<link rel="stylesheet" href="~/css/landing.css" />
<style>
/* ═══════════════════════════════════════════════════════════════
   LANDING PAGE — INLINE ADDITIONS
   (move to landing.css once confirmed working)
═══════════════════════════════════════════════════════════════ */

/* ─── Hero search bar ─────────────────────────────────────── */
.hero-search-wrap {
    margin-top: 28px;
    display: flex;
    justify-content: center;
}

.hero-search {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 50px;
    box-shadow: 0 8px 32px rgba(92,61,30,.15);
    overflow: hidden;
    width: 100%;
    max-width: 480px;
    border: 1.5px solid rgba(200,168,130,.3);
    transition: box-shadow .2s;
}

.hero-search:focus-within {
    box-shadow: 0 8px 40px rgba(92,61,30,.22);
    border-color: rgba(200,168,130,.6);
}

.hero-search input {
    flex: 1;
    border: none;
    outline: none;
    padding: 14px 20px;
    font-family: 'DM Sans', sans-serif;
    font-size: .92rem;
    color: #4A3B32;
    background: transparent;
}

.hero-search input::placeholder { color: #b8a89a; }

.hero-search button {
    background: #5C3D1E;
    color: #fff;
    border: none;
    padding: 12px 22px;
    margin: 5px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: .85rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 7px;
    transition: background .2s, transform .15s;
    white-space: nowrap;
}

.hero-search button:hover {
    background: #7a5229;
    transform: scale(1.03);
}

.hero-search-hint {
    text-align: center;
    margin-top: 10px;
    font-size: .78rem;
    color: rgba(255,255,255,.6);
}

.hero-search-hint a {
    color: rgba(255,255,255,.85);
    text-decoration: underline;
    text-underline-offset: 2px;
}

/* ─── How It Works ────────────────────────────────────────── */
.how-section {
    padding: 80px 24px;
    background: #fff;
    text-align: center;
}

.how-eyebrow {
    font-size: .78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #C8A882;
    margin-bottom: 10px;
}

.how-heading {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: #5C3D1E;
    margin-bottom: 56px;
}

.how-steps {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 0;
    max-width: 860px;
    margin: 0 auto;
    position: relative;
}

/* Connecting line between steps */
.how-steps::before {
    content: '';
    position: absolute;
    top: 36px;
    left: calc(16.6% + 36px);
    right: calc(16.6% + 36px);
    height: 2px;
    background: linear-gradient(90deg, #C8A882 0%, #5C3D1E 50%, #C8A882 100%);
    opacity: .25;
    pointer-events: none;
}

.how-step {
    flex: 1;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
}

.how-step-num {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, #C8A882, #5C3D1E);
    color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(92,61,30,.2);
    position: relative;
    z-index: 1;
    flex-shrink: 0;
}

.how-step-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #5C3D1E;
}

.how-step-desc {
    font-size: .83rem;
    color: #8a6f58;
    line-height: 1.6;
    max-width: 200px;
}

/* ─── Services section fixes ──────────────────────────────── */
/* Each card gets a unique accent via nth-child */
.service-card:nth-child(1) .service-icon-wrap { background: rgba(224,123,84,.12);  color: #e07b54; }
.service-card:nth-child(2) .service-icon-wrap { background: rgba(92,61,30,.1);     color: #5C3D1E; }
.service-card:nth-child(3) .service-icon-wrap { background: rgba(200,168,130,.2);  color: #9a7a55; }
.service-card:nth-child(4) .service-icon-wrap { background: rgba(76,175,80,.1);    color: #388e3c; }
.service-card:nth-child(5) .service-icon-wrap { background: rgba(33,150,243,.1);   color: #1976d2; }
.service-card:nth-child(6) .service-icon-wrap { background: rgba(156,39,176,.1);   color: #7b1fa2; }

/* View all services link */
.services-footer {
    text-align: center;
    margin-top: 36px;
}

.btn-outline-pf {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 50px;
    border: 2px solid #5C3D1E;
    color: #5C3D1E;
    font-family: 'DM Sans', sans-serif;
    font-size: .88rem;
    font-weight: 600;
    text-decoration: none;
    transition: background .2s, color .2s;
}

.btn-outline-pf:hover {
    background: #5C3D1E;
    color: #fff;
}

/* ─── Testimonials ────────────────────────────────────────── */
.testimonials-section {
    padding: 80px 24px;
    background: #F5F1EB;
    text-align: center;
}

.testimonials-section .how-eyebrow { color: #C8A882; }
.testimonials-section .how-heading { margin-bottom: 40px; }

.testi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto;
}

.testi-card {
    background: #fff;
    border-radius: 18px;
    padding: 28px 24px;
    text-align: left;
    box-shadow: 0 4px 20px rgba(92,61,30,.07);
    border: 1px solid rgba(200,168,130,.2);
    transition: transform .2s, box-shadow .2s;
}

.testi-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(92,61,30,.12);
}

.testi-stars {
    color: #C8A882;
    font-size: .95rem;
    margin-bottom: 12px;
    letter-spacing: 2px;
}

.testi-text {
    font-size: .88rem;
    color: #6C5B51;
    line-height: 1.7;
    margin-bottom: 18px;
    font-style: italic;
}

.testi-author {
    display: flex;
    align-items: center;
    gap: 10px;
}

.testi-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #C8A882, #5C3D1E);
    color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: .95rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.testi-name {
    font-size: .85rem;
    font-weight: 700;
    color: #5C3D1E;
}

.testi-pet {
    font-size: .75rem;
    color: #9a7a55;
}

/* ─── Vet spotlight strip ─────────────────────────────────── */
.vet-strip {
    padding: 56px 24px;
    background: #fff;
    text-align: center;
}

.vet-strip .how-heading { margin-bottom: 36px; }

.vet-strip-inner {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    max-width: 900px;
    margin: 0 auto 32px;
}

.vet-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 50px;
    background: #F5F1EB;
    border: 1.5px solid rgba(200,168,130,.3);
    font-size: .85rem;
    color: #5C3D1E;
    font-weight: 500;
    text-decoration: none;
    transition: background .15s, border-color .15s;
}

.vet-chip:hover {
    background: rgba(200,168,130,.2);
    border-color: #C8A882;
    color: #5C3D1E;
}

.vet-chip-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #C8A882, #5C3D1E);
    color: #fff;
    font-size: .75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

/* ─── Staggered reveal animation ──────────────────────────── */
.reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .55s ease, transform .55s ease;
}

.reveal.visible {
    opacity: 1;
    transform: none;
}

.reveal-delay-1 { transition-delay: .1s; }
.reveal-delay-2 { transition-delay: .2s; }
.reveal-delay-3 { transition-delay: .3s; }

@@media (max-width: 640px) {
    .how-steps::before { display: none; }
    .how-steps { flex-direction: column; align-items: center; gap: 32px; }
    .hero-search { max-width: 100%; }
}
</style>
}

