@model IEnumerable<Pets_friends.Models.Product>

@{
    ViewData["Title"] = "Marketplace Catalog";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f1eb 0%, #e7d8c7 45%, #d2b89c 100%) !important;
            background-attachment: fixed !important;
            font-family: 'DM Sans', sans-serif;
            color: #5C3D1E;
            padding-bottom: 60px;
        }

        .catalog-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .catalog-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            font-weight: 700;
            color: #2D1B0E;
        }

        .product-grid-card {
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid #EBE0D5;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
            box-shadow: 0 10px 30px rgba(92, 61, 30, 0.05);
            text-decoration: none;
        }

            .product-grid-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(92, 61, 30, 0.12);
            }

        .card-img-container {
            background: #FAF6F1;
            height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            border-bottom: 1px solid #EBE0D5;
        }

            .card-img-container img {
                max-height: 100%;
                max-width: 100%;
                object-fit: contain;
            }

        .card-body-custom {
            padding: 25px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .store-badge {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            color: #8C7560;
            margin-bottom: 8px;
            display: block;
        }

        .item-title {
            font-weight: 700;
            font-size: 1.2rem;
            color: #2D1B0E;
            margin-bottom: 15px;
            line-height: 1.3;
        }

        .item-price-row {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .item-price {
            font-size: 1.4rem;
            font-weight: 700;
            color: #5C3D1E;
        }

        .btn-view {
            background: #FAF6F1;
            color: #5C3D1E;
            border: 1px solid #EBE0D5;
            padding: 8px 16px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .product-grid-card:hover .btn-view {
            background: #5C3D1E;
            color: #fff;
            border-color: #5C3D1E;
        }
    </style>
}

<div class="container py-5" style="max-width: 1200px;">

    <div class="catalog-header">
        <h1 class="catalog-title">Marketplace Catalog</h1>
        <p class="text-muted" style="font-size: 1.1rem;">Explore premium products from our verified community partners</p>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <a asp-controller="Store" asp-action="Details" asp-route-id="@item.Id" class="product-grid-card">

                    <div class="card-img-container">
                        <img src="@item.ImageUrl" onerror="this.src='https://placehold.co/300x300/FAF6F1/8C7560?text=Item'" alt="@item.Name" />
                    </div>

                    <div class="card-body-custom">
                        <span class="store-badge"><i class="bi bi-shop me-1"></i> @(item.MerchantProfile?.StoreName ?? "Verified Partner")</span>

                        <div class="item-title">@item.Name</div>

                        <div class="item-price-row">
                            <span class="item-price">@item.Price.ToString("C")</span>
                            <span class="btn-view">Details</span>
                        </div>
                    </div>

                </a>
            </div>
        }
    </div>

</div>