@model Pets_friends.Data.ViewModels.CartVM

@{
    ViewData["Title"] = "Your Cart";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="container py-5" style="max-width: 1200px;">
    <h1 class="mb-4" style="font-family: 'Playfair Display', serif; font-weight: 700;">Shopping Cart</h1>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size: 5rem; color: #EBE0D5;"></i>
            <h3 class="mt-3">Your cart is empty</h3>
            <a asp-action="Home" class="btn btn-primary mt-3" style="background: #5C3D1E; border: none;">Start Shopping</a>
        </div>
    }
    else
    {
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm" style="border-radius: 20px; padding: 25px;">
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom">
                            <img src="@item.Product.ImageUrl" style="width: 100px; height: 100px; object-fit: cover; border-radius: 12px; border: 1px solid #EBE0D5;">
                            <div class="flex-grow-1">
                                <h5 class="fw-bold mb-1">@item.Product.Name</h5>
                                <p class="text-muted small mb-2"><i class="bi bi-shop me-1"></i> @item.Product.MerchantProfile?.StoreName</p>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="fw-bold" style="color: #5C3D1E;">@item.Product.Price.ToString("C")</span>
                                    <span class="badge bg-light text-dark border">Qty: @item.Quantity</span>
                                </div>
                            </div>
                            <form asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    }
                    <a asp-action="Home" class="text-decoration-none" style="color: #5C3D1E; font-weight: 600;">
                        <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm" style="border-radius: 20px; background: #FAF6F1; padding: 25px;">
                    <h4 class="fw-bold mb-4">Order Summary</h4>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>@Model.Subtotal.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax (8%)</span>
                        <span>@Model.Tax.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4 pb-4 border-bottom">
                        <span>Shipping</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>
                    <div class="d-flex justify-content-between h4 fw-bold mb-4">
                        <span>Total</span>
                        <span>@Model.Total.ToString("C")</span>
                    </div>
                    <button class="btn btn-dark w-100 py-3 fw-bold" style="background: #5C3D1E; border-radius: 12px;">Proceed to Checkout</button>
                </div>
            </div>
        </div>
    }
</div>